        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- Binding: Stock Picking -->
    <record id="action_print_labels_picking" model="ir.actions.act_window">
        <field name="name">Print ZPL Labels</field>
        <field name="res_model">vpa.print.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- Binding: Manufacturing Order -->
    <record id="action_print_labels_mrp" model="ir.actions.act_window">
        <field name="name">Print ZPL Labels</field>
        <field name="res_model">vpa.print.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- Binding: Lot/Serial -->
    <record id="action_print_labels_lot" model="ir.actions.act_window">
        <field name="name">Print ZPL Labels</field>
        <field name="res_model">vpa.print.label.wizard</field>
