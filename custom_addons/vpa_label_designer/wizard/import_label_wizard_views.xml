<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Import Label Template Wizard Form -->
    <record id="vpa_import_label_wizard_form" model="ir.ui.view">
        <field name="name">vpa.import.label.wizard.form</field>
        <field name="model">vpa.import.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Restore Label Template">
                <group>
                    <p class="text-muted" colspan="2">
                        Upload a <strong>.vpa</strong> file previously backed up from VPA Label Designer.
                        The template, label size, and all elements will be restored.
                    </p>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Restore" type="object"
                            class="btn-primary" icon="fa-upload"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Import Label Template Action -->
    <record id="action_import_label_wizard" model="ir.actions.act_window">
        <field name="name">Restore Template</field>
        <field name="res_model">vpa.import.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
