<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- VPA Softwares Security Category (reuse if exists) -->
        <record id="module_category_vpa_softwares" model="ir.module.category">
            <field name="name">VPA Softwares</field>
            <field name="description">VPA Solutions Limited Applications</field>
            <field name="sequence">50</field>
        </record>

        <!-- Label Designer Privilege -->
        <record model="res.groups.privilege" id="res_groups_privilege_label_designer">
            <field name="name">Label Designer</field>
            <field name="category_id" ref="module_category_vpa_softwares"/>
            <field name="placeholder">No</field>
            <field name="sequence">20</field>
        </record>

        <!-- Label Designer User Group -->
        <record id="group_label_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_label_designer"/>
            <field name="comment">Create and edit label templates, print labels</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Label Designer Manager Group -->
        <record id="group_label_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_label_designer"/>
            <field name="comment">Full access: manage printers, settings, variables, and all templates</field>
            <field name="implied_ids" eval="[(4, ref('group_label_user'))]"/>
        </record>

        <!-- Multi-company record rules -->
        <record id="rule_label_size_company" model="ir.rule">
            <field name="name">Label Size: multi-company</field>
            <field name="model_id" ref="model_vpa_label_size"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_label_template_company" model="ir.rule">
            <field name="name">Label Template: multi-company</field>
            <field name="model_id" ref="model_vpa_label_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_printer_config_company" model="ir.rule">
            <field name="name">Printer Config: multi-company</field>
            <field name="model_id" ref="model_vpa_printer_config"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_label_variable_company" model="ir.rule">
            <field name="name">Label Variable: multi-company</field>
            <field name="model_id" ref="model_vpa_label_variable"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
