<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Label Preview Widget Template -->
    <t t-name="vpa_label_designer.LabelPreviewWidget">
        <div class="o_label_preview_widget">
            <div class="mb-2">
                <button class="btn btn-sm btn-primary" t-on-click="onPreviewClick"
                        t-att-disabled="state.loading">
                    <i class="fa fa-eye me-1"/>
                    <t t-if="state.loading">Generating Preview...</t>
                    <t t-else="">Generate Visual Preview</t>
                </button>
            </div>

            <t t-if="state.loading">
                <div class="text-muted">
                    <i class="fa fa-spinner fa-spin me-1"/> Loading preview from Labelary...
                </div>
            </t>

            <t t-if="state.error">
                <div class="alert alert-warning mt-2" role="alert">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    <t t-esc="state.error"/>
                </div>
            </t>

            <t t-if="state.imageData">
                <div class="mt-2 p-2 bg-white border rounded" style="display: inline-block;">
                    <img t-att-src="'data:image/png;base64,' + state.imageData"
                         style="max-width: 100%; height: auto; border: 1px solid #ddd;"
                         alt="Label Preview"/>
                </div>
            </t>

            <!-- Also show raw ZPL text -->
            <div class="mt-2">
                <pre class="bg-light p-2 rounded" style="max-height: 300px; overflow-y: auto; font-size: 12px;">
                    <t t-esc="zplCode"/>
                </pre>
            </div>
        </div>
    </t>


</templates>
