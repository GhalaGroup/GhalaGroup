<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Label Preview Widget Template -->
    <t t-name="vpa_label_designer.LabelPreviewWidget">
        <div class="o_label_preview_widget">
            <div class="mb-2">
                <button class="btn btn-sm btn-primary" t-on-click="onPreviewClick"
                        t-att-disabled="state.loading">
                    <i class="fa fa-eye me-1"/>
                    <t t-if="state.loading">Generating Preview...</t>
                    <t t-else="">Generate Visual Preview</t>
                </button>
            </div>

            <t t-if="state.loading">
                <div class="text-muted">
                    <i class="fa fa-spinner fa-spin me-1"/> Loading preview from Labelary...
                </div>
            </t>

            <t t-if="state.error">
                <div class="alert alert-warning mt-2" role="alert">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    <t t-esc="state.error"/>
                </div>
            </t>

            <t t-if="state.imageData">
                <div class="mt-2 p-2 bg-white border rounded" style="display: inline-block;">
                    <img t-att-src="'data:image/png;base64,' + state.imageData"
                         style="max-width: 100%; height: auto; border: 1px solid #ddd;"
                         alt="Label Preview"/>
                </div>
            </t>

            <!-- Also show raw ZPL text -->
            <div class="mt-2">
                <pre class="bg-light p-2 rounded" style="max-height: 300px; overflow-y: auto; font-size: 12px;">
                    <t t-esc="zplCode"/>
                </pre>
            </div>
        </div>
    </t>

    <!-- Zebra Browser Print Action Template -->
    <t t-name="vpa_label_designer.ZebraBrowserPrintAction">
        <div class="o_zebra_browser_print p-4 text-center">
            <h3 class="mb-3">
                <i class="fa fa-print me-2"/>
                Zebra Browser Print
            </h3>

            <t t-if="state.status === 'connecting'">
                <div class="mb-3">
                    <i class="fa fa-spinner fa-spin fa-2x text-primary"/>
                </div>
                <p class="text-muted"><t t-esc="state.message"/></p>
            </t>

            <t t-if="state.status === 'printing'">
                <div class="mb-3">
                    <i class="fa fa-spinner fa-spin fa-2x text-info"/>
                </div>
                <p class="text-info"><t t-esc="state.message"/></p>
            </t>

            <t t-if="state.status === 'success'">
                <div class="mb-3">
                    <i class="fa fa-check-circle fa-2x text-success"/>
                </div>
                <p class="text-success fw-bold"><t t-esc="state.message"/></p>
                <button class="btn btn-primary mt-2" t-on-click="onClose">Close</button>
            </t>

            <t t-if="state.status === 'error'">
                <div class="mb-3">
                    <i class="fa fa-exclamation-circle fa-2x text-danger"/>
                </div>
                <div class="alert alert-danger">
                    <t t-esc="state.error"/>
                </div>
                <p class="text-muted small mt-2">
                    Make sure Zebra Browser Print is installed and running on your computer.
                    <a href="https://www.zebra.com/us/en/support-downloads/printer-software/by-request-software.html"
                       target="_blank">Download Zebra Browser Print</a>
                </p>
                <button class="btn btn-secondary mt-2" t-on-click="onClose">Close</button>
            </t>
        </div>
    </t>

</templates>
