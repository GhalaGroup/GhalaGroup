<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend MRP Production Form View -->
    <record id="mrp_production_form_view_commission" model="ir.ui.view">
        <field name="name">mrp.production.form.commission</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Add commission button to button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_commission_lines" type="object"
                        class="oe_stat_button" icon="fa-money"
                        groups="vpa_sales_commission.group_commission_manager"
                        invisible="commission_line_count == 0">
                    <field name="commission_line_count" string="Commissions" widget="statinfo"/>
                </button>
            </xpath>
            <!-- Add Generate/Block/Unblock buttons in header -->
            <xpath expr="//header" position="inside">
                <field name="commission_generated" invisible="1"/>
                <field name="commission_blocked" invisible="1"/>
                <!-- Generate Commission: visible when done, not generated, not blocked -->
                <button name="action_generate_commission" type="object"
                        string="Generate Commission" class="btn-primary"
                        invisible="state != 'done' or commission_generated or commission_blocked"
                        groups="vpa_sales_commission.group_commission_manager"/>
                <!-- Commission Applied: visible when generated -->
                <button name="action_view_commission_lines" type="object"
                        string="Commission Applied" class="btn-success"
                        invisible="state != 'done' or not commission_generated"
                        groups="vpa_sales_commission.group_commission_manager"/>
                <!-- Block Commission: visible in all states, not blocked, not generated -->
                <button name="action_block_commission" type="object"
                        string="Block Commission" class="btn-warning"
                        icon="fa-ban"
                        invisible="commission_blocked or commission_generated"
                        groups="vpa_sales_commission.group_commission_user"/>
                <!-- Unblock Commission: visible when blocked (manager only) -->
                <button name="action_unblock_commission" type="object"
                        string="Unblock Commission" class="btn-danger"
                        icon="fa-unlock"
                        invisible="not commission_blocked"
                        groups="vpa_sales_commission.group_commission_manager"/>
            </xpath>
            <!-- Add commission tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Commission" name="commission"
                      groups="vpa_sales_commission.group_commission_manager"
                      invisible="state != 'done'">
                    <group>
                        <group>
                            <field name="commission_base_amount" widget="monetary"/>
                        </group>
                    </group>
                    <field name="commission_line_ids" readonly="1"
                           invisible="not commission_generated">
                        <list>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="base_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="rate"/>
                            <field name="amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'pending'"
                                   decoration-warning="state == 'confirmed'"
                                   decoration-success="state == 'paid'"
                                   decoration-danger="state == 'cancelled'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Add Commission Status to MO tree view -->
    <record id="mrp_production_tree_view_commission" model="ir.ui.view">
        <field name="name">mrp.production.list.commission</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="commission_status" string="Commission"
                       widget="badge" optional="hide"
                       decoration-muted="commission_status == 'none'"
                       decoration-danger="commission_status in ('blocked', 'cancelled')"
                       decoration-info="commission_status == 'pending'"
                       decoration-warning="commission_status in ('confirmed', 'partial')"
                       decoration-success="commission_status == 'paid'"/>
            </xpath>
        </field>
    </record>

</odoo>
