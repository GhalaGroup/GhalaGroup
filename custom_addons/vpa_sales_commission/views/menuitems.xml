              parent="menu_commission_reporting"
              action="action_mrp_production_commission_report"
              sequence="10"
              groups="vpa_sales_commission.group_commission_manager"/>

    <!-- SO Commission Report -->
    <menuitem id="menu_so_commission_report"
              name="Commission by SO"
              parent="menu_commission_reporting"
              action="action_so_commission_report"
              sequence="15"
              groups="vpa_sales_commission.group_commission_user,vpa_sales_commission.group_commission_manager"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_commission_config"
              name="Configuration"
              parent="menu_commission_root"
              sequence="100"
              groups="vpa_sales_commission.group_commission_manager"/>

    <!-- Commission Schemes Menu -->
    <menuitem id="menu_commission_schemes"
              name="Commission Schemes"
              parent="menu_commission_config"
              action="vpa_commission_scheme_action"
              sequence="10"
              groups="vpa_sales_commission.group_commission_manager"/>

</odoo>
