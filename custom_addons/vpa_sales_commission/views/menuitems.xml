              name="Commission"
              parent="sale.sale_menu_root"
              sequence="50"
              groups="vpa_sales_commission.group_commission_user,vpa_sales_commission.group_commission_manager"/>

    <!-- Commission Lines Menu -->
    <menuitem id="menu_commission_lines"
              name="Commission Lines"
              parent="menu_commission_root"
              action="vpa_commission_line_action"
