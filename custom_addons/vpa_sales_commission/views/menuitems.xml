<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main Commission Menu under Sales -->
    <menuitem id="menu_commission_root"
              name="Commission"
              parent="sale.sale_menu_root"
              sequence="50"
              groups="vpa_sales_commission.group_commission_user,vpa_sales_commission.group_commission_manager"/>

    <!-- Commission Centre (primary dashboard) -->
    <menuitem id="menu_commission_centre"
              name="Commission Centre"
              parent="menu_commission_root"
              action="action_commission_centre"
              sequence="5"
              groups="vpa_sales_commission.group_commission_user,vpa_sales_commission.group_commission_manager"/>

    <!-- Commissions Menu (all employees) -->
    <menuitem id="menu_my_commissions"
              name="Commissions"
              parent="menu_commission_root"
              action="vpa_commission_line_action"
              sequence="10"
              groups="vpa_sales_commission.group_commission_user,vpa_sales_commission.group_commission_manager"/>

    <!-- Commission Payments Menu -->
    <menuitem id="menu_commission_payments"
              name="Commission Payments"
              parent="menu_commission_root"
              action="vpa_commission_payments_action"
              sequence="12"
              groups="vpa_sales_commission.group_commission_manager"/>

    <!-- Commission Statement Menu -->
    <menuitem id="menu_commission_statement"
              name="Commission Statement"
              parent="menu_commission_root"
              action="action_commission_statement_wizard"
              sequence="17"
              groups="vpa_sales_commission.group_commission_manager"/>

    <!-- Manual Commission Menu -->
    <menuitem id="menu_manual_commission"
              name="Add Manual Commission"
              parent="menu_commission_root"
              action="action_manual_commission_wizard"
              sequence="18"
              groups="vpa_sales_commission.group_commission_manager"/>

    <!-- Reporting Menu -->
    <menuitem id="menu_commission_reporting"
              name="Reporting"
              parent="menu_commission_root"
              sequence="90"
              groups="vpa_sales_commission.group_commission_user,vpa_sales_commission.group_commission_manager"/>

    <!-- Year Summary Report -->
    <menuitem id="menu_commission_year_summary"
              name="Year Summary"
              parent="menu_commission_reporting"
              action="action_commission_year_summary_wizard"
              sequence="20"
              groups="vpa_sales_commission.group_commission_manager"/>

    <!-- MO Commission Report (manager only: no employee dimension to scope for users) -->
    <menuitem id="menu_mrp_production_commission_report"
