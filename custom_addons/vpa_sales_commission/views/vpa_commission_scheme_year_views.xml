<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Commission Scheme Year Form View -->
    <record id="vpa_commission_scheme_year_view_form" model="ir.ui.view">
        <field name="name">vpa.commission.scheme.year.form</field>
        <field name="model">vpa.commission.scheme.year</field>
        <field name="arch" type="xml">
            <form string="Commission Year">
                <header>
                    <button name="action_close_year" type="object"
                            string="Close Year" class="btn-danger"
                            invisible="state == 'closed'"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <button name="action_reopen_year" type="object"
                            string="Reopen Year" class="btn-secondary"
                            invisible="state == 'open'"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <button name="action_generate_bill" type="object"
                            string="Generate Bill" class="btn-primary"
                            invisible="bill_count > 0"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <button name="action_confirm_all_lines" type="object"
                            string="Confirm All Commissions" class="btn-success"
                            invisible="pending_count == 0"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <button name="action_generate_excess_bill" type="object"
                            string="Bill Excess" class="btn-warning"
                            invisible="excess_to_bill &lt;= 0"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <button name="action_register_payment" type="object"
                            string="Register Payment" class="btn-primary"
                            invisible="state == 'closed'"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <button name="action_apply_payment" type="object"
                            string="Apply On-Account Payment" class="btn-secondary"
                            invisible="state == 'closed'"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <field name="pending_count" invisible="1"/>
                    <field name="outstanding_cash" invisible="1"/>
                    <field name="excess_to_bill" invisible="1"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_commission_lines" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="line_count" string="Commissions" widget="statinfo"/>
                        </button>
                        <button name="action_view_mos" type="object"
                                class="oe_stat_button" icon="fa-industry">
                            <field name="mo_count" string="MOs" widget="statinfo"/>
                        </button>
                        <button name="action_view_sos" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="so_count" string="SOs" widget="statinfo"/>
                        </button>
                        <button name="action_view_bills" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="bill_count == 0">
                            <field name="bill_count" string="Bills" widget="statinfo"/>
                        </button>
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="payment_count == 0">
                            <field name="payment_count" string="Payments" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="scheme_id" readonly="1"/>
                            <field name="year" readonly="state == 'closed'"/>
                            <field name="production_rate" string="Rate (%)"
                                   readonly="state == 'closed'"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="minimum_amount" widget="monetary" readonly="state == 'closed'"/>
                            <field name="minimum_amount_usd" readonly="state == 'closed'"/>
                            <field name="effective_expense_account_id"/>
                            <field name="expense_account_id" string="Expense Account Override"
                                   readonly="state == 'closed'"/>
                        </group>
                    </group>
                    <group string="Advance (Minimum Guarantee)"
                          invisible="minimum_amount == 0">
                        <group>
                            <field name="minimum_amount" widget="monetary" string="Guarantee Advance"/>
                            <field name="advance_consumed" widget="monetary"/>
                            <field name="advance_remaining" widget="monetary"
                                   decoration-success="advance_remaining &gt; 0"
                                   decoration-muted="advance_remaining == 0"/>
                        </group>
                        <group>
                            <field name="payable_to_employee" widget="monetary"
                                   decoration-warning="payable_to_employee &gt; 0"/>
                        </group>
                    </group>
                    <group string="Commission Performance">
                        <group>
                            <field name="total_earned" widget="monetary"/>
                            <field name="confirmed_earned" widget="monetary"/>
                            <field name="total_pending" widget="monetary"/>
                            <field name="shortfall" widget="monetary"/>
                            <field name="excess_to_bill" widget="monetary"
                                   decoration-warning="excess_to_bill &gt; 0"/>
                        </group>
                        <group>
                            <field name="amount_due_year" widget="monetary"/>
                            <field name="amount_paid_cash" widget="monetary" string="Paid (Cash)"/>
                            <field name="writeoff_total" widget="monetary"
                                   invisible="writeoff_total == 0"/>
                            <field name="outstanding_cash" widget="monetary" string="Outstanding (Cash)"
                                   decoration-danger="outstanding_cash &gt; 0"
                                   decoration-success="outstanding_cash &lt;= 0"/>
                            <field name="unallocated_onaccount_amount" widget="monetary"
                                   decoration-warning="unallocated_onaccount_amount &gt; 0"
                                   invisible="unallocated_onaccount_amount == 0"/>
                        </group>
                    </group>
                    <separator string="Internal Notes"/>
                    <field name="notes" nolabel="1"
                           placeholder="Internal notes about this commission year..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- NOTE: the Yearly Rates list for the scheme form is embedded INLINE in
         vpa_commission_scheme_views.xml (view_id on a field is not supported
         by Odoo; a standalone view here gets ignored and the default-view
         fallback could pick the read-only Commission Centre list). -->

    <!-- ============================================================= -->
    <!-- COMMISSION CENTRE: cross-employee year overview               -->
    <!-- ============================================================= -->

    <!-- Commission Centre Kanban (cards) -->
    <record id="vpa_commission_scheme_year_view_kanban" model="ir.ui.view">
        <field name="name">vpa.commission.scheme.year.kanban</field>
        <field name="model">vpa.commission.scheme.year</field>
        <field name="arch" type="xml">
            <kanban default_group_by="year" create="false">
                <field name="year"/>
                <field name="mo_count"/>
                <field name="so_count"/>
                <field name="bill_count"/>
                <field name="payment_count"/>
                <field name="shortfall"/>
                <field name="pending_count"/>
                <field name="total_pending"/>
                <field name="confirmed_earned"/>
                <field name="amount_due_year"/>
                <field name="amount_paid_cleared"/>
                <field name="amount_paid_in_process"/>
                <field name="excess_to_bill"/>
                <field name="unallocated_onaccount_amount"/>
                <field name="unallocated_onaccount_count"/>
                <field name="total_to_pay"/>
                <field name="still_to_pay_total"/>
                <field name="minimum_amount_usd"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <main class="p-2">
                            <div class="d-flex justify-content-between align-items-baseline mb-2">
                                <field name="employee_id" class="fw-bold fs-5"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'open'"
                                       decoration-muted="state == 'closed'"/>
                            </div>
                            <div class="text-muted mb-2">
                                <t t-esc="record.year.value"/> · Rate <field name="effective_rate" class="d-inline"/>%<t t-if="record.minimum_amount_usd.raw_value"> · Min USD <t t-esc="Math.round(record.minimum_amount_usd.raw_value).toLocaleString()"/></t>
                            </div>
                            <!-- The card reads as two plain sums a non-accountant
                                 can follow: what he has earned, then what we owe
                                 and what is left to pay. Every jargon term the old
                                 layout relied on (Confirmed / Due / Outstanding)
                                 is replaced by the words a user would actually use,
                                 and the rule that picks the payable amount is
                                 spelled out on the card instead of being implied. -->

                            <!-- Figures use tabular-nums so decimal points line up
                                 down the card; the two panels separate "what he
                                 earned" from "what we pay", which are different
                                 bases and were previously interleaved. -->

                            <!-- 1. WHAT HE EARNED -->
                            <div class="mt-2 px-2 py-2 rounded"
                                 style="background:rgba(128,128,128,.07); font-variant-numeric:tabular-nums;">
                                <div class="text-muted fw-bolder mb-1"
                                     style="font-size:.6rem; letter-spacing:.09em;">WHAT HE EARNED</div>
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <span class="small text-muted text-truncate">Approved</span>
                                    <field name="confirmed_earned" widget="monetary" class="flex-shrink-0 text-nowrap ms-2"/>
                                </div>
                                <!-- Row class stays STATIC and identical to the rows
                                     above/below; the amber only colours the label.
                                     A computed class on this container was the one
                                     structural difference from the working rows. -->
                                <!-- Amber call-to-action only while something actually
                                     awaits approval; at zero it swaps to a quiet
                                     confirmation instead of shouting "0" — same
                                     always-rendered pattern as the reconciliation
                                     row, so card heights stay equal. -->
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <t t-if="record.pending_count.raw_value">
                                        <!-- Explicit hex, not bg-warning/text-dark: the
                                             dark theme inverts those utilities and the
                                             count ended up white on orange. -->
                                        <span class="small text-truncate text-warning">Not approved yet
                                            <span class="badge rounded-pill"
                                                  style="font-size:.62rem; background-color:#f0ad4e; color:#1c1c1c; font-weight:700;"><t t-esc="record.pending_count.value"/></span>
                                        </span>
                                        <field name="total_pending" widget="monetary" class="flex-shrink-0 text-nowrap ms-2"/>
                                    </t>
                                    <t t-else="">
                                        <!-- Invisible badge + full-size dash mirror the
                                             if-branch's badge and monetary field, so
                                             both variants render the same row height. -->
                                        <span class="small text-muted text-truncate">
                                            <i class="fa fa-check me-1"/>nothing awaiting approval
                                            <span class="badge rounded-pill" style="font-size:.62rem; visibility:hidden;">0</span>
                                        </span>
                                        <span class="text-muted flex-shrink-0 ms-2">—</span>
                                    </t>
                                </div>
                                <div class="d-flex justify-content-between align-items-baseline border-top mt-1 pt-1">
                                    <span class="small fw-bold text-truncate">Total earned</span>
                                    <field name="total_earned" widget="monetary" class="fw-bold flex-shrink-0 text-nowrap ms-2"/>
                                </div>
                                <!-- TOTAL EARNED (approved + awaiting approval)
                                     measured against the year's minimum guarantee:
                                       green = earned within the guarantee,
                                       WHITE = earned ABOVE the minimum,
                                       red   = earnings still below the guarantee.
                                     Scaled to max(guarantee, total earned). Non-zero
                                     segments get a 1% floor so a real but tiny amount
                                     never rounds to invisible; green absorbs the
                                     difference so the bar stays at exactly 100%.
                                     Years without a guarantee show fully green. -->
                                <div class="progress mt-2" style="height:5px;"
                                     t-if="Math.max(record.minimum_amount.raw_value, record.total_earned.raw_value) &gt; 0">
                                    <div class="progress-bar bg-success"
                                         t-attf-style="width: #{100 - ((record.minimum_amount.raw_value and record.total_earned.raw_value &gt; record.minimum_amount.raw_value) ? Math.max(1, Math.round((record.total_earned.raw_value - record.minimum_amount.raw_value) / Math.max(record.minimum_amount.raw_value, record.total_earned.raw_value) * 100)) : 0) - ((record.minimum_amount.raw_value &gt; record.total_earned.raw_value) ? Math.max(1, Math.round((record.minimum_amount.raw_value - record.total_earned.raw_value) / Math.max(record.minimum_amount.raw_value, record.total_earned.raw_value) * 100)) : 0)}%"/>
                                    <div class="progress-bar"
                                         t-attf-style="background-color:#ffffff; box-shadow: inset 0 0 0 1px rgba(0,0,0,.25); width: #{(record.minimum_amount.raw_value and record.total_earned.raw_value &gt; record.minimum_amount.raw_value) ? Math.max(1, Math.round((record.total_earned.raw_value - record.minimum_amount.raw_value) / Math.max(record.minimum_amount.raw_value, record.total_earned.raw_value) * 100)) : 0}%"/>
                                    <div class="progress-bar bg-danger"
                                         t-attf-style="width: #{(record.minimum_amount.raw_value &gt; record.total_earned.raw_value) ? Math.max(1, Math.round((record.minimum_amount.raw_value - record.total_earned.raw_value) / Math.max(record.minimum_amount.raw_value, record.total_earned.raw_value) * 100)) : 0}%"/>
                                </div>
                                <div class="text-muted" style="font-size:.68rem; line-height:1.4;"
                                     t-if="Math.max(record.minimum_amount.raw_value, record.total_earned.raw_value) &gt; 0">
                                    <t t-if="record.minimum_amount.raw_value &gt; record.total_earned.raw_value">
                                        <span class="text-danger">earnings below the minimum by
                                            <t t-esc="Math.round(record.minimum_amount.raw_value - record.total_earned.raw_value).toLocaleString()"/></span>
                                    </t>
                                    <t t-elif="record.minimum_amount.raw_value">
                                        <span>earned above the minimum by
                                            <t t-esc="Math.round(record.total_earned.raw_value - record.minimum_amount.raw_value).toLocaleString()"/></span>
                                    </t>
                                    <t t-else="">
                                        <span class="text-success">no minimum guarantee — all earned</span>
                                    </t>
                                </div>
                            </div>

                            <!-- 2. WHAT WE PAY HIM -->
                            <div class="mt-2 px-2 py-2 rounded"
                                 style="background:rgba(128,128,128,.07); font-variant-numeric:tabular-nums;">
                                <div class="text-muted fw-bolder mb-1"
                                     style="font-size:.6rem; letter-spacing:.09em;">WHAT WE PAY HIM</div>
                                <!-- Info header: the contractual minimum, with its
                                     USD reference when one was configured on the
                                     year (guarantees are negotiated in USD). -->
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <span class="small text-muted text-truncate">Min. year commission</span>
                                    <field name="minimum_amount" widget="monetary" class="text-muted flex-shrink-0 text-nowrap ms-2"/>
                                </div>
                                <!-- The headline: the year's eventual total —
                                     max(guarantee, TOTAL earned incl. pending). -->
                                <div class="d-flex justify-content-between align-items-baseline mt-1">
                                    <span class="small fw-bold">Total to pay</span>
                                    <field name="total_to_pay" widget="monetary" class="fw-bold flex-shrink-0 text-nowrap ms-2"/>
                                </div>
                                <!-- Always rendered (blank when nothing is pending)
                                     so every card keeps the same height. -->
                                <div class="text-muted text-end" style="font-size:.68rem; line-height:1.2; min-height:.85rem;">
                                    <t t-if="record.pending_count.raw_value">
                                        includes <t t-esc="Math.round(record.total_pending.raw_value).toLocaleString()"/> awaiting approval
                                    </t>
                                </div>
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <span class="small text-muted text-truncate">Already paid</span>
                                    <field name="amount_paid_cash" widget="monetary" class="text-muted flex-shrink-0 text-nowrap ms-2"/>
                                </div>
                                <!-- Paid counts payments the moment they are ISSUED.
                                     This row shows the part not yet matched against
                                     a bank statement, so nobody mistakes issued for
                                     settled. Always rendered - swapping to a quiet
                                     "nothing pending" state instead of disappearing -
                                     so every card in the row keeps the same height. -->
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <t t-if="record.amount_paid_in_process.raw_value &gt; 0">
                                        <span class="small text-warning text-truncate">
                                            <i class="fa fa-hourglass-half me-1"/>pending reconciliation
                                        </span>
                                        <field name="amount_paid_in_process" widget="monetary"
                                               class="text-warning flex-shrink-0 text-nowrap ms-2"/>
                                    </t>
                                    <t t-else="">
                                        <!-- Full-size dash mirrors the if-branch's
                                             monetary field height. -->
                                        <span class="small text-muted text-truncate">
                                            <i class="fa fa-check me-1"/>nothing pending reconciliation
                                        </span>
                                        <span class="text-muted flex-shrink-0 ms-2">—</span>
                                    </t>
                                </div>
                                <!-- Progress: green = cleared, striped amber = issued
                                     awaiting the bank, WHITE = paid BEYOND what is due
                                     (overpaid / advance — red is reserved for the
                                     guarantee top-up in the earned panel). Scaled to
                                     max(due, paid) so an overpayment shows as a white
                                     tail instead of being silently capped at 100%.
                                     Inset outline keeps the white segment visible on
                                     light backgrounds. -->
                                <div class="progress mt-2 mb-2" style="height:5px;">
                                    <div class="progress-bar bg-success"
                                         t-attf-style="width: #{Math.max(record.total_to_pay.raw_value, record.amount_paid_cash.raw_value) ? Math.round(Math.min(record.amount_paid_cleared.raw_value, record.total_to_pay.raw_value) / Math.max(record.total_to_pay.raw_value, record.amount_paid_cash.raw_value) * 100) : 0}%"/>
                                    <div class="progress-bar progress-bar-striped"
                                         t-attf-style="background-color:#f0ad4e; width: #{Math.max(record.total_to_pay.raw_value, record.amount_paid_cash.raw_value) ? Math.round((Math.min(record.amount_paid_cash.raw_value, record.total_to_pay.raw_value) - Math.min(record.amount_paid_cleared.raw_value, record.total_to_pay.raw_value)) / Math.max(record.total_to_pay.raw_value, record.amount_paid_cash.raw_value) * 100) : 0}%"/>
                                    <div class="progress-bar"
                                         t-attf-style="background-color:#ffffff; box-shadow: inset 0 0 0 1px rgba(0,0,0,.25); width: #{Math.max(record.total_to_pay.raw_value, record.amount_paid_cash.raw_value) ? Math.round(Math.max(0, record.amount_paid_cash.raw_value - record.total_to_pay.raw_value) / Math.max(record.total_to_pay.raw_value, record.amount_paid_cash.raw_value) * 100) : 0}%"/>
                                </div>
                                <!-- Positive outstanding = still owed (red). Zero =
                                     settled (green). Negative = paid beyond due: the
                                     label switches to Overpaid in neutral bold, matching
                                     the white bar segment (red stays reserved for the
                                     guarantee top-up in the earned panel). -->
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <span class="fw-bolder">
                                        <t t-if="record.still_to_pay_total.raw_value &lt; 0">Overpaid (advance)</t>
                                        <t t-else="">Still to pay</t>
                                    </span>
                                    <field name="still_to_pay_total" widget="monetary"
                                           t-attf-class="fw-bolder fs-5 #{record.still_to_pay_total.raw_value &gt; 0 ? 'text-danger' : (record.still_to_pay_total.raw_value == 0 ? 'text-success' : '')}"/>
                                </div>
                            </div>

                            <!-- 3. NOT ALLOCATED: on-account money paid to this
                                 employee but not applied to any year — it counts
                                 in NO card's Paid figure until allocated. Rendered
                                 on every open year so all cards keep the same
                                 height, but the Allocate call-to-action only on
                                 years that still NEED money — a settled year
                                 offering "Allocate to this year" would invite
                                 overpaying it; there the block turns muted and
                                 the button space stays as an invisible spacer. -->
                            <!-- Rendered whenever unallocated money exists — on
                                 CLOSED or settled years as an invisible spacer —
                                 so all cards keep equal heights; the block only
                                 disappears everywhere at once, when the money is
                                 fully allocated. -->
                            <div t-if="record.unallocated_onaccount_amount.raw_value &gt; 0"
                                 class="mt-2 px-2 py-2 rounded"
                                 t-attf-style="background:#{record.still_to_pay_total.raw_value &gt; 0 and record.state.raw_value == 'open' ? 'rgba(240,173,78,.14)' : 'transparent'}; font-variant-numeric:tabular-nums;">
                                <t t-if="record.still_to_pay_total.raw_value &gt; 0 and record.state.raw_value == 'open'">
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <span class="small text-warning fw-bold text-truncate">
                                            <i class="fa fa-exclamation-triangle me-1"/>Not allocated
                                            <span class="badge rounded-pill"
                                                  style="font-size:.62rem; background-color:#f0ad4e; color:#1c1c1c; font-weight:700;"><t t-esc="record.unallocated_onaccount_count.value"/></span>
                                        </span>
                                        <field name="unallocated_onaccount_amount" widget="monetary"
                                               class="text-warning fw-bold flex-shrink-0 text-nowrap ms-2"/>
                                    </div>
                                    <div class="text-muted" style="font-size:.68rem; line-height:1.25;">
                                        Paid to the employee but not applied to any year yet.
                                    </div>
                                    <button type="object" name="action_apply_payment"
                                            class="btn btn-sm btn-warning w-100 mt-1"
                                            groups="vpa_sales_commission.group_commission_manager">
                                        <i class="fa fa-share me-1"/>Allocate to this year
                                    </button>
                                </t>
                                <t t-else="">
                                    <!-- Settled year: shows nothing — an exact
                                         invisible mirror of the actionable variant
                                         (same badge, same full-size amount line, same
                                         caption, same button height) so the card
                                         height stays identical. Plain div for the
                                         button space — a div with a btn class trips
                                         the view validator's simili-button check. -->
                                    <div class="d-flex justify-content-between align-items-baseline" style="visibility:hidden;">
                                        <span class="small fw-bold text-truncate">Not allocated
                                            <span class="badge rounded-pill" style="font-size:.62rem;">0</span>
                                        </span>
                                        <span class="fw-bold flex-shrink-0 text-nowrap ms-2">0</span>
                                    </div>
                                    <div style="font-size:.68rem; line-height:1.25; visibility:hidden;">&#160;</div>
                                    <div class="w-100 mt-1" style="height:29px; visibility:hidden;"></div>
                                </t>
                            </div>

                            <!-- Always rendered with a FIXED height (fits max two
                                 lines, overflow clipped) so every card keeps the
                                 same height in the column regardless of wrapping. -->
                            <div class="text-muted mt-2"
                                 style="font-size:.68rem; line-height:1.25; height:1.7rem; overflow:hidden;">
                                <t t-if="record.pending_count.raw_value">
                                    <i class="fa fa-info-circle me-1"/>
                                    <t t-esc="record.pending_count.value"/> line(s) awaiting approval —
                                    payable once approved.
                                </t>
                                <t t-else="">
                                    <i class="fa fa-check-circle me-1 text-success"/>Everything is approved.
                                </t>
                            </div>

                            <div class="d-flex gap-2 w-100 mt-2">
                                <button type="object" name="action_view_confirmed_lines"
                                        class="btn btn-sm btn-outline-success flex-fill">
                                    <i class="fa fa-check me-1"/>Approved
                                </button>
                                <button type="object" name="action_view_pending_lines"
                                        t-attf-class="btn btn-sm flex-fill #{record.pending_count.raw_value ? 'btn-warning' : 'btn-outline-secondary'}">
                                    <t t-if="record.pending_count.raw_value">
                                        <i class="fa fa-hourglass-half me-1"/>Approve
                                        <t t-esc="record.pending_count.value"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-check me-1"/>No pending
                                    </t>
                                </button>
                            </div>
                            <footer class="pt-2 mt-2 border-top d-block">
                                <div class="d-flex gap-2 w-100 mb-1">
                                    <button type="object" name="action_view_mos" class="btn btn-sm btn-light flex-fill">
                                        <i class="fa fa-industry"/> <t t-esc="record.mo_count.value"/> MOs
                                    </button>
                                    <button type="object" name="action_view_sos" class="btn btn-sm btn-light flex-fill">
                                        <i class="fa fa-shopping-cart"/> <t t-esc="record.so_count.value"/> SOs
                                    </button>
                                    <!-- Opens the payment manager dialog: applied
                                         payments (tick to revert) and on-account
                                         payments (tick to allocate) in one screen. -->
                                    <button type="object" name="action_apply_payment"
                                            class="btn btn-sm btn-light flex-fill"
                                            groups="vpa_sales_commission.group_commission_manager">
                                        <i class="fa fa-money"/> <t t-esc="record.payment_count.value"/> Pmts
                                    </button>
                                </div>
                                <div class="d-flex gap-2 w-100">
                                    <button type="object" name="action_generate_bill" class="btn btn-sm btn-primary flex-fill"
                                            t-if="record.bill_count.raw_value == 0"
                                            groups="vpa_sales_commission.group_commission_manager">
                                        <i class="fa fa-file-text-o"/> Generate Bill
                                    </button>
                                    <button type="object" name="action_view_bills" class="btn btn-sm btn-success flex-fill"
                                            t-if="record.bill_count.raw_value &gt; 0"
                                            groups="vpa_sales_commission.group_commission_manager">
                                        <i class="fa fa-check-circle"/> Bills
                                    </button>
                                    <button type="object" name="action_generate_excess_bill"
                                            class="btn btn-sm btn-warning flex-fill"
                                            t-if="record.excess_to_bill.raw_value &gt; 0"
                                            groups="vpa_sales_commission.group_commission_manager">
                                        <i class="fa fa-plus-circle"/> Bill Excess
                                    </button>
                                    <!-- Pay only while money is still owed; a fully
                                         settled year offers the actual next step —
                                         Close Year — instead of inviting an overpay.
                                         (An advance on a settled year is still
                                         possible via Commission Payments → New.) -->
                                    <button type="object" name="action_register_payment" class="btn btn-sm btn-primary flex-fill"
                                            t-if="record.state.raw_value == 'open' and record.still_to_pay_total.raw_value &gt; 0"
                                            groups="vpa_sales_commission.group_commission_manager">
                                        <i class="fa fa-money"/> Pay
                                    </button>
                                    <button type="object" name="action_close_year" class="btn btn-sm btn-danger flex-fill"
                                            t-if="record.state.raw_value == 'open' and record.still_to_pay_total.raw_value &lt;= 0"
                                            groups="vpa_sales_commission.group_commission_manager">
                                        <i class="fa fa-lock"/> Close Year
                                    </button>
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Commission Centre List View (all employees x years) -->
    <record id="vpa_commission_scheme_year_view_list" model="ir.ui.view">
        <field name="name">vpa.commission.scheme.year.list</field>
        <field name="model">vpa.commission.scheme.year</field>
        <field name="arch" type="xml">
            <list string="Commission Centre" create="false"
                  decoration-muted="state == 'closed'">
                <field name="employee_id"/>
                <field name="year"/>
                <field name="effective_rate" string="Rate (%)"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="minimum_amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}" string="Guarantee"/>
                <field name="advance_consumed" widget="monetary"
                       options="{'currency_field': 'currency_id'}" optional="hide"/>
                <field name="advance_remaining" widget="monetary"
                       options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="payable_to_employee" widget="monetary"
                       options="{'currency_field': 'currency_id'}" optional="hide"/>
                <field name="total_earned" widget="monetary"
                       options="{'currency_field': 'currency_id'}" sum="Total Earned"/>
                <field name="amount_due_year" widget="monetary" string="Due for Year"
                       options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="amount_paid_cash" widget="monetary" string="Paid"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="outstanding_cash" widget="monetary" string="Outstanding"
                       options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="unallocated_onaccount_amount" widget="monetary" string="Not Allocated"
                       options="{'currency_field': 'currency_id'}" optional="hide"
                       decoration-warning="unallocated_onaccount_amount &gt; 0"/>
                <field name="shortfall" widget="monetary"
                       options="{'currency_field': 'currency_id'}" sum="Shortfall"
                       decoration-danger="shortfall &gt; 0"/>
                <field name="effective_expense_account_id" string="Expense Account" optional="show"/>
                <field name="bill_count" string="Bills" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'open'"
                       decoration-danger="state == 'closed'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_generate_bill" type="object" string="Generate Bill"
                        icon="fa-file-text-o"
                        invisible="bill_count > 0"
                        groups="vpa_sales_commission.group_commission_manager"/>
                <button name="action_view_bills" type="object" string="Bills"
                        icon="fa-check-circle" class="text-success"
                        invisible="bill_count == 0"
                        groups="vpa_sales_commission.group_commission_manager"/>
            </list>
        </field>
    </record>

    <!-- Commission Centre Search View -->
    <record id="vpa_commission_scheme_year_view_search" model="ir.ui.view">
        <field name="name">vpa.commission.scheme.year.search</field>
        <field name="model">vpa.commission.scheme.year</field>
        <field name="arch" type="xml">
            <search string="Commission Centre">
                <field name="employee_id"/>
                <field name="year"/>
                <separator/>
                <filter string="Open" name="filter_open" domain="[('state', '=', 'open')]"/>
                <filter string="Closed" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Has Shortfall" name="filter_shortfall" domain="[('shortfall', '>', 0)]"/>
                <filter string="Has Guarantee" name="filter_guarantee" domain="[('minimum_amount', '>', 0)]"/>
                <filter string="Payable to Employee" name="filter_payable" domain="[('payable_to_employee', '>', 0)]"/>
                <separator/>
                <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <searchpanel>
                    <field name="year" string="Year" enable_counters="1" icon="fa-calendar"/>
                    <field name="employee_id" string="Employee" enable_counters="1" icon="fa-user" limit="20"/>
                    <field name="state" string="Status" enable_counters="1" icon="fa-check-square-o"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Commission Centre Pivot View -->
    <record id="vpa_commission_scheme_year_view_pivot" model="ir.ui.view">
        <field name="name">vpa.commission.scheme.year.pivot</field>
        <field name="model">vpa.commission.scheme.year</field>
        <field name="arch" type="xml">
            <pivot string="Commission Centre">
                <field name="employee_id" type="row"/>
                <field name="year" type="col"/>
                <field name="total_earned" type="measure"/>
                <field name="total_paid" type="measure"/>
                <field name="shortfall" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Commission Centre Action -->
    <record id="action_commission_centre" model="ir.actions.act_window">
        <field name="name">Commission Centre</field>
        <field name="res_model">vpa.commission.scheme.year</field>
        <field name="view_mode">kanban,list,pivot,form</field>
        <field name="search_view_id" ref="vpa_commission_scheme_year_view_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No commission years configured yet
            </p>
            <p>
                The Commission Centre shows every employee's yearly commission configuration
                and performance: rate, minimum guarantee, earned, paid, outstanding and shortfall.
                Configure years on each employee's Commission Scheme.
            </p>
        </field>
    </record>

    <!-- Reopen Year Wizard (reason required, logged) -->
    <record id="vpa_commission_reopen_year_wizard_form" model="ir.ui.view">
        <field name="name">vpa.commission.reopen.year.wizard.form</field>
        <field name="model">vpa.commission.reopen.year.wizard</field>
        <field name="arch" type="xml">
            <form string="Reopen Year">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        Reopening unlocks all commission lines of this year.
                        The action is logged permanently with your name, the time and the reason.
                    </div>
                    <group>
                        <field name="scheme_year_id" readonly="1"/>
                        <field name="reason" placeholder="e.g. Commission for MO/00631 was missing when the year was closed"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_reopen" string="Reopen Year" type="object"
                            class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Close Year Confirmation Wizard -->
    <record id="vpa_commission_close_year_wizard_form" model="ir.ui.view">
        <field name="name">vpa.commission.close.year.wizard.form</field>
        <field name="model">vpa.commission.close.year.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Year">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Warning:</strong> This year still has open items.
                    </div>
                    <group>
                        <field name="scheme_year_id" readonly="1"/>
                        <field name="unpaid_count" readonly="1" string="Unapproved Lines"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="unpaid_amount" readonly="1" widget="monetary" string="Outstanding (Cash)"/>
                    </group>
                    <p>Closing the year will lock all commission lines. You can still create bills and payments after closing.</p>
                </sheet>
                <footer>
                    <button name="action_confirm_close" type="object"
                            string="Close Year Anyway" class="btn-danger"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
