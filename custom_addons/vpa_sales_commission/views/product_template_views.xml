<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Product Template Form View -->
    <record id="product_template_form_view_commission" model="ir.ui.view">
        <field name="name">product.template.form.commission</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group[@name='group_general']" position="inside">
                <field name="not_commissionable" groups="vpa_sales_commission.group_commission_manager"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Product Template List View -->
    <record id="product_template_list_view_commission" model="ir.ui.view">
        <field name="name">product.template.list.commission</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="not_commissionable" optional="hide" groups="vpa_sales_commission.group_commission_manager"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Product Template Search View -->
    <record id="product_template_search_view_commission" model="ir.ui.view">
        <field name="name">product.template.search.commission</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="Not Commissionable" name="not_commissionable"
                        domain="[('not_commissionable', '=', True)]"
                        groups="vpa_sales_commission.group_commission_manager"/>
            </xpath>
        </field>
    </record>

</odoo>
