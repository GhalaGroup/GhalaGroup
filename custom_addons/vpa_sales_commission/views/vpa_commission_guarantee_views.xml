<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Commission Guarantee Form View -->
    <record id="vpa_commission_guarantee_view_form" model="ir.ui.view">
        <field name="name">vpa.commission.guarantee.form</field>
        <field name="model">vpa.commission.guarantee</field>
        <field name="arch" type="xml">
            <form string="Annual Guarantee">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_commission_lines" type="object"
                                class="oe_stat_button" icon="fa-list-alt">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Commission Lines</span>
                            </div>
                        </button>
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="payment_count" string="Payments" widget="statinfo"/>
                        </button>
                        <button name="action_print_statement" type="object"
                                class="oe_stat_button" icon="fa-print">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Statement</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Definition">
                            <field name="scheme_id"/>
                            <field name="employee_id"/>
                            <field name="year"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="guarantee_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="guarantee_amount_usd"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Summary">
                            <field name="total_earned" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="total_pending" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="total_confirmed" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <button name="action_view_payments" type="object"
                                    class="oe_link" string="View Payments"
                                    invisible="total_paid == 0"/>
                            <field name="total_paid" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="shortfall" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   decoration-danger="shortfall > 0"/>
                            <field name="outstanding" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'on_track'"
                                   decoration-danger="status == 'shortfall'"
                                   decoration-muted="status == 'no_lines'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commission Lines" name="commission_lines">
                            <field name="commission_line_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="date"/>
                                    <field name="production_id"/>
                                    <field name="sale_order_name"/>
                                    <field name="item_name"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="base_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="rate"/>
                                    <field name="amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'pending'"
                                           decoration-warning="state == 'confirmed'"
                                           decoration-success="state == 'paid'"
                                           decoration-danger="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Paid Lines" name="paid_lines">
                            <field name="commission_line_ids" readonly="1"
                                   domain="[('state', '=', 'paid')]">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="production_id"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="payment_id" string="Payment"/>
                                    <field name="paid_date"/>
                                    <field name="paid_by"/>
                                </list>
                            </field>
                            <group>
                                <button name="action_view_payments" type="object"
                                        string="View Payments in Accounting"
                                        class="btn-link" icon="fa-external-link"
                                        invisible="total_paid == 0"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Commission Guarantee List View -->
    <record id="vpa_commission_guarantee_view_list" model="ir.ui.view">
        <field name="name">vpa.commission.guarantee.list</field>
        <field name="model">vpa.commission.guarantee</field>
        <field name="arch" type="xml">
            <list string="Annual Guarantees" decoration-danger="shortfall > 0">
                <field name="employee_id"/>
                <field name="year"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="guarantee_amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}" string="Guarantee"/>
                <field name="guarantee_amount_usd" string="USD Equiv."/>
                <field name="total_earned" widget="monetary"
                       options="{'currency_field': 'currency_id'}" string="Earned"/>
                <field name="total_paid" widget="monetary"
                       options="{'currency_field': 'currency_id'}" string="Paid"/>
                <field name="outstanding" widget="monetary"
                       options="{'currency_field': 'currency_id'}" string="Outstanding"/>
                <field name="shortfall" widget="monetary"
                       options="{'currency_field': 'currency_id'}" string="Shortfall"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'on_track'"
                       decoration-danger="status == 'shortfall'"
                       decoration-muted="status == 'no_lines'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Commission Guarantee Search View -->
    <record id="vpa_commission_guarantee_view_search" model="ir.ui.view">
        <field name="name">vpa.commission.guarantee.search</field>
        <field name="model">vpa.commission.guarantee</field>
        <field name="arch" type="xml">
            <search string="Annual Guarantees">
                <field name="employee_id"/>
                <field name="year"/>
                <field name="scheme_id"/>
                <separator/>
                <filter string="Has Shortfall" name="has_shortfall"
                        domain="[('shortfall', '>', 0)]"/>
                <filter string="On Track" name="on_track"
                        domain="[('shortfall', '=', 0)]"/>
                <separator/>
                <filter string="Employee" name="group_employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter string="Year" name="group_year"
                        context="{'group_by': 'year'}"/>
                <filter string="Company" name="group_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
                <searchpanel>
                    <field name="employee_id" string="Employee" enable_counters="1" icon="fa-user" limit="20"/>
                    <field name="year" string="Year" enable_counters="1" icon="fa-calendar"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Commission Guarantee Pivot View -->
    <record id="vpa_commission_guarantee_view_pivot" model="ir.ui.view">
        <field name="name">vpa.commission.guarantee.pivot</field>
        <field name="model">vpa.commission.guarantee</field>
        <field name="arch" type="xml">
            <pivot string="Guarantee Analysis">
                <field name="employee_id" type="row"/>
                <field name="year" type="col"/>
                <field name="guarantee_amount" type="measure"/>
                <field name="total_earned" type="measure"/>
                <field name="total_paid" type="measure"/>
                <field name="shortfall" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Commission Guarantee Graph View -->
    <record id="vpa_commission_guarantee_view_graph" model="ir.ui.view">
        <field name="name">vpa.commission.guarantee.graph</field>
        <field name="model">vpa.commission.guarantee</field>
        <field name="arch" type="xml">
            <graph string="Guarantee vs Earned" type="bar">
                <field name="employee_id"/>
                <field name="guarantee_amount" type="measure"/>
                <field name="total_earned" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Commission Statement Form View (dedicated read-only statement page) -->
    <record id="vpa_commission_guarantee_statement_view_form" model="ir.ui.view">
        <field name="name">vpa.commission.guarantee.statement.form</field>
        <field name="model">vpa.commission.guarantee</field>
        <field name="arch" type="xml">
            <form string="Commission Statement" create="0" edit="0" delete="0">
                <header>
                    <button name="%(action_report_commission_statement_guarantee)d"
                            string="Print PDF" type="action" class="btn-primary"
                            icon="fa-print"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title mb-3">
                        <h1 style="color: #DC143C;">
                            COMMISSION STATEMENT
                        </h1>
                        <h2>
                            <field name="employee_id" readonly="1"/> — <field name="year" readonly="1"/>
                        </h2>
                    </div>

                    <!-- Single unified table: all commission lines with payment info -->
                    <field name="commission_line_ids" readonly="1">
                        <list decoration-success="state == 'paid'"
                              decoration-info="state == 'pending'"
                              decoration-warning="state == 'confirmed'">
                            <field name="date"/>
                            <field name="production_id" string="MO"/>
                            <field name="sale_order_name" string="SO"/>
                            <field name="item_name"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="base_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" sum="Total"/>
                            <field name="rate" string="%"/>
                            <field name="amount" widget="monetary" string="Commission"
                                   options="{'currency_field': 'currency_id'}" sum="Total"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'pending'"
                                   decoration-warning="state == 'confirmed'"
                                   decoration-success="state == 'paid'"/>
                            <field name="amount_paid" widget="monetary" string="Paid"
                                   options="{'currency_field': 'currency_id'}" sum="Total"/>
                            <field name="amount_due" widget="monetary" string="Due"
                                   options="{'currency_field': 'currency_id'}" sum="Total"/>
                            <field name="payment_id" string="Payment Ref" optional="show"/>
                            <field name="paid_date" optional="show"/>
                        </list>
                    </field>

                    <!-- Statement Summary Footer -->
                    <group>
                        <group>
                            <separator string="Statement Summary"/>
                            <field name="total_earned" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   string="A. Total Commission Earned"/>
                            <field name="total_paid" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   string="B. Total Paid"/>
                            <field name="outstanding" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   string="C. Outstanding (A - B)"/>
                        </group>
                        <group>
                            <separator string="Guarantee"/>
                            <field name="guarantee_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   string="D. Minimum Guarantee"/>
                            <field name="shortfall" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   string="E. Shortfall (D - A)"
                                   decoration-danger="shortfall > 0"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'on_track'"
                                   decoration-danger="status == 'shortfall'"
                                   decoration-muted="status == 'no_lines'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Commission Statement Action (opens statement form for a specific guarantee) -->
    <record id="vpa_commission_guarantee_statement_action" model="ir.actions.act_window">
        <field name="name">Commission Statement</field>
        <field name="res_model">vpa.commission.guarantee</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="vpa_commission_guarantee_statement_view_form"/>
        <field name="target">current</field>
    </record>

    <!-- Commission Guarantee Action -->
    <record id="vpa_commission_guarantee_action" model="ir.actions.act_window">
        <field name="name">Annual Guarantees</field>
        <field name="res_model">vpa.commission.guarantee</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="vpa_commission_guarantee_view_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define Annual Minimum Guarantees
            </p>
            <p>
                Set up annual guarantee amounts for each employee to track
                earned commission versus the minimum guarantee.
            </p>
        </field>
    </record>

</odoo>
