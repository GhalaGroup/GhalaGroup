<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Commission Line Form View -->
    <record id="vpa_commission_line_view_form" model="ir.ui.view">
        <field name="name">vpa.commission.line.form</field>
        <field name="model">vpa.commission.line</field>
        <field name="arch" type="xml">
            <form string="Commission Line">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary"
                            invisible="state != 'pending'"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('paid', 'cancelled')"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <button name="action_reset_to_pending" string="Reset to Pending" type="object"
                            invisible="state not in ('confirmed', 'cancelled')"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="scheme_id"/>
                            <field name="employee_id"/>
                            <field name="type"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="production_id"/>
                            <field name="invoice_id" invisible="type != 'sales'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="delivered"/>
                            <field name="delivery_date" invisible="not delivered"/>
                        </group>
                    </group>
                    <group string="Commission Calculation">
                        <group>
                            <field name="base_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="rate"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Status Information" invisible="state == 'pending'">
                        <group invisible="not confirmed_date">
                            <field name="confirmed_date"/>
                            <field name="confirmed_by"/>
                        </group>
                        <group invisible="not paid_date">
                            <field name="paid_date"/>
                            <field name="paid_by"/>
                            <field name="payment_move_id" invisible="not payment_move_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials" name="materials">
                            <field name="material_line_ids">
                                <list>
                                    <field name="included"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Commission Line List View -->
    <record id="vpa_commission_line_view_list" model="ir.ui.view">
        <field name="name">vpa.commission.line.list</field>
        <field name="model">vpa.commission.line</field>
        <field name="arch" type="xml">
            <list string="Commission Lines" multi_edit="1">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="scheme_id" optional="hide"/>
                <field name="type" optional="hide"/>
                <field name="production_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="base_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="rate"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="delivered" widget="boolean" string="Delivered"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Commission Line Search View -->
    <record id="vpa_commission_line_view_search" model="ir.ui.view">
        <field name="name">vpa.commission.line.search</field>
        <field name="model">vpa.commission.line</field>
        <field name="arch" type="xml">
            <search string="Commission Lines">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="scheme_id"/>
                <field name="production_id"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Production" name="production" domain="[('type', '=', 'production')]"/>
                <filter string="Sales" name="sales" domain="[('type', '=', 'sales')]"/>
                <separator/>
                <filter string="Delivered" name="delivered" domain="[('delivered', '=', True)]"/>
                <filter string="Not Delivered" name="not_delivered" domain="[('delivered', '=', False)]"/>
                <separator/>
                <filter string="Date" name="filter_date" date="date" default_period="year"/>
                <separator/>
                <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Scheme" name="group_scheme" context="{'group_by': 'scheme_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Type" name="group_type" context="{'group_by': 'type'}"/>
                <filter string="Year" name="group_year" context="{'group_by': 'date:year'}"/>
                <filter string="Quarter" name="group_quarter" context="{'group_by': 'date:quarter'}"/>
                <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                <filter string="Manufacturing Order" name="group_production" context="{'group_by': 'production_id'}"/>
                <searchpanel>
                    <field name="state" string="Status" enable_counters="1" icon="fa-check-square-o"/>
                    <field name="employee_id" string="Employee" enable_counters="1" icon="fa-user" limit="20"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Commission Line Pivot View -->
    <record id="vpa_commission_line_view_pivot" model="ir.ui.view">
        <field name="name">vpa.commission.line.pivot</field>
        <field name="model">vpa.commission.line</field>
        <field name="arch" type="xml">
            <pivot string="Commission Analysis">
                <field name="employee_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
                <field name="base_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Commission Line Graph View -->
    <record id="vpa_commission_line_view_graph" model="ir.ui.view">
        <field name="name">vpa.commission.line.graph</field>
        <field name="model">vpa.commission.line</field>
        <field name="arch" type="xml">
            <graph string="Commission Analysis" type="bar">
                <field name="employee_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Commission Lines Action (for Managers) -->
    <record id="vpa_commission_line_action" model="ir.actions.act_window">
        <field name="name">Commission Lines</field>
        <field name="res_model">vpa.commission.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="vpa_commission_line_view_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No commission lines yet
            </p>
            <p>
                Commission lines are automatically created when Manufacturing Orders are completed.
                They require manager approval before being marked as paid.
            </p>
        </field>
    </record>

    <!-- My Commissions Action (for Users - shows only own commissions) -->
    <record id="vpa_commission_line_action_my" model="ir.actions.act_window">
        <field name="name">My Commissions</field>
        <field name="res_model">vpa.commission.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="vpa_commission_line_view_search"/>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No commissions yet
            </p>
            <p>
                Your commission lines will appear here when Manufacturing Orders you're assigned to are completed.
            </p>
        </field>
    </record>

</odoo>
