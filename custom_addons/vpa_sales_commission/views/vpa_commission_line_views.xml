<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Commission Line Form View -->
    <record id="vpa_commission_line_view_form" model="ir.ui.view">
        <field name="name">vpa.commission.line.form</field>
        <field name="model">vpa.commission.line</field>
        <field name="arch" type="xml">
            <form string="Commission Line">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary"
                            invisible="state != 'pending'"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('paid', 'cancelled')"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <button name="action_reset_to_pending" string="Reset to Pending" type="object"
                            invisible="state not in ('confirmed', 'paid', 'cancelled')"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="scheme_id" readonly="1"/>
                            <field name="employee_id"/>
                            <field name="type" readonly="1"/>
                            <field name="date" readonly="1"/>
                        </group>
                        <group>
                            <field name="production_id" readonly="1" invisible="type == 'manual'"/>
                            <field name="partner_id" readonly="type != 'manual'"/>
                            <field name="sale_order_name" readonly="type != 'manual'"/>
                            <field name="customer_ref" readonly="1"/>
                            <field name="item_name" readonly="type != 'manual'"/>
                            <field name="invoice_id" invisible="type != 'sales'" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="delivered"/>
                            <field name="delivery_date" invisible="not delivered"/>
                        </group>
                    </group>
                    <group string="Commission Calculation">
                        <group>
                            <field name="base_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="type != 'manual'"/>
                            <field name="rate" readonly="type != 'manual'"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="History">
                        <group>
                            <field name="create_date" string="Created On" readonly="1"/>
                            <field name="create_uid" string="Created By" readonly="1"/>
                        </group>
                        <group invisible="not confirmed_date">
                            <field name="confirmed_date"/>
                            <field name="confirmed_by"/>
                        </group>
                    </group>
                    <group string="Payment Information" invisible="state != 'paid'">
                        <group>
                            <field name="paid_date"/>
                            <field name="paid_by"/>
                        </group>
                        <group>
                            <field name="payment_id" invisible="not payment_id"/>
                            <field name="bill_id" invisible="payment_id or not bill_id" string="Paid Via Bill"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials" name="materials">
                            <div class="d-flex mb-2">
                                <button name="action_adjust_materials"
                                        string="Adjust Materials"
                                        type="object"
                                        class="btn-primary"
                                        icon="fa-pencil"
                                        invisible="state in ('paid', 'cancelled')"
                                        groups="vpa_sales_commission.group_commission_manager"/>
                            </div>
                            <field name="material_line_ids" readonly="1">
                                <list>
                                    <field name="included"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Commission Line List View -->
    <record id="vpa_commission_line_view_list" model="ir.ui.view">
        <field name="name">vpa.commission.line.list</field>
        <field name="model">vpa.commission.line</field>
        <field name="arch" type="xml">
            <list string="Commission Lines" multi_edit="1" create="0">
                <header>
                    <button name="action_bulk_confirm" string="Confirm"
                            type="object" class="btn-success"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <button name="%(action_commission_generate_bill)d" string="Generate Bill"
                            type="action" class="btn-primary"
                            groups="vpa_sales_commission.group_commission_manager"/>
                    <button name="%(server_action_change_commission_date_line)d" string="Change Date"
                            type="action" class="btn-secondary"
                            groups="vpa_sales_commission.group_commission_manager"/>
                </header>
                <field name="name" width="155px"/>
                <field name="date" width="98px"/>
                <field name="employee_id" optional="hide"/>
                <field name="scheme_id" optional="hide"/>
                <field name="type" optional="hide"/>
                <field name="production_id" optional="hide" width="135px"/>
                <field name="partner_id" optional="hide" string="Client"/>
                <field name="sale_order_name" width="85px"/>
                <field name="customer_ref" string="Customer Ref" optional="show"
                       width="190px"/>
                <field name="item_name" width="300px"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="base_amount" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide"/>
                <field name="rate" width="55px"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="delivered" widget="boolean" string="Dlv" width="40px"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'cancelled'"/>
                <button name="action_confirm" type="object" string="Approve"
                        icon="fa-check" class="text-success"
                        invisible="state != 'pending'"
                        groups="vpa_sales_commission.group_commission_manager"/>
                <button name="action_cancel" type="object" string="Reject"
                        icon="fa-times" class="text-danger"
                        invisible="state != 'pending'"
                        groups="vpa_sales_commission.group_commission_manager"/>
                <field name="bill_id" optional="hide" string="Bill"
                       decoration-info="bill_state == 'billed'"
                       decoration-success="bill_state == 'paid'"/>
                <button name="action_view_bill" type="object"
                        icon="fa-external-link" title="Open Bill"
                        invisible="not bill_id"/>
                <field name="bill_state" widget="badge" optional="hide"
                       decoration-muted="bill_state == 'not_billed'"
                       decoration-info="bill_state == 'billed'"
                       decoration-success="bill_state == 'paid'"/>
                <field name="year_locked" column_invisible="1"/>
                <field name="create_date" string="Created On" optional="hide"/>
                <field name="confirmed_date" string="Confirmed On" optional="show" width="150px"/>
                <field name="confirmed_by" string="Confirmed By" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Commission Line Search View -->
    <record id="vpa_commission_line_view_search" model="ir.ui.view">
        <field name="name">vpa.commission.line.search</field>
        <field name="model">vpa.commission.line</field>
        <field name="arch" type="xml">
            <search string="Commission Lines">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="partner_id" string="Client"/>
                <field name="customer_ref"/>
                <field name="sale_order_name"/>
                <field name="scheme_id"/>
                <field name="production_id"/>
                <separator/>
                <filter string="Applied" name="pending" domain="[('state', 'in', ('pending', 'confirmed'))]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Production" name="production" domain="[('type', '=', 'production')]"/>
                <filter string="Sales" name="sales" domain="[('type', '=', 'sales')]"/>
                <filter string="Manual" name="manual" domain="[('type', '=', 'manual')]"/>
                <separator/>
                <filter string="Delivered" name="delivered" domain="[('delivered', '=', True)]"/>
                <filter string="Not Delivered" name="not_delivered" domain="[('delivered', '=', False)]"/>
                <separator/>
                <filter string="Not Billed" name="not_billed" domain="[('bill_id', '=', False)]"/>
                <filter string="Billed" name="billed" domain="[('bill_id', '!=', False)]"/>
                <separator/>
                <filter string="Date" name="filter_date" date="date" default_period="year"/>
                <separator/>
                <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Customer Ref" name="group_customer_ref" context="{'group_by': 'customer_ref'}"/>
                <filter string="Sales Order" name="group_sale_order" context="{'group_by': 'sale_order_name'}"/>
                <filter string="Scheme" name="group_scheme" context="{'group_by': 'scheme_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Type" name="group_type" context="{'group_by': 'type'}"/>
                <filter string="Year" name="group_year" context="{'group_by': 'date:year'}"/>
                <filter string="Quarter" name="group_quarter" context="{'group_by': 'date:quarter'}"/>
                <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                <filter string="Manufacturing Order" name="group_production" context="{'group_by': 'production_id'}"/>
                <searchpanel>
                    <field name="state" string="Status" enable_counters="1" icon="fa-check-square-o"/>
                    <field name="employee_id" string="Employee" enable_counters="1" icon="fa-user" limit="20"/>
                    <field name="date_year" string="Year" enable_counters="1" icon="fa-calendar"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Commission Line Pivot View -->
    <record id="vpa_commission_line_view_pivot" model="ir.ui.view">
        <field name="name">vpa.commission.line.pivot</field>
        <field name="model">vpa.commission.line</field>
        <field name="arch" type="xml">
            <pivot string="Commission Analysis">
                <field name="employee_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
                <field name="base_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Commission Line Graph View -->
    <record id="vpa_commission_line_view_graph" model="ir.ui.view">
        <field name="name">vpa.commission.line.graph</field>
        <field name="model">vpa.commission.line</field>
        <field name="arch" type="xml">
            <graph string="Commission Analysis" type="bar">
                <field name="employee_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Commission Lines Action (for Managers) -->
    <record id="vpa_commission_line_action" model="ir.actions.act_window">
        <field name="name">Commission Lines</field>
        <field name="res_model">vpa.commission.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="vpa_commission_line_view_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No commission lines yet
            </p>
            <p>
                Commission lines are automatically created when Manufacturing Orders are completed.
                They require manager confirmation. Use the "Make Payment" action to process payments.
            </p>
        </field>
    </record>

    <!-- Commission Payments Action (server action to query linked payments) -->
    <record id="vpa_commission_payments_action" model="ir.actions.server">
        <field name="name">Commission Payments</field>
        <field name="model_id" ref="vpa_sales_commission.model_vpa_commission_line"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_commission_payments()</field>
    </record>

    <!-- My Commissions Action (for Users - shows only own commissions) -->
    <record id="vpa_commission_line_action_my" model="ir.actions.act_window">
        <field name="name">My Commissions</field>
        <field name="res_model">vpa.commission.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="vpa_commission_line_view_search"/>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No commissions yet
            </p>
            <p>
                Your commission lines will appear here when Manufacturing Orders you're assigned to are completed.
            </p>
        </field>
    </record>

</odoo>
