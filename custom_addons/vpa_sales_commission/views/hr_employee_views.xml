<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Commission smart button to Employee Form -->
    <record id="hr_employee_view_form_inherit_commission" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.commission</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_commission_lines" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="not has_commission_scheme"
                        groups="vpa_sales_commission.group_commission_manager">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="commission_count"/>
                        </span>
                        <span class="o_stat_text">Commissions</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
