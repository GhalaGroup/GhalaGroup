<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Commission Generate Wizard Form View -->
    <record id="commission_generate_wizard_view_form" model="ir.ui.view">
        <field name="name">vpa.commission.generate.wizard.form</field>
        <field name="model">vpa.commission.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Commission">
                <field name="currency_id" invisible="1"/>
                <field name="has_history" invisible="1"/>
                <field name="use_override" invisible="1"/>
                <group>
                    <group>
                        <field name="production_id"/>
                        <field name="commission_date"/>
                    </group>
                    <group>
                        <field name="product_id"/>
                        <label for="product_qty"/>
                        <div class="o_row">
                            <field name="product_qty" class="oe_inline"/>
                            <field name="product_uom_id" class="oe_inline" options="{'no_open': True}"/>
                        </div>
                    </group>
                </group>
                <group>
                    <!-- Left: what the commission is calculated FROM.
                         Right: what is actually paid. Splitting them fills the
                         right half of the dialog and keeps "Per Item" directly
                         under the total it derives from. -->
                    <group>
                        <field name="total_base_amount" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                        <label for="cost_per_unit"/>
                        <!-- flex-grow-0/w-auto keep the unit next to the number
                             instead of letting the value field stretch -->
                        <div class="d-flex align-items-center gap-1">
                            <field name="cost_per_unit" widget="monetary" class="oe_inline flex-grow-0 w-auto"
                                   options="{'currency_field': 'currency_id'}"/>
                            <span class="text-muted">/</span>
                            <field name="product_uom_id" class="oe_inline flex-grow-0 w-auto" readonly="1"
                                   options="{'no_open': True}"/>
                        </div>
                    </group>
                    <group>
                        <field name="manual_commission"/>
                        <field name="total_commission_amount" widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               readonly="not manual_commission"/>
                        <label for="commission_per_item" string="Per Item"/>
                        <div class="d-flex align-items-center gap-1">
                            <field name="commission_per_item" widget="monetary" class="oe_inline flex-grow-0 w-auto"
                                   options="{'currency_field': 'currency_id'}"/>
                            <span class="text-muted">/</span>
                            <field name="product_uom_id" class="oe_inline flex-grow-0 w-auto" readonly="1"
                                   options="{'no_open': True}"/>
                        </div>
                        <field name="total_extra_amount" widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               invisible="total_extra_amount == 0"
                               decoration-warning="total_extra_amount &gt; 0"/>
                    </group>
                </group>
                <!-- Override Banner -->
                <div class="alert alert-info d-flex align-items-center justify-content-between"
                     role="alert" invisible="not use_override">
                    <div>
                        <i class="fa fa-info-circle me-1" title="Information"/>
                        <strong>Historical base amount applied</strong> from
                        <field name="override_source" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <button name="action_clear_override" type="object"
                            string="Clear Override" class="btn btn-sm btn-outline-secondary ms-2"/>
                </div>
                <!-- Commission History -->
                <separator string="Commission History for This Product"
                           invisible="not has_history"/>
                <div class="text-muted" style="font-size: 0.85em; margin-bottom: 4px;"
                     invisible="not has_history">
                    <em>Past commissions for the same product. Click "Use" to apply a historical base amount.</em>
                </div>
                <field name="history_line_ids" invisible="not has_history" readonly="1">
                    <list create="false" delete="false">
                        <field name="production_name" string="MO"/>
                        <field name="date"/>
                        <field name="product_qty" string="Qty"/>
                        <field name="product_uom_id" string="UoM"/>
                        <field name="base_amount" string="Base Amount" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="cost_per_unit" string="Per Unit" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="commission_amount" string="Commission" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="currency_id" column_invisible="1"/>
                        <button name="action_use_this_amount" type="object"
                                string="Use" class="btn-link"
                                icon="fa-check-circle"/>
                    </list>
                </field>
                <separator string="Assign To Employees"/>
                <field name="scheme_line_ids">
                    <list editable="bottom" decoration-muted="already_generated">
                        <field name="selected" string="Select"
                               readonly="already_generated"/>
                        <field name="employee_id"/>
                        <field name="rate" string="Rate (%)"
                               readonly="not parent.manual_commission"/>
                        <field name="estimated_amount" string="Commission"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               readonly="not parent.manual_commission"/>
                        <field name="standard_rate" string="Std. Rate" optional="hide"/>
                        <field name="extra_amount" string="Extra" widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               decoration-warning="extra_amount &gt; 0"
                               decoration-info="extra_amount &lt; 0"/>
                        <field name="commission_per_unit" string="Per Unit"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="already_generated" column_invisible="1"/>
                        <field name="scheme_id" column_invisible="1"/>
                    </list>
                </field>
                <div class="text-muted" style="font-size: 0.85em; margin-bottom: 8px;">
                    <em>Greyed out employees already have commission for this MO.</em>
                </div>
                <separator string="Raw Materials"/>
                <field name="material_line_ids">
                    <!-- Two totals: "Total Cost" sums every line, "Commissionable"
                         sums only included ones and equals Total Base Amount.
                         Odoo's sum= cannot filter, hence the second column. -->
                    <list editable="bottom" decoration-muted="not included">
                        <field name="included" string="Include"/>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="unit_cost"/>
                        <field name="amount" sum="Total Cost"/>
                        <field name="commissionable_amount" sum="Commissionable"/>
                    </list>
                </field>
                <footer>
                    <button name="action_generate" string="Generate Commission"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for the wizard -->
    <record id="action_commission_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Commission</field>
        <field name="res_model">vpa.commission.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
