<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Commission Payment Wizard Form View -->
    <record id="vpa_commission_payment_wizard_view_form" model="ir.ui.view">
        <field name="name">vpa.commission.payment.wizard.form</field>
        <field name="model">vpa.commission.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Make Payment">
                <group>
                    <group>
                        <field name="payment_method" widget="radio"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="total_amount" widget="monetary"
                               options="{'currency_field': 'currency_id'}" readonly="1"/>
                    </group>
                </group>
                <separator string="Commission Lines"/>
                <field name="line_ids" readonly="1">
                    <list>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="date"/>
                        <field name="production_id"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="amount" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                    </list>
                </field>
                <separator/>
                <group invisible="payment_method != 'existing'">
                    <group string="Link Existing Payment">
                        <field name="existing_payment_id"
                               required="payment_method == 'existing'"/>
                    </group>
                </group>
                <group invisible="payment_method != 'new'">
                    <group string="Create New Payment">
                        <field name="journal_id"
                               required="payment_method == 'new'"/>
                        <field name="payment_date"
                               required="payment_method == 'new'"/>
                        <field name="partner_id" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_make_payment" string="Confirm Payment"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server Action: Make Payment (appears in Actions dropdown on Commission Lines) -->
    <record id="action_commission_make_payment" model="ir.actions.act_window">
        <field name="name">Make Payment</field>
        <field name="res_model">vpa.commission.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="vpa_commission_payment_wizard_view_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="vpa_sales_commission.model_vpa_commission_line"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
