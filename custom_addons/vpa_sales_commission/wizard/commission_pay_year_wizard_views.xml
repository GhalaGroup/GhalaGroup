<odoo>

    <record id="commission_pay_year_wizard_form" model="ir.ui.view">
        <field name="name">vpa.commission.pay.year.wizard.form</field>
        <field name="model">vpa.commission.pay.year.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay Commission">
                <sheet>
                    <group>
                        <group string="Commission Year">
                            <field name="scheme_year_id" readonly="1"/>
                            <field name="employee_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Year Status">
                            <field name="amount_due_year" widget="monetary"/>
                            <field name="amount_paid_cash" widget="monetary"/>
                            <field name="outstanding_cash" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Payment">
                        <group>
                            <field name="amount" widget="monetary"/>
                            <field name="payment_currency_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="payment_amount" widget="monetary"
                                   invisible="payment_currency_id == currency_id"/>
                            <field name="rate_info" invisible="not rate_info"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="payment_date"/>
                            <field name="memo"/>
                            <field name="advance_payment"/>
                            <field name="create_transaction"/>
                            <field name="payment_difference" widget="monetary"
                                   invisible="payment_difference &lt; 0.01 and payment_difference &gt; -0.01"/>
                            <field name="writeoff_difference"
                                   invisible="payment_difference &lt; 0.01 and payment_difference &gt; -0.01"/>
                            <field name="writeoff_account_id"
                                   invisible="not writeoff_difference"
                                   required="writeoff_difference"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status"
                         invisible="payment_currency_id == currency_id">
                        Paying in a different currency: the payment is created for the
                        <strong>Payment Amount</strong> in the selected currency, converted at the
                        rate shown. The year's Paid figure converts it back at the payment date.
                    </div>
                </sheet>
                <footer>
                    <button name="action_pay" string="Create Payment" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Dedicated payment list for Commission Payments (with the year column) -->
    <record id="view_account_payment_list_commission" model="ir.ui.view">
        <field name="name">account.payment.list.commission</field>
        <field name="model">account.payment</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Native "New" is used (create allowed). The opening action pins
                 the commission employee form + context defaults, so New creates
                 a pre-typed outbound payment on account AND keeps the standard
                 "Commission Payments" breadcrumb. -->
            <list string="Commission Payments">
                <field name="date"/>
                <field name="name"/>
                <field name="commission_year_id" string="Commission Year"/>
                <field name="partner_id" string="Employee"/>
                <field name="journal_id"/>
                <field name="memo" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'in_process'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state in ('canceled', 'rejected')"/>
            </list>
        </field>
    </record>

    <!-- Add Commission Year link on the payment form (for Payment on Account linking) -->
    <record id="view_account_payment_form_commission" model="ir.ui.view">
        <field name="name">account.payment.form.commission.year</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="memo" position="after">
                <!-- "Commission Year" links the WHOLE payment to one year. Hidden
                     on the on-account flow (opened from "New Payment on Account"),
                     which is meant to be split via the allocations table below —
                     unless a year is already set. -->
                <field name="commission_year_id"
                       invisible="payment_type != 'outbound' or (context.get('commission_payment_lock_type') and not commission_year_id)"
                       groups="vpa_sales_commission.group_commission_manager"/>
            </field>
            <!-- Commission payments are always outbound: lock Send/Receive
                 when the form was opened from the commission "New Payment"
                 button, or once the payment is tied to a commission year. -->
            <!-- Tests commission_has_allocations, NOT commission_allocation_ids:
                 this readonly sits on the standard payment_type field that every
                 user sees, and the client fetches whatever a modifier names.
                 Naming the allocation o2m here raised AccessError for every user
                 without commission rights - no amount of sudo in Python can help,
                 because the client is doing the read. -->
            <field name="payment_type" position="attributes">
                <attribute name="readonly">context.get('commission_payment_lock_type') or commission_year_id or commission_has_allocations</attribute>
            </field>
            <field name="payment_type" position="before">
                <field name="commission_has_allocations" invisible="1"/>
            </field>
            <!-- On the commission flow (opened from the commission "New Payment"
                 button), restrict the Vendor field to work-contacts of employees
                 who have a commission scheme. The domain only bites when the
                 lock-context flag is set, so normal payment forms are untouched. -->
            <xpath expr="//field[@name='partner_id'][@invisible=&quot;partner_type != 'supplier'&quot;]" position="attributes">
                <attribute name="domain">context.get('commission_payment_lock_type') and [('id', 'in', commission_employee_partner_ids)] or []</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id'][@invisible=&quot;partner_type != 'supplier'&quot;]" position="before">
                <field name="commission_employee_partner_ids" invisible="1"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <!-- Split a payment on account across commission years.
                     Subview embedded INLINE (view_id on x2many is not supported). -->
                <group string="Commission Allocations"
                       invisible="payment_type != 'outbound' or commission_year_id"
                       groups="vpa_sales_commission.group_commission_manager">
                    <group>
                        <field name="commission_allocated_amount" widget="monetary"/>
                        <field name="commission_unallocated_amount" widget="monetary"
                               class="fw-bold"/>
                    </group>
                    <field name="commission_allocation_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="scheme_year_id"/>
                            <field name="employee_id"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount" widget="monetary" sum="Total"/>
                        </list>
                    </field>
                </group>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="%(action_report_commission_payment_voucher)d"
                        string="Print Voucher" type="action" icon="fa-print"
                        invisible="not commission_is_payment"
                        groups="vpa_sales_commission.group_commission_manager"/>
                <!-- Mirror the payment into the journal's transaction list so it
                     can be reconciled — same as the Pay-Year wizard does. Shows
                     for cash-journal commission payments without a transaction. -->
                <button name="action_add_journal_transaction" type="object"
                        string="Add to Journal Transactions" icon="fa-exchange"
                        invisible="not commission_show_add_transaction"
                        groups="vpa_sales_commission.group_commission_manager"/>
                <field name="commission_is_payment" invisible="1"/>
                <field name="commission_show_add_transaction" invisible="1"/>
                <field name="commission_has_journal_transaction" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Primary form used ONLY by the commission "New Payment on Account"
         action: relabels the supplier partner field to "Employee". Normal
         payment forms keep saying "Vendor". The extension view above still
         applies (commission year, allocations, lock), because extensions apply
         to every view derived from the base form, including this primary one. -->
    <record id="view_account_payment_form_commission_employee" model="ir.ui.view">
        <field name="name">account.payment.form.commission.employee</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="mode">primary</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id'][@invisible=&quot;partner_type != 'supplier'&quot;]" position="attributes">
                <attribute name="string">Employee</attribute>
            </xpath>
        </field>
    </record>

</odoo>
