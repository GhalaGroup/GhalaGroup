<odoo>

    <record id="commission_apply_payment_wizard_form" model="ir.ui.view">
        <field name="name">vpa.commission.apply.payment.wizard.form</field>
        <field name="model">vpa.commission.apply.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Payments — Allocate &amp; Revert">
                <sheet>
                    <group>
                        <group string="Commission Year">
                            <field name="scheme_year_id"/>
                            <field name="employee_id"/>
                            <field name="outstanding_cash" widget="monetary"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="After Applying">
                            <field name="total_to_apply" widget="monetary" class="fw-bold"/>
                            <field name="outstanding_after" widget="monetary"
                                   decoration-danger="outstanding_after &gt; 0"
                                   decoration-success="outstanding_after &lt;= 0"/>
                        </group>
                    </group>

                    <separator string="Applied to this year — click Revert to pull a payment back on account"
                               invisible="not applied_line_ids"/>
                    <field name="applied_line_ids" nolabel="1"
                           invisible="not applied_line_ids">
                        <list editable="bottom" create="false" delete="false">
                            <!-- Instant revert: executes immediately and reopens
                                 the dialog fresh — the fastest path out. -->
                            <button name="action_revert_now" type="object"
                                    string="Revert" icon="fa-undo" class="text-danger"/>
                            <field name="payment_id" readonly="1" force_save="1"/>
                            <field name="date"/>
                            <field name="journal_id" optional="show"/>
                            <field name="memo" optional="hide"/>
                            <!-- force_save: these are readonly display fields, but
                                 their values ARRIVE via default_get and must be
                                 saved with the row — without force_save the client
                                 drops readonly values on save and the revert loses
                                 its allocation/kind target (silent no-op). -->
                            <field name="kind" force_save="1"/>
                            <field name="allocation_id" column_invisible="1" force_save="1"/>
                            <field name="payment_currency_id" column_invisible="1"/>
                            <field name="amount_applied" widget="monetary" force_save="1"
                                   string="Applied"
                                   options="{'currency_field': 'payment_currency_id'}"/>
                        </list>
                    </field>

                    <separator string="On account — tick the ones to apply"/>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="false" delete="false"
                              decoration-muted="not select">
                            <!-- Plain checkbox, NOT boolean_toggle: the toggle
                                 widget writes the value directly and skips the
                                 row's onchange round-trip in dialogs, so the
                                 amount prefill and the wizard totals never ran. -->
                            <field name="select"/>
                            <field name="payment_id" readonly="1" force_save="1"/>
                            <field name="date"/>
                            <field name="journal_id" optional="show"/>
                            <!-- Memo hidden by default: it crowded the amount
                                 columns into truncation; still one click away
                                 via the column selector. -->
                            <field name="memo" optional="hide"/>
                            <field name="partner_id" optional="hide"/>
                            <field name="payment_currency_id" column_invisible="1"/>
                            <field name="payment_amount" widget="monetary"
                                   string="Total"
                                   options="{'currency_field': 'payment_currency_id'}"/>
                            <field name="unallocated_amount" widget="monetary"
                                   string="Unallocated"
                                   options="{'currency_field': 'payment_currency_id'}"/>
                            <!-- Split payments: Total 10,000 / Unallocated 858.95
                                 begs "where is the rest?" — this column answers
                                 (e.g. "2024: TZS 26,051,992.50"). -->
                            <field name="allocated_years" string="Allocated To"
                                   optional="show"/>
                            <field name="amount_to_apply" widget="monetary"
                                   string="To Apply"
                                   options="{'currency_field': 'payment_currency_id'}"
                                   class="fw-bold"/>
                        </list>
                    </field>
                    <div class="alert alert-info mt-3" role="status">
                        Ticking an on-account row prefills <strong>what the year still needs</strong>
                        (never more — type a bigger amount deliberately for an advance).
                        A payment can be applied <strong>partially</strong>; the remainder stays
                        <strong>on account</strong>. Reverted payments return on account and are
                        logged in the year's history.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" string="Apply Changes" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
