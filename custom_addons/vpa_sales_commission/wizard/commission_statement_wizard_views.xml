<odoo>

    <!-- Commission Statement Wizard Form -->
    <record id="vpa_commission_statement_wizard_view_form" model="ir.ui.view">
        <field name="name">vpa.commission.statement.wizard.form</field>
        <field name="model">vpa.commission.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Commission Statement">
                <group>
                    <!-- company_id feeds the employee domain (scheme in company) -->
                    <field name="company_id" invisible="1"/>
                    <field name="employee_id"/>
                    <field name="year"/>
                    <field name="month"/>
                    <field name="include_pending"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_print_statement" string="Preview Statement"
                            type="object" class="btn-primary" icon="fa-eye"/>
                    <button name="action_pdf_statement" string="PDF Statement"
                            type="object" class="btn-secondary" icon="fa-file-pdf-o"/>
                    <button name="action_print_by_so" string="Preview by SO"
                            type="object" class="btn-primary" icon="fa-eye"/>
                    <button name="action_pdf_by_so" string="PDF by SO"
                            type="object" class="btn-secondary" icon="fa-file-pdf-o"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Commission Statement Wizard Action -->
    <record id="action_commission_statement_wizard" model="ir.actions.act_window">
        <field name="name">Commission Statement</field>
        <field name="res_model">vpa.commission.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="vpa_commission_statement_wizard_view_form"/>
        <field name="target">new</field>
    </record>

</odoo>
