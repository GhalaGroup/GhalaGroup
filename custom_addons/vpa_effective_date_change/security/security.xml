<odoo>
    <!-- Privilege definition - creates the section in user form Access Rights tab -->
    <record model="res.groups.privilege" id="res_groups_privilege_effective_date">
        <field name="name">Effective Date Change</field>
        <field name="sequence">26</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>

    <!-- Effective Date Change Group - Can change effective dates -->
    <record model="res.groups" id="vpa_effective_date_change_group">
        <field name="name">Change Effective Date</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_effective_date"/>
        <field name="comment">Users in this group can change effective dates of validated stock transfers and manufacturing orders.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>