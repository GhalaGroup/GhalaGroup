<odoo>
    <data>
        <!-- Add Effective Date field to MO form (before validation) -->
        <record model="ir.ui.view" id="mrp_production_effective_date">
            <field name="name">mrp.production.effective.date</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='group_extra_info']/field[@name='user_id']" position="after">
                    <field name="date_of_completion" invisible="state == 'done'"/>
                </xpath>
            </field>
        </record>

        <!-- Show Completion Date on done MOs -->
        <record model="ir.ui.view" id="mrp_production_show_date_finished">
            <field name="name">mrp.production.show.date.finished</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='group_extra_info']" position="inside">
                    <field name="date_finished" string="Completion Date"
                           readonly="1"
                           invisible="state != 'done'"/>
                </xpath>
            </field>
        </record>

        <!-- Add Change Effective Date button (after validation) -->
        <record model="ir.ui.view" id="mrp_production_effective_date_button">
            <field name="name">mrp.production.effective.date.button</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_cancel']" position="after">
                    <button name="wiz_open_mo"
                            groups="vpa_effective_date_change.vpa_effective_date_change_group"
                            type="object"
                            string="Change Completion Date"
                            invisible="state != 'done'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
