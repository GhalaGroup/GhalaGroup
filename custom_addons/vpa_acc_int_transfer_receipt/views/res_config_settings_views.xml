<odoo>
    <!-- Extend the VPA Internal Transfer settings block -->
    <record id="res_config_settings_view_form_inherit_receipt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.receipt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="vpa_acc_int_transfer.res_config_settings_view_form_inherit_internal_transfer"/>
        <field name="arch" type="xml">
            <!-- Add Receipt Confirmation settings inside the block -->
            <xpath expr="//block[@name='vpa_internal_transfer_settings']" position="inside">
                <setting string="Receipt Confirmation"
                         help="Require custodians to confirm receipt before creating journal entries">
                    <div class="content-group">
                        <div class="row mt16">
                            <field name="enable_receipt_confirmation" class="oe_inline"/>
                            <label for="enable_receipt_confirmation" string="Enable Receipt Confirmation"/>
                        </div>
                        <div class="text-muted mt8">
                            When enabled, transfers require custodian confirmation after approval.
                            Journal entries are only created after the custodian confirms receipt.
                        </div>
                    </div>
                </setting>
                <setting string="Journal Custodians"
                         help="Assign custodians to bank and cash journals"
                         invisible="not enable_receipt_confirmation">
                    <div class="content-group">
                        <div class="mt8">
                            <button name="%(journal_custodian_action)d"
                                    string="Configure Custodians"
                                    type="action"
                                    class="btn-link"
                                    icon="fa-arrow-right"/>
                        </div>
                        <div class="text-muted mt8">
                            Custodians are responsible for confirming receipt of funds.
                            Each journal can have primary custodians and backup managers.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
