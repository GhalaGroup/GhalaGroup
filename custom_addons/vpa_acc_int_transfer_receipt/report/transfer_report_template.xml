<odoo>
    <!-- Inherit and extend the report template -->
    <template id="report_internal_transfer_receipt" inherit_id="vpa_acc_int_transfer.report_internal_transfer">

        <!-- Add new state badges - append to existing badges -->
        <xpath expr="//span[@class='badge text-bg-secondary']" position="after">
            <span t-if="doc.state == 'pending_receipt'" class="badge text-bg-info">Pending Receipt</span>
            <span t-if="doc.state == 'received'" class="badge text-bg-success">Received</span>
            <span t-if="doc.state == 'disputed'" class="badge text-bg-danger">Disputed</span>
        </xpath>

        <!-- Add Receipt/Dispute sections after Journal Entries table, before signature -->
        <xpath expr="//div[@class='row mt-2']" position="before">
            <!-- Receipt Confirmation Section - Only if received -->
            <t t-if="doc.received_by_id">
                <table class="table table-sm table-bordered" style="margin-bottom: 8px;">
                    <thead>
                        <tr>
                            <th colspan="4" class="text-center" style="background-color: #17a2b8; color: white; padding: 4px;">
                                Receipt Confirmation
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="width: 20%; background-color: #f8f9fa;"><strong>Received By:</strong></td>
                            <td style="width: 30%;"><span t-field="doc.received_by_id.name"/></td>
                            <td style="width: 20%; background-color: #f8f9fa;"><strong>Receipt Date:</strong></td>
                            <td style="width: 30%;"><span t-field="doc.receipt_date" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></td>
                        </tr>
                        <tr>
                            <td style="background-color: #f8f9fa;"><strong>Amount Received:</strong></td>
                            <td>
                                <strong>
                                    <span t-field="doc.received_amount" t-options='{"widget": "monetary", "display_currency": doc.destination_currency_id if doc.is_multi_currency else doc.currency_id}'/>
                                </strong>
                            </td>
                            <td style="background-color: #f8f9fa;"><strong>Notes:</strong></td>
                            <td><span t-field="doc.receipt_notes"/></td>
                        </tr>
                    </tbody>
                </table>
            </t>

            <!-- Reassignment Section - Only if reassigned -->
            <t t-if="doc.reassigned_by_id">
                <table class="table table-sm table-bordered" style="margin-bottom: 8px;">
                    <thead>
                        <tr>
                            <th colspan="4" class="text-center" style="background-color: #6c757d; color: white; padding: 4px;">
                                Reassignment History
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="width: 20%; background-color: #f8f9fa;"><strong>Reassigned By:</strong></td>
                            <td style="width: 30%;"><span t-field="doc.reassigned_by_id.name"/></td>
                            <td style="width: 20%; background-color: #f8f9fa;"><strong>Reassignment Date:</strong></td>
                            <td style="width: 30%;"><span t-field="doc.reassignment_date" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></td>
                        </tr>
                    </tbody>
                </table>
            </t>

            <!-- Dispute Section - Only if disputed -->
            <t t-if="doc.dispute_raised_by_id">
                <table class="table table-sm table-bordered" style="margin-bottom: 8px;">
                    <thead>
                        <tr>
                            <th colspan="4" class="text-center" style="background-color: #dc3545; color: white; padding: 4px;">
                                Dispute Details
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="width: 20%; background-color: #f8f9fa;"><strong>Raised By:</strong></td>
                            <td style="width: 30%;"><span t-field="doc.dispute_raised_by_id.name"/></td>
                            <td style="width: 20%; background-color: #f8f9fa;"><strong>Dispute Date:</strong></td>
                            <td style="width: 30%;"><span t-field="doc.dispute_date" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></td>
                        </tr>
                        <tr>
                            <td style="background-color: #f8f9fa;"><strong>Reason:</strong></td>
                            <td><span t-field="doc.dispute_reason"/></td>
                            <td style="background-color: #f8f9fa;"><strong>Details:</strong></td>
                            <td><span t-field="doc.dispute_notes"/></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Dispute Resolution - Only if resolved -->
                <t t-if="doc.dispute_resolved_by_id">
                    <table class="table table-sm table-bordered" style="margin-bottom: 8px;">
                        <thead>
                            <tr>
                                <th colspan="4" class="text-center" style="background-color: #28a745; color: white; padding: 4px;">
                                    Dispute Resolution
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="width: 20%; background-color: #f8f9fa;"><strong>Resolved By:</strong></td>
                                <td style="width: 30%;"><span t-field="doc.dispute_resolved_by_id.name"/></td>
                                <td style="width: 20%; background-color: #f8f9fa;"><strong>Resolution Date:</strong></td>
                                <td style="width: 30%;"><span t-field="doc.dispute_resolution_date" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></td>
                            </tr>
                            <tr>
                                <td style="background-color: #f8f9fa;"><strong>Resolution:</strong></td>
                                <td><span t-field="doc.dispute_resolution"/></td>
                                <td style="background-color: #f8f9fa;"><strong>Notes:</strong></td>
                                <td><span t-field="doc.dispute_resolution_notes"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </t>

            <!-- Dynamic Signatures -->
            <div class="row mt-3">
                <!-- Prepared By - Always shown -->
                <div class="col-3 text-center">
                    <div style="border-top: 1px solid #333; width: 90%; margin: 0 auto; padding-top: 3px;">
                        <strong style="font-size: 10px;">Prepared By</strong>
                    </div>
                    <div style="height: 30px;"></div>
                    <t t-if="doc.create_uid">
                        <div style="font-size: 9px;"><span t-field="doc.create_uid.name"/></div>
                        <div style="font-size: 9px;"><span t-field="doc.create_date" t-options='{"format": "dd/MM/yy"}'/></div>
                    </t>
                    <t t-else="">
                        <div style="font-size: 9px;">Name: ________________</div>
                        <div style="font-size: 9px;">Date: ________________</div>
                    </t>
                </div>

                <!-- Approved By - Show approver info if approved -->
                <div class="col-3 text-center">
                    <div style="border-top: 1px solid #333; width: 90%; margin: 0 auto; padding-top: 3px;">
                        <strong style="font-size: 10px;">Approved By</strong>
                    </div>
                    <div style="height: 30px;"></div>
                    <t t-if="doc.approved_by_id">
                        <div style="font-size: 9px;"><span t-field="doc.approved_by_id.name"/></div>
                        <div style="font-size: 9px;"><span t-field="doc.approval_date" t-options='{"format": "dd/MM/yy"}'/></div>
                    </t>
                    <t t-else="">
                        <div style="font-size: 9px;">Name: ________________</div>
                        <div style="font-size: 9px;">Date: ________________</div>
                    </t>
                </div>

                <!-- Received By - Show receiver info if received -->
                <div class="col-3 text-center">
                    <div style="border-top: 1px solid #333; width: 90%; margin: 0 auto; padding-top: 3px;">
                        <strong style="font-size: 10px;">Received By</strong>
                    </div>
                    <div style="height: 30px;"></div>
                    <t t-if="doc.received_by_id">
                        <div style="font-size: 9px;"><span t-field="doc.received_by_id.name"/></div>
                        <div style="font-size: 9px;"><span t-field="doc.receipt_date" t-options='{"format": "dd/MM/yy"}'/></div>
                    </t>
                    <t t-else="">
                        <div style="font-size: 9px;">Name: ________________</div>
                        <div style="font-size: 9px;">Date: ________________</div>
                    </t>
                </div>

                <!-- Verified/Acknowledged By -->
                <div class="col-3 text-center">
                    <div style="border-top: 1px solid #333; width: 90%; margin: 0 auto; padding-top: 3px;">
                        <strong style="font-size: 10px;">Acknowledged By</strong>
                    </div>
                    <div style="height: 30px;"></div>
                    <div style="font-size: 9px;">Name: ________________</div>
                    <div style="font-size: 9px;">Date: ________________</div>
                </div>
            </div>
        </xpath>

        <!-- Remove original signature section -->
        <xpath expr="//div[@class='col-4 text-center'][.//strong[text()='Prepared By']]/.." position="replace">
            <!-- Replaced by dynamic signatures above -->
        </xpath>

    </template>
</odoo>
