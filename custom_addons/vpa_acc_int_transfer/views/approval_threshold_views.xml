<odoo>
    <!-- Form View -->
    <record id="internal_transfer_threshold_view_form" model="ir.ui.view">
        <field name="name">internal.transfer.threshold.view.form</field>
        <field name="model">internal.transfer.threshold</field>
        <field name="arch" type="xml">
            <form string="Approval Threshold">
                <sheet>
                    <group>
                        <group string="Threshold Details">
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Amount Range">
                            <field name="min_amount"/>
                            <field name="max_amount" placeholder="0 = Unlimited"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Approval">
                            <field name="approval_level" widget="radio"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Optional notes about this threshold..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="internal_transfer_threshold_view_list" model="ir.ui.view">
        <field name="name">internal.transfer.threshold.view.list</field>
        <field name="model">internal.transfer.threshold</field>
        <field name="arch" type="xml">
            <list string="Approval Thresholds">
                <field name="name"/>
                <field name="min_amount"/>
                <field name="max_amount"/>
                <field name="currency_id"/>
                <field name="approval_level" widget="badge"
                       decoration-info="approval_level == 'manager'"
                       decoration-warning="approval_level == 'admin'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="internal_transfer_threshold_view_search" model="ir.ui.view">
        <field name="name">internal.transfer.threshold.view.search</field>
        <field name="model">internal.transfer.threshold</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="approval_threshold_action" model="ir.actions.act_window">
        <field name="name">Approval Thresholds</field>
        <field name="res_model">internal.transfer.threshold</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="internal_transfer_threshold_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure approval thresholds
            </p>
            <p>
                Define amount ranges and the required approval level for each range.
                For example: Transfers up to 10,000 require Manager approval,
                while transfers above 10,000 require Administrator approval.
            </p>
        </field>
    </record>
</odoo>
