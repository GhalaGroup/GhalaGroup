<odoo>
    <!-- Internal Transfers Menu under Accounting > Accounting > Transactions -->
    <!-- In Odoo 19: menu_finance_entries contains account_transactions_menu -->
    <menuitem id="menu_internal_transfer_main"
              name="Internal Transfers"
              action="internal_transfer_action"
              parent="account.account_transactions_menu"
              sequence="50"/>

    <!-- Remove old menu items that are now in Settings -->
    <delete model="ir.ui.menu" search="[('id', '=', ref('menu_approval_thresholds'))]"/>
    <delete model="ir.ui.menu" search="[('id', '=', ref('menu_transfer_backups'))]"/>
</odoo>
