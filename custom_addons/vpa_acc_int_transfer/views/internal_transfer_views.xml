<odoo>
    <!-- Form View -->
    <record id="internal_transfer_view_form" model="ir.ui.view">
        <field name="name">internal.transfer.view.form</field>
        <field name="model">internal.transfer</field>
        <field name="arch" type="xml">
            <form string="Internal Transfer" class="o_form_view">
                <header>
                    <button name="action_submit" string="Submit for Approval"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="account.group_account_manager"/>
                    <button name="action_reject" string="Reject"
                            type="object" class="btn-secondary"
                            invisible="state != 'submitted'"
                            groups="account.group_account_manager"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" class="btn-secondary"
                            invisible="state in ('cancelled', 'rejected', 'draft') or is_locked"
                            groups="account.group_account_manager"/>
                    <button name="action_lock" string="Lock"
                            type="object" class="btn-secondary"
                            invisible="state != 'approved' or is_locked"
                            groups="account.group_account_manager"/>
                    <button name="action_unlock" string="Unlock"
                            type="object" class="btn-secondary"
                            invisible="state != 'approved' or not is_locked"
                            groups="account.group_account_manager"/>
                    <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object" class="btn-secondary"
                            invisible="state in ('draft', 'approved')"
                            groups="account.group_account_manager"/>
                    <button name="%(action_report_internal_transfer)d" string="Print"
                            type="action" class="btn-secondary"/>
                    <field name="is_locked" invisible="1"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal_entries"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Journal Entries"/>
                        </button>
                        <button name="action_view_attachments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Approved"
                            bg_color="text-bg-success"
                            invisible="state != 'approved' or is_locked"/>
                    <widget name="web_ribbon" title="Locked"
                            bg_color="text-bg-warning"
                            invisible="not is_locked"/>
                    <widget name="web_ribbon" title="Rejected"
                            bg_color="text-bg-danger"
                            invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled"
                            bg_color="text-bg-secondary"
                            invisible="state != 'cancelled'"/>
                    <div class="oe_title mb-3">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1" placeholder="New"/>
                        </h1>
                    </div>
                    <group col="2">
                        <group string="Transfer Details">
                            <field name="date" readonly="state == 'approved'"/>
                            <field name="company_id" invisible="1"/>
                            <field name="approver_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="memo_type" readonly="state == 'approved'"/>
                            <field name="memo" placeholder="Auto-generated memo..."
                                   readonly="memo_type != 'custom' or state == 'approved'"/>
                        </group>
                        <group string="Amount">
                            <field name="amount" readonly="state == 'approved'"/>
                            <field name="currency_id" readonly="state == 'approved'"/>
                            <field name="is_multi_currency" invisible="1"/>
                            <field name="destination_currency_id" invisible="not is_multi_currency"/>
                            <field name="exchange_rate" string="Rate (Source→Dest)" invisible="not is_multi_currency" readonly="state == 'approved'"/>
                            <field name="exchange_rate_inverse" string="Rate (Dest→Source)" invisible="not is_multi_currency" readonly="state == 'approved'"/>
                            <field name="destination_amount" invisible="not is_multi_currency" readonly="state == 'approved'"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="From (Source)">
                            <field name="source_journal_id" options="{'no_create': True}" readonly="state == 'approved'"/>
                            <field name="source_account_id" readonly="1"/>
                        </group>
                        <group string="To (Destination)">
                            <field name="destination_journal_id" options="{'no_create': True}" readonly="state == 'approved'"/>
                            <field name="destination_account_id" readonly="1"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Intermediate Account">
                            <field name="transfer_account_id" options="{'no_create': True}" readonly="state == 'approved'"/>
                        </group>
                        <group string="Approval Information" invisible="state == 'draft'">
                            <field name="required_approval_level" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..." nolabel="1" readonly="state == 'approved'"/>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary" nolabel="1" readonly="state == 'approved'"/>
                        </page>
                        <page string="Audit Trail" name="audit" invisible="state == 'draft'">
                            <group col="2">
                                <group string="Submission" invisible="not submitted_by_id">
                                    <field name="submitted_by_id"/>
                                    <field name="submit_date"/>
                                </group>
                                <group string="Approval" invisible="not approved_by_id">
                                    <field name="approved_by_id"/>
                                    <field name="approval_date"/>
                                </group>
                            </group>
                            <group col="2" invisible="state not in ('approved', 'cancelled')">
                                <group string="Bank Transactions" invisible="not source_statement_line_id">
                                    <field name="source_statement_line_id"/>
                                    <field name="destination_statement_line_id"/>
                                </group>
                                <group string="Journal Entries" invisible="not source_move_id">
                                    <field name="source_move_id"/>
                                    <field name="destination_move_id"/>
                                </group>
                            </group>
                            <group col="2" invisible="state != 'rejected'" string="Rejection Details">
                                <group>
                                    <field name="rejected_by_id"/>
                                    <field name="rejection_date"/>
                                </group>
                                <group>
                                    <field name="rejection_reason"/>
                                </group>
                            </group>
                            <group col="2" invisible="state != 'cancelled'" string="Cancellation Details">
                                <group>
                                    <field name="cancelled_by_id"/>
                                    <field name="cancellation_date"/>
                                </group>
                                <group>
                                    <field name="cancellation_reason"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="internal_transfer_view_list" model="ir.ui.view">
        <field name="name">internal.transfer.view.list</field>
        <field name="model">internal.transfer</field>
        <field name="arch" type="xml">
            <list string="Internal Transfers"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="source_journal_id"/>
                <field name="destination_journal_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id"/>
                <field name="memo" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <field name="submitted_by_id" optional="hide"/>
                <field name="approved_by_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="internal_transfer_view_kanban" model="ir.ui.view">
        <field name="name">internal.transfer.view.kanban</field>
        <field name="model">internal.transfer</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="source_journal_id"/>
                <field name="destination_journal_id"/>
                <field name="memo"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="state" widget="badge"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <strong>
                                            <field name="amount" widget="monetary"/>
                                            <field name="currency_id"/>
                                        </strong>
                                    </div>
                                    <div><field name="date"/></div>
                                    <div class="text-muted">
                                        <field name="source_journal_id"/> → <field name="destination_journal_id"/>
                                    </div>
                                    <div t-if="record.memo.raw_value" class="text-muted">
                                        <i class="fa fa-comment-o" title="Memo"/> <field name="memo"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="internal_transfer_view_search" model="ir.ui.view">
        <field name="name">internal.transfer.view.search</field>
        <field name="model">internal.transfer</field>
        <field name="arch" type="xml">
            <search string="Search Internal Transfers">
                <field name="name"/>
                <field name="memo"/>
                <field name="source_journal_id"/>
                <field name="destination_journal_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Locked" name="filter_locked" domain="[('is_locked', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="groupby_date" context="{'group_by': 'date:month'}"/>
                    <filter string="Source Journal" name="groupby_source" context="{'group_by': 'source_journal_id'}"/>
                    <filter string="Destination Journal" name="groupby_destination" context="{'group_by': 'destination_journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="internal_transfer_action" model="ir.actions.act_window">
        <field name="name">Internal Transfers</field>
        <field name="res_model">internal.transfer</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="internal_transfer_view_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first internal transfer
            </p>
            <p>
                Transfer funds between your bank and cash accounts with full approval workflow and audit trail.
            </p>
        </field>
    </record>

    <record id="internal_transfer_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="internal_transfer_view_list"/>
        <field name="act_window_id" ref="internal_transfer_action"/>
    </record>

    <record id="internal_transfer_action_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="internal_transfer_view_kanban"/>
        <field name="act_window_id" ref="internal_transfer_action"/>
    </record>

    <record id="internal_transfer_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="internal_transfer_view_form"/>
        <field name="act_window_id" ref="internal_transfer_action"/>
    </record>

    <record id="internal_transfer_action_pending" model="ir.actions.act_window">
        <field name="name">Pending Approvals</field>
        <field name="res_model">internal.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="internal_transfer_view_list"/>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No transfers pending approval
            </p>
        </field>
    </record>

    <record id="internal_transfer_action_rejected" model="ir.actions.act_window">
        <field name="name">Rejected Transfers</field>
        <field name="res_model">internal.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="internal_transfer_view_list"/>
        <field name="domain">[('state', '=', 'rejected')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No rejected transfers
            </p>
        </field>
    </record>

    <record id="internal_transfer_action_approved" model="ir.actions.act_window">
        <field name="name">Approved Transfers</field>
        <field name="res_model">internal.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="internal_transfer_view_list"/>
        <field name="domain">[('state', '=', 'approved')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No approved transfers yet
            </p>
        </field>
    </record>
</odoo>
