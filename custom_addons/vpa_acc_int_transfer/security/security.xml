<odoo>
    <!-- Security Groups -->
    <record id="group_transfer_user" model="res.groups">
        <field name="name">Internal Transfer / User</field>
        <field name="comment">Can create and submit internal transfers</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_transfer_manager" model="res.groups">
        <field name="name">Internal Transfer / Manager</field>
        <field name="comment">Can approve transfers up to configured threshold</field>
        <field name="implied_ids" eval="[(4, ref('group_transfer_user'))]"/>
    </record>

    <record id="group_transfer_admin" model="res.groups">
        <field name="name">Internal Transfer / Administrator</field>
        <field name="comment">Full access to all transfers and configuration</field>
        <field name="implied_ids" eval="[(4, ref('group_transfer_manager'))]"/>
    </record>

    <!-- Record Rules -->
    <!-- All users in transfer groups can read all transfers in their company -->
    <record id="internal_transfer_rule_read_all" model="ir.rule">
        <field name="name">Internal Transfer: Read All Company Transfers</field>
        <field name="model_id" ref="model_internal_transfer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_transfer_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Users can only write/create their own draft transfers -->
    <record id="internal_transfer_rule_user_write" model="ir.rule">
        <field name="name">Internal Transfer: User Write Own Drafts</field>
        <field name="model_id" ref="model_internal_transfer"/>
        <field name="domain_force">[
            ('company_id', 'in', company_ids),
            ('create_uid', '=', user.id),
            ('state', '=', 'draft')
        ]</field>
        <field name="groups" eval="[(4, ref('group_transfer_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Managers can write all transfers in their company -->
    <record id="internal_transfer_rule_manager_write" model="ir.rule">
        <field name="name">Internal Transfer: Manager Full Access</field>
        <field name="model_id" ref="model_internal_transfer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_transfer_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Admin can do everything including delete -->
    <record id="internal_transfer_rule_admin" model="ir.rule">
        <field name="name">Internal Transfer: Admin Full Access</field>
        <field name="model_id" ref="model_internal_transfer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_transfer_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Threshold Rules - Company-based -->
    <record id="internal_transfer_threshold_rule" model="ir.rule">
        <field name="name">Threshold: Company Rule</field>
        <field name="model_id" ref="model_internal_transfer_threshold"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
