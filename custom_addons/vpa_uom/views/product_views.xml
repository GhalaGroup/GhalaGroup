<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product Template Form View - Add Alternative UoM Tab -->
    <record id="product_template_form_view_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">product.template.form.inherit.vpa.uom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add Alternative UoM tab after Inventory tab -->
            <xpath expr="//page[@name='inventory']" position="after">
                <page string="Alternative UoM" name="alternative_uom">
                    <group>
                        <group>
                            <field name="uom_id" readonly="1" string="Base UoM (Storage)"/>
                        </group>
                        <group>
                            <field name="primary_alt_uom_id" readonly="1" string="Primary Alt. UoM"/>
                        </group>
                    </group>
                    <separator string="Alternative Units of Measure"/>
                    <field name="uom_conversion_ids" context="{'default_product_tmpl_id': id, 'default_company_id': company_id}">
                        <tree string="Alternative UoMs" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="uom_id" options="{'no_create': True}" required="1"/>
                            <field name="alt_qty" required="1"/>
                            <field name="base_uom_id" column_invisible="1"/>
                            <field name="base_qty" required="1"/>
                            <field name="name" optional="show" placeholder="Description"/>
                            <field name="rounding" optional="hide"/>
                            <field name="company_id" groups="base.group_multi_company" optional="show"/>
                        </tree>
                    </field>
                    <div class="alert alert-info" role="alert">
                        <strong>How it works:</strong> Define alternative units with product-specific conversions.
                        <br/>Example: 1 Board = 2.9768 m² means this specific product's board is 2.9768 m².
                        <br/>The first alternative UoM in the list is used for display in inventory views.
                    </div>
                </page>
            </xpath>

            <!-- Add smart button for Alternative UoMs -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_uom_conversions" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        invisible="uom_conversion_count == 0">
                    <field name="uom_conversion_count" widget="statinfo" string="Alt. UoMs"/>
                </button>
            </xpath>

            <!-- Enhance On Hand smart button to show alternative UoM -->
            <xpath expr="//button[@name='action_open_quants']//field[@name='qty_available']" position="after">
                <br/>
                <span class="text-muted small" invisible="not qty_available_alt_str">
                    <field name="qty_available_alt_str" readonly="1"/>
                </span>
            </xpath>
        </field>
    </record>

    <!-- Product Template Tree View - Add Alternative Qty Column -->
    <record id="product_template_tree_view_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.vpa.uom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <!-- Add Alt. Qty column after On Hand -->
            <xpath expr="//field[@name='qty_available']" position="after">
                <field name="qty_available_alt_str" string="Alt. Qty" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Product Template Kanban View - Add Alternative Qty Display -->
    <record id="product_template_kanban_view_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">product.template.kanban.inherit.vpa.uom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <!-- Add alternative qty display in kanban card -->
            <xpath expr="//field[@name='qty_available']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='qty_available']" position="after">
                <field name="qty_available_alt_str" invisible="1"/>
                <field name="primary_alt_uom_id" invisible="1"/>
            </xpath>
            <!-- Modify the qty_available display to include alt UoM -->
            <xpath expr="//div[hasclass('oe_kanban_details')]//div[hasclass('o_product_item')][1]" position="replace">
                <div class="o_product_item">
                    <span>On Hand: </span>
                    <field name="qty_available"/>
                    <field name="uom_id" groups="uom.group_uom"/>
                </div>
                <div class="o_product_item text-muted small" t-if="record.qty_available_alt_str.raw_value">
                    <field name="qty_available_alt_str"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Product Product Form View - Inherit for variants -->
    <record id="product_product_form_view_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">product.product.form.inherit.vpa.uom</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- Enhance On Hand display to show alternative UoM -->
            <xpath expr="//button[@name='action_open_quants']//field[@name='qty_available']" position="after">
                <br/>
                <span class="text-muted small" invisible="not qty_available_alt_str">
                    <field name="qty_available_alt_str" readonly="1"/>
                </span>
            </xpath>
        </field>
    </record>

    <!-- Product Product Tree View - Add Alternative Qty Column -->
    <record id="product_product_tree_view_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">product.product.tree.inherit.vpa.uom</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <!-- Add Alt. Qty column after On Hand -->
            <xpath expr="//field[@name='qty_available']" position="after">
                <field name="qty_available_alt_str" string="Alt. Qty" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Sale Order Line - Show allowed UoMs and base qty -->
    <record id="sale_order_line_view_form_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">sale.order.line.form.inherit.vpa.uom</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_uom_ids)]</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="before">
                <field name="allowed_uom_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="qty_base_uom_str" readonly="1" string="" class="text-muted"
                       invisible="not qty_base_uom_str"/>
            </xpath>
        </field>
    </record>

    <!-- Sale Order Form - Show stock impact in order lines -->
    <record id="sale_order_view_form_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.vpa.uom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_uom_id']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_uom_ids)]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_uom_id']" position="before">
                <field name="allowed_uom_ids" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_uom_qty']" position="after">
                <field name="qty_base_uom_str" string="Stock Impact" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order Form - Show stock impact in order lines -->
    <record id="purchase_order_view_form_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.vpa.uom</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_uom_id']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_uom_ids)]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_uom_id']" position="before">
                <field name="allowed_uom_ids" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_qty']" position="after">
                <field name="qty_base_uom_str" string="Stock Impact" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
