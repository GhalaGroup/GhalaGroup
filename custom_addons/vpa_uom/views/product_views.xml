<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product Template Form View - Add Alternative UoM Tab -->
    <record id="product_template_form_view_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">product.template.form.inherit.vpa.uom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add Alternative UoM tab after General Info -->
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Alternative UoM" name="alternative_uom">
                    <group>
                        <group>
                            <field name="uom_id" readonly="1" string="Base UoM (Storage)"/>
                        </group>
                        <group>
                            <field name="primary_alt_uom_id" readonly="1" string="Primary Alt. UoM"/>
                        </group>
                    </group>
                    <separator string="Alternative Units of Measure"/>
                    <field name="uom_conversion_ids" context="{'default_product_tmpl_id': id, 'default_company_id': company_id}">
                        <list string="Alternative UoMs" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="alt_qty" string="Qty" required="1"/>
                            <button string="x" class="btn btn-link p-0" disabled="1"/>
                            <field name="uom_id" string="Alternative UoM" required="1"
                                   options="{'no_create': False, 'no_quick_create': False, 'can_create': True}"/>
                            <button string="=" class="btn btn-link p-0" disabled="1"/>
                            <field name="base_qty" string="Base Qty" required="1" digits="[16, 4]"/>
                            <field name="base_uom_id" string="Base UoM" readonly="1"/>
                            <field name="name" string="Description" optional="show" placeholder="Description"/>
                            <field name="rounding" optional="hide"/>
                            <field name="company_id" groups="base.group_multi_company" optional="show"/>
                        </list>
                    </field>
                    <div class="alert alert-info" role="alert">
                        <strong>Product-Specific Conversion:</strong>
                        <br/>1. Select or create an Alternative UoM (e.g., "Board 800x2120")
                        <br/>2. Enter the exact Base Qty for THIS product (e.g., 1.6960 m²)
                        <br/>Note: Each product can have a different conversion factor for the same UoM.
                    </div>
                </page>
            </xpath>

            <!-- Add smart button for Alternative UoMs -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_uom_conversions" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        invisible="uom_conversion_count == 0">
                    <field name="uom_conversion_count" widget="statinfo" string="Alt. UoMs"/>
                </button>
            </xpath>

            <!-- Add Quantity On Hand in Alt. UoM after the regular qty_available -->
            <xpath expr="//field[@name='qty_available']" position="after">
                <field name="qty_available_alt_str" string="On Hand (Alt. UoM)"
                       invisible="not primary_alt_uom_id"/>
            </xpath>
        </field>
    </record>

    <!-- Product Template Kanban View - Add Alt. UoM Qty -->
    <record id="product_template_kanban_view_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">product.template.kanban.inherit.vpa.uom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']" position="after">
                <field name="qty_available_alt_str"/>
                <field name="primary_alt_uom_id"/>
            </xpath>
            <xpath expr="//div[hasclass('text-bg-info')]" position="after">
                <div t-if="record.qty_available_alt_str.raw_value" class="text-bg-secondary badge">
                    <t t-out="record.qty_available_alt_str.value"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
