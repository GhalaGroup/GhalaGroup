<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- UNITS OF MEASURE - Global UoM Management       -->
    <!-- Create UoMs here, then assign to products      -->
    <!-- ============================================== -->

    <!-- UoM List View -->
    <record id="uom_uom_view_list_vpa" model="ir.ui.view">
        <field name="name">uom.uom.view.list.vpa</field>
        <field name="model">uom.uom</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <list string="Units of Measure" editable="bottom">
                <field name="name" string="Unit Name"/>
                <field name="relative_factor" string="Quantity"/>
                <field name="relative_uom_id" string="Reference UoM"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- UoM Form View -->
    <record id="uom_uom_view_form_vpa" model="ir.ui.view">
        <field name="name">uom.uom.view.form.vpa</field>
        <field name="model">uom.uom</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form string="Unit of Measure">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g., Board 2440x1220"/></h1>
                    </div>
                    <group>
                        <group string="Conversion">
                            <label for="relative_factor" string="1 unit equals"/>
                            <div class="o_row">
                                <field name="relative_factor" class="oe_inline"/>
                                <field name="relative_uom_id" class="oe_inline" placeholder="Reference UoM (e.g., m²)"/>
                            </div>
                        </group>
                        <group string="Settings">
                            <field name="active"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>How to create a UoM:</strong>
                        <br/>1. Enter the unit name (e.g., "Board 2440x1220")
                        <br/>2. Enter how many of the reference unit equals 1 of this unit
                        <br/>3. Select the reference unit (e.g., m², kg, Units)
                        <br/>
                        <br/><strong>Example:</strong> Board 2440x1220 = 2.9768 m²
                        <br/>Name: Board 2440x1220, Quantity: 2.9768, Reference: m²
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- UoM Search View -->
    <record id="uom_uom_view_search_vpa" model="ir.ui.view">
        <field name="name">uom.uom.view.search.vpa</field>
        <field name="model">uom.uom</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <search string="Units of Measure">
                <field name="name"/>
                <field name="relative_uom_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- UoM Action -->
    <record id="action_uom_uom_vpa" model="ir.actions.act_window">
        <field name="name">Units of Measure</field>
        <field name="res_model">uom.uom</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('uom_uom_view_list_vpa')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('uom_uom_view_form_vpa')})]"/>
        <field name="search_view_id" ref="uom_uom_view_search_vpa"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Unit of Measure
            </p>
            <p>
                Define units like "Board 2440x1220" with their conversion to base units.
                <br/>Then assign these UoMs to products in the Alternative UoM tab.
            </p>
        </field>
    </record>

</odoo>
