<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stock Move List View - Override quantity for 4 decimals -->
    <record id="view_move_tree_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">stock.move.list.inherit.vpa.uom</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="attributes">
                <attribute name="digits">[16, 4]</attribute>
            </xpath>
        </field>
    </record>

    <!-- Stock Quant Simple List View - Add Alt. UoM Qty for Stock Report -->
    <record id="view_stock_quant_tree_simple_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">stock.quant.tree.simple.inherit.vpa.uom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <!-- Add Alt. UoM quantity after the main quantity field -->
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="qty_alt_uom" string="Alt. Qty" optional="show"
                       invisible="not primary_alt_uom_id"/>
                <field name="primary_alt_uom_id" string="Alt. UoM" optional="show"
                       invisible="not primary_alt_uom_id"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Quant Inventory Report List View - Add Alt. UoM Qty -->
    <record id="view_stock_quant_tree_inventory_editable_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">stock.quant.tree.inventory.inherit.vpa.uom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <!-- Add Alt. UoM quantity after the main quantity field -->
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="qty_alt_uom" string="Alt. On Hand" optional="show"
                       invisible="not primary_alt_uom_id" readonly="1"/>
                <field name="primary_alt_uom_id" string="Alt. UoM" optional="show"
                       invisible="not primary_alt_uom_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Quant Main Tree View - Add Alt. UoM Qty -->
    <record id="view_stock_quant_tree_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">stock.quant.tree.inherit.vpa.uom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <!-- Add Alt. UoM quantity after the main quantity field -->
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="qty_alt_uom" string="Alt. Qty" optional="show"
                       invisible="not primary_alt_uom_id"/>
                <field name="primary_alt_uom_id" string="Alt. UoM" optional="show"
                       invisible="not primary_alt_uom_id"/>
            </xpath>
        </field>
    </record>

</odoo>
