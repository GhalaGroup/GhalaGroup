<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stock Move List View - Override quantity for 4 decimals -->
    <record id="view_move_tree_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">stock.move.list.inherit.vpa.uom</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="attributes">
                <attribute name="digits">[16, 4]</attribute>
            </xpath>
        </field>
    </record>

    <!-- Stock Quant Simple List View - Add Alt. UoM Qty
         This is the base view that view_stock_quant_tree inherits from -->
    <record id="view_stock_quant_tree_simple_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">stock.quant.tree.simple.inherit.vpa.uom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <!-- Add Alt. UoM quantity after the main quantity field -->
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="qty_alt_uom" string="Alt. Qty" optional="show"/>
                <field name="primary_alt_uom_id" string="Alt. UoM" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Quant Editable List View (for managers) - Add Alt. UoM Qty
         This view uses inventory_quantity_auto_apply instead of quantity -->
    <record id="view_stock_quant_tree_editable_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.inherit.vpa.uom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <!-- Add Alt. UoM quantity after inventory_quantity_auto_apply (which shows On Hand) -->
            <xpath expr="//field[@name='inventory_quantity_auto_apply']" position="after">
                <field name="qty_alt_uom" string="Alt. Qty" optional="show" readonly="1"/>
                <field name="primary_alt_uom_id" string="Alt. UoM" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Quant Inventory Report List View (Physical Inventory) - Add Alt. UoM Qty
         This standalone view has the quantity field -->
    <record id="view_stock_quant_tree_inventory_editable_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">stock.quant.tree.inventory.inherit.vpa.uom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <!-- Add Alt. UoM quantity after the main quantity field -->
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="qty_alt_uom" string="Alt. On Hand" optional="show" readonly="1"/>
                <field name="primary_alt_uom_id" string="Alt. UoM" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
