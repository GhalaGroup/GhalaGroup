<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Backup Tree View -->
    <record id="uom_conversion_backup_view_tree" model="ir.ui.view">
        <field name="name">uom.conversion.backup.view.tree</field>
        <field name="model">uom.conversion.backup</field>
        <field name="arch" type="xml">
            <list string="UoM Conversion Backups">
                <field name="name"/>
                <field name="backup_date"/>
                <field name="backup_type"/>
                <field name="conversion_count" string="Conversions"/>
                <field name="product_count" string="Products"/>
                <field name="is_restored"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Backup Form View -->
    <record id="uom_conversion_backup_view_form" model="ir.ui.view">
        <field name="name">uom.conversion.backup.view.form</field>
        <field name="model">uom.conversion.backup</field>
        <field name="arch" type="xml">
            <form string="UoM Conversion Backup">
                <header>
                    <button name="action_restore" type="object"
                            string="Restore" class="btn-primary"
                            invisible="is_restored"
                            confirm="This will restore all conversions from this backup. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="backup_date"/>
                            <field name="backup_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="conversion_count"/>
                            <field name="product_count"/>
                            <field name="is_restored"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Backup Action -->
    <record id="action_uom_conversion_backup" model="ir.actions.act_window">
        <field name="name">UoM Conversion Backups</field>
        <field name="res_model">uom.conversion.backup</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu: Inventory > Configuration > UoM Conversion Backups -->
    <menuitem id="menu_uom_conversion_backup"
              name="UoM Conversion Backups"
              parent="stock.menu_stock_config_settings"
              action="action_uom_conversion_backup"
              sequence="26"/>

</odoo>
