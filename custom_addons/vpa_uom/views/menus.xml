<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- MENUS - Units of Measure Management            -->
    <!-- ============================================== -->

    <!-- Parent Menu: Inventory > Configuration > Units of Measure -->
    <menuitem id="menu_uom_root"
              name="Units of Measure"
              parent="stock.menu_stock_config_settings"
              sequence="24"/>

    <!-- Submenu 1: Units of Measure (create UoMs here) -->
    <menuitem id="menu_uom_uom"
              name="Units of Measure"
              parent="menu_uom_root"
              action="action_uom_uom_vpa"
              sequence="10"/>

    <!-- Submenu 2: Product Conversions (assign UoMs to products) -->
    <menuitem id="menu_product_uom_conversion"
              name="Product Conversions"
              parent="menu_uom_root"
              action="action_product_uom_conversion"
              sequence="20"/>

    <!-- Settings > Technical > Units of Measure -->
    <menuitem id="menu_uom_settings"
              name="Units of Measure"
              parent="base.menu_custom"
              action="action_uom_uom_vpa"
              sequence="50"/>

</odoo>
