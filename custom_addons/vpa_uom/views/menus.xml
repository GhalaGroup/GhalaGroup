<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- INVENTORY MENU - Alternative UoM Management    -->
    <!-- ============================================== -->

    <!-- Menu: Inventory > Configuration > Alternative UoM Conversions -->
    <menuitem id="menu_product_uom_conversion"
              name="Alternative UoM Conversions"
              parent="stock.menu_stock_config_settings"
              action="action_product_uom_conversion"
              sequence="25"/>

    <!-- ============================================== -->
    <!-- PRODUCTS WITH ALTERNATIVE UOM - Quick Access   -->
    <!-- ============================================== -->

    <!-- Action: Products with Alternative UoMs -->
    <record id="action_products_with_alt_uom" model="ir.actions.act_window">
        <field name="name">Products with Alternative UoM</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('uom_conversion_ids', '!=', False)]</field>
        <field name="context">{'search_default_filter_to_sell': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No products with alternative UoMs yet.
            </p>
            <p>
                Configure alternative UoMs on products to see them here.
                Go to any product and add conversions in the "Alternative UoM" tab.
            </p>
        </field>
    </record>

    <!-- Menu: Inventory > Products > Products with Alternative UoM -->
    <menuitem id="menu_products_with_alt_uom"
              name="Products with Alternative UoM"
              parent="stock.menu_stock_inventory_control"
              action="action_products_with_alt_uom"
              sequence="15"/>

    <!-- ============================================== -->
    <!-- MANUFACTURING MENU - BOM with Alt UoM          -->
    <!-- ============================================== -->

    <!-- Enhanced BOM Tree View with Alternative UoM Info -->
    <record id="mrp_bom_tree_view_alt_uom" model="ir.ui.view">
        <field name="name">mrp.bom.tree.alt.uom</field>
        <field name="model">mrp.bom</field>
        <field name="arch" type="xml">
            <list string="Bills of Materials with Alternative UoM">
                <field name="product_tmpl_id"/>
                <field name="product_id" groups="product.group_product_variant" optional="show"/>
                <field name="code" optional="show"/>
                <field name="product_qty"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
                <field name="type" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <!-- BOM Components Detailed View (standalone) -->
    <record id="mrp_bom_line_tree_view_detailed" model="ir.ui.view">
        <field name="name">mrp.bom.line.tree.detailed</field>
        <field name="model">mrp.bom.line</field>
        <field name="arch" type="xml">
            <list string="BOM Components" create="false" edit="false">
                <field name="bom_id" string="BOM"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
                <field name="qty_base_uom_str" string="Base Equiv." optional="show"/>
                <field name="allowed_uom_ids" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Action: All BOM Components with Alternative UoM -->
    <record id="action_mrp_bom_line_alt_uom" model="ir.actions.act_window">
        <field name="name">BOM Components (All)</field>
        <field name="res_model">mrp.bom.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="mrp_bom_line_tree_view_detailed"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No BOM components found.
            </p>
            <p>
                This view shows all BOM components across all BOMs,
                with their alternative UoM equivalents.
            </p>
        </field>
    </record>

    <!-- Menu: Manufacturing > Master Data > BOM Components -->
    <menuitem id="menu_mrp_bom_components"
              name="BOM Components"
              parent="mrp.menu_mrp_bom"
              action="action_mrp_bom_line_alt_uom"
              sequence="20"/>

    <!-- ============================================== -->
    <!-- ALTERNATIVE UOM DASHBOARD / OVERVIEW           -->
    <!-- ============================================== -->

    <!-- Conversion Summary Tree View -->
    <record id="product_uom_conversion_tree_summary" model="ir.ui.view">
        <field name="name">product.uom.conversion.tree.summary</field>
        <field name="model">product.uom.conversion</field>
        <field name="arch" type="xml">
            <list string="Alternative UoM Conversions" create="true" edit="true">
                <field name="product_tmpl_id"/>
                <field name="uom_id"/>
                <field name="alt_qty"/>
                <field name="base_uom_id"/>
                <field name="base_qty"/>
                <field name="name" optional="show"/>
                <field name="rounding" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Action: All Alternative UoM Conversions (Dashboard style) -->
    <record id="action_product_uom_conversion_dashboard" model="ir.actions.act_window">
        <field name="name">Alternative UoM Conversions</field>
        <field name="res_model">product.uom.conversion</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="product_uom_conversion_tree_summary"/>
        <field name="search_view_id" ref="product_uom_conversion_view_search"/>
        <field name="context">{'search_default_group_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No alternative UoM conversions defined yet.
            </p>
            <p>
                Define product-specific UoM conversions to enable selling and
                manufacturing in alternative units (e.g., Boards instead of m²).
            </p>
            <p>
                <strong>To add conversions:</strong>
                <ol>
                    <li>Go to a Product</li>
                    <li>Click the "Alternative UoM" tab</li>
                    <li>Add your conversions (e.g., 1 Board = 2.9768 m²)</li>
                </ol>
            </p>
        </field>
    </record>

</odoo>
