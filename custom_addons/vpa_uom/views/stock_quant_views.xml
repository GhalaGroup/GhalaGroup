<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stock Quant Tree View - Add Alternative UoM Columns -->
    <record id="stock_quant_view_tree_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">stock.quant.tree.inherit.vpa.uom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <!-- Add Alt. UoM and Alt. Qty columns after quantity -->
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="primary_alt_uom_id" string="Alt. UoM" optional="show"/>
                <field name="qty_alt_uom_str" string="Alt. Qty" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Quant Editable Tree View - Add Alternative UoM Columns -->
    <record id="stock_quant_view_tree_editable_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.inherit.vpa.uom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <!-- Add Alt. UoM and Alt. Qty columns after quantity -->
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="primary_alt_uom_id" string="Alt. UoM" optional="show" readonly="1"/>
                <field name="qty_alt_uom_str" string="Alt. Qty" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Quant Form View - Show Alternative UoM Info -->
    <record id="stock_quant_view_form_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">stock.quant.form.inherit.vpa.uom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <label for="qty_alt_uom" invisible="not primary_alt_uom_id"/>
                <div invisible="not primary_alt_uom_id">
                    <field name="qty_alt_uom_str" class="oe_inline"/>
                    <span> </span>
                    <field name="primary_alt_uom_id" class="oe_inline" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Inventory Adjustment View - Show Alternative Qty -->
    <record id="stock_quant_view_tree_inventory_inherit_vpa_uom" model="ir.ui.view">
        <field name="name">stock.quant.tree.inventory.inherit.vpa.uom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_quantity']" position="after">
                <field name="primary_alt_uom_id" string="Alt. UoM" optional="show" readonly="1"/>
                <field name="qty_alt_uom_str" string="Alt. Qty" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
