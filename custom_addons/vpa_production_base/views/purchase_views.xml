<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Purchase Views - Hide Cost Fields                             -->
    <!-- Only visible to users in View Product Cost group              -->
    <!-- ============================================================ -->

    <!-- Hide cost in Purchase History tree view -->
    <record id="purchase_history_tree_hide_cost" model="ir.ui.view">
        <field name="name">purchase.history.list.hide.cost</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_history_tree"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Hide Unit Price column (Odoo 19 uses price_unit_product_uom) -->
            <xpath expr="//field[@name='price_unit_product_uom']" position="attributes">
                <attribute name="groups">vpa_production_base.group_view_product_cost</attribute>
            </xpath>
            <!-- Hide Total Untaxed column -->
            <xpath expr="//field[@name='price_subtotal']" position="attributes">
                <attribute name="groups">vpa_production_base.group_view_product_cost</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide cost in Purchase Order Line tree view -->
    <record id="purchase_order_line_tree_hide_cost" model="ir.ui.view">
        <field name="name">purchase.order.line.list.hide.cost</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_unit']" position="attributes">
                <attribute name="groups">vpa_production_base.group_view_product_cost</attribute>
            </xpath>
            <xpath expr="//field[@name='price_subtotal']" position="attributes">
                <attribute name="groups">vpa_production_base.group_view_product_cost</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide cost in Purchase Order Line form view -->
    <record id="purchase_order_line_form_hide_cost" model="ir.ui.view">
        <field name="name">purchase.order.line.form.hide.cost</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_unit']" position="attributes">
