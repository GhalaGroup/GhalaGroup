            </xpath>
        </field>
    </record>

    <!-- Hide cost in Purchase Order form view (order lines) -->
    <record id="purchase_order_form_hide_cost" model="ir.ui.view">
        <field name="name">purchase.order.form.hide.cost</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Hide price_unit in order lines list -->
            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="attributes">
                <attribute name="groups">vpa_production_base.group_view_product_cost</attribute>
            </xpath>
            <!-- Hide price_subtotal (Amount) in order lines list -->
            <xpath expr="//field[@name='order_line']//list//field[@name='price_subtotal']" position="attributes">
                <attribute name="groups">vpa_production_base.group_view_product_cost</attribute>
            </xpath>
            <!-- Hide discount in order lines list -->
            <xpath expr="//field[@name='order_line']//list//field[@name='discount']" position="attributes">
                <attribute name="groups">vpa_production_base.group_view_product_cost</attribute>
            </xpath>
            <!-- Hide taxes in order lines list -->
            <xpath expr="//field[@name='order_line']//list//field[@name='tax_ids']" position="attributes">
                <attribute name="groups">vpa_production_base.group_view_product_cost</attribute>
            </xpath>
            <!-- Hide tax_totals widget (totals section) -->
            <xpath expr="//field[@name='tax_totals']" position="attributes">
                <attribute name="groups">vpa_production_base.group_view_product_cost</attribute>
            </xpath>
            <!-- Hide price_unit in order lines form -->
            <xpath expr="//field[@name='order_line']//form//field[@name='price_unit']" position="attributes">
                <attribute name="groups">vpa_production_base.group_view_product_cost</attribute>
            </xpath>
            <!-- Hide discount in order lines form -->
            <xpath expr="//field[@name='order_line']//form//field[@name='discount']" position="attributes">
                <attribute name="groups">vpa_production_base.group_view_product_cost</attribute>
            </xpath>
            <!-- Hide taxes in order lines form -->
            <xpath expr="//field[@name='order_line']//form//field[@name='tax_ids']" position="attributes">
                <attribute name="groups">vpa_production_base.group_view_product_cost</attribute>
            </xpath>
        </field>
    </record>

