<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- MRP BOM Views - Master BOM with Categories & Audit Trail      -->
    <!-- ============================================================ -->

    <!-- Inherit BOM Form View - Add Audit Trail & Category Columns -->
    <record id="mrp_bom_form_view_inherit_vpa_production" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.vpa.production</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <!-- Add Master BOM indicator -->
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon" title="Master BOM" bg_color="text-bg-info"
                        invisible="not is_master_bom"/>
                <field name="is_master_bom" invisible="1"/>
            </xpath>

            <!-- Add audit info group at the bottom of the form -->
            <xpath expr="//sheet/group[last()]" position="after">
                <group string="Audit Information" name="audit_info" groups="vpa_production_base.group_bom_manager">
                    <group>
                        <field name="created_by_id" readonly="1"/>
                        <field name="created_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="last_modified_by_id" readonly="1"/>
                        <field name="last_modified_date" readonly="1"/>
                    </group>
                </group>
            </xpath>

            <!-- Extend BOM Lines with Category & Description -->
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_id']" position="before">
                <field name="bom_category_id"
                       domain="[('is_main_category', '=', False)]"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="line_description" placeholder="Optional description..."/>
                <field name="is_template_line" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit BOM Tree View - Add Master BOM Column -->
    <record id="mrp_bom_tree_view_inherit_vpa_production" model="ir.ui.view">
        <field name="name">mrp.bom.tree.inherit.vpa.production</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tmpl_id']" position="after">
                <field name="is_master_bom" string="Master" optional="show" widget="boolean_toggle"/>
            </xpath>
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="created_by_id" optional="hide"/>
                <field name="last_modified_date" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit BOM Search View - Add Filters -->
    <record id="mrp_bom_search_view_inherit_vpa_production" model="ir.ui.view">
        <field name="name">mrp.bom.search.inherit.vpa.production</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.view_mrp_bom_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='phantom']" position="after">
                <separator/>
                <filter string="Master BOMs" name="master_boms" domain="[('is_master_bom', '=', True)]"/>
                <filter string="Standard BOMs" name="standard_boms" domain="[('is_master_bom', '=', False)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Created By" name="group_created_by" context="{'group_by': 'created_by_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
