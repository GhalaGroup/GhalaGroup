<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="vpa_bom_category_view_list" model="ir.ui.view">
        <field name="name">vpa.bom.category.list</field>
        <field name="model">vpa.bom.category</field>
        <field name="arch" type="xml">
            <list string="BOM Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_main_category" optional="show" widget="boolean_toggle"/>
                <field name="parent_id" optional="show"/>
                <field name="code" optional="hide"/>
                <field name="description" optional="hide"/>
                <field name="product_count" string="Products"/>
                <field name="bom_line_count" string="BOM Lines"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="vpa_bom_category_view_form" model="ir.ui.view">
        <field name="name">vpa.bom.category.form</field>
        <field name="model">vpa.bom.category</field>
        <field name="arch" type="xml">
            <form string="BOM Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Paint &amp; Finishes"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_main_category"/>
                            <field name="parent_id" options="{'no_create': True}" domain="[('is_main_category', '=', True), ('id', '!=', id)]" invisible="is_main_category"/>
                            <field name="code" placeholder="Auto-generated (optional)"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Optional description for this category..."/>
                    </group>
                    <group string="Statistics">
                        <group>
                            <field name="product_count"/>
                        </group>
                        <group>
                            <field name="bom_line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subcategories" name="subcategories" invisible="not child_ids">
                            <field name="child_ids">
                                <list string="Subcategories">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="product_count"/>
                                    <field name="bom_line_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="vpa_bom_category_view_kanban" model="ir.ui.view">
        <field name="name">vpa.bom.category.kanban</field>
        <field name="model">vpa.bom.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="color"/>
                <field name="product_count"/>
                <field name="bom_line_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <div class="flex-grow-1">
                                <strong>
                                    <span t-attf-class="badge" t-attf-style="background-color: var(--o-tag-color-#{record.color.raw_value});">
                                        <field name="code"/>
                                    </span>
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted small mt-2">
                                    <span><field name="product_count"/> products</span>
                                    <span class="ms-3"><field name="bom_line_count"/> BOM lines</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="vpa_bom_category_view_search" model="ir.ui.view">
        <field name="name">vpa.bom.category.search</field>
        <field name="model">vpa.bom.category</field>
        <field name="arch" type="xml">
            <search string="BOM Categories">
                <field name="code"/>
                <field name="name"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vpa_bom_category" model="ir.actions.act_window">
        <field name="name">BOM Categories</field>
        <field name="res_model">vpa.bom.category</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="vpa_bom_category_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first BOM Category
            </p>
            <p>
                BOM Categories are used to classify raw materials (Paint, Hardwood, Hinges, etc.)
                for filtering during material selection in Manufacturing Orders.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem
        id="menu_vpa_bom_category"
        name="BOM Categories"
        parent="mrp.menu_mrp_configuration"
        action="action_vpa_bom_category"
        sequence="15"
        groups="vpa_production_base.group_bom_manager"/>

</odoo>
