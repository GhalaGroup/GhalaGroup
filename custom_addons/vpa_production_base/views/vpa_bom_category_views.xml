<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="vpa_bom_category_view_list" model="ir.ui.view">
        <field name="name">vpa.bom.category.list</field>
        <field name="model">vpa.bom.category</field>
        <field name="arch" type="xml">
            <list string="BOM Categories"
                  decoration-bf="is_main_category"
                  decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="is_main_category" widget="boolean_toggle" string="Main"/>
                <field name="parent_id" string="Parent"/>
                <field name="product_count" string="Products"/>
                <field name="bom_line_count" string="BOM Lines"/>
                <field name="color" widget="color_picker" string="Color" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="vpa_bom_category_view_form" model="ir.ui.view">
        <field name="name">vpa.bom.category.form</field>
        <field name="model">vpa.bom.category</field>
        <field name="arch" type="xml">
            <form string="BOM Category">
                <header>
                    <button name="action_create_placeholder" string="Create Placeholder Product"
                            type="object" class="btn-secondary"
                            invisible="is_main_category or placeholder_product_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object"
                                class="oe_stat_button" icon="fa-cube"
                                invisible="product_count == 0">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                        <button name="action_view_bom_lines" type="object"
                                class="oe_stat_button" icon="fa-list"
                                invisible="bom_line_count == 0">
                            <field name="bom_line_count" widget="statinfo" string="BOMs"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Main Category" bg_color="text-bg-primary" invisible="not is_main_category"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Paint &amp; Finishes"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_main_category"/>
                            <field name="parent_id" options="{'no_create': True}"
                                   domain="[('is_main_category', '=', True), ('id', '!=', id)]"
                                   invisible="is_main_category"/>
                            <field name="code" placeholder="Auto-generated (optional)"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="color" widget="color_picker"/>
                            <field name="placeholder_product_id" readonly="1" invisible="is_main_category"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subcategories" name="subcategories" invisible="not is_main_category">
                            <field name="child_ids">
                                <list string="Subcategories" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code" optional="show"/>
                                    <field name="name"/>
                                    <field name="description" optional="hide"/>
                                    <field name="product_count" string="Products"/>
                                    <field name="bom_line_count" string="BOM Lines"/>
                                    <field name="color" widget="color_picker" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"
                                   placeholder="Optional description for this category..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="vpa_bom_category_view_kanban" model="ir.ui.view">
        <field name="name">vpa.bom.category.kanban</field>
        <field name="model">vpa.bom.category</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="color"/>
                <field name="is_main_category"/>
                <field name="parent_id"/>
                <field name="product_count"/>
                <field name="bom_line_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column">
                            <div class="d-flex align-items-center mb-1">
                                <span t-if="record.code.raw_value"
                                      class="badge text-bg-secondary me-2">
                                    <field name="code"/>
                                </span>
                                <strong class="fs-5">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div t-if="record.is_main_category.raw_value"
                                 class="badge text-bg-primary mb-2" style="width: fit-content;">
                                Main Category
                            </div>
                            <div t-if="!record.is_main_category.raw_value and record.parent_id.raw_value"
                                 class="text-muted small mb-2">
                                <i class="fa fa-folder-open me-1"/>
                                <field name="parent_id"/>
                            </div>
                            <div class="d-flex gap-3 mt-auto pt-2 border-top">
                                <div class="text-center">
                                    <span class="fw-bold text-primary">
                                        <field name="product_count"/>
                                    </span>
                                    <span class="text-muted small ms-1">Products</span>
                                </div>
                                <div class="text-center">
                                    <span class="fw-bold text-primary">
                                        <field name="bom_line_count"/>
                                    </span>
                                    <span class="text-muted small ms-1">BOM Lines</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="vpa_bom_category_view_search" model="ir.ui.view">
        <field name="name">vpa.bom.category.search</field>
        <field name="model">vpa.bom.category</field>
        <field name="arch" type="xml">
            <search string="BOM Categories">
                <field name="code"/>
                <field name="name"/>
                <separator/>
                <filter string="Main Categories" name="main_categories"
                        domain="[('is_main_category', '=', True)]"/>
                <filter string="Subcategories" name="subcategories"
                        domain="[('is_main_category', '=', False)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Parent Category" name="group_parent"
                        context="{'group_by': 'parent_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vpa_bom_category" model="ir.actions.act_window">
        <field name="name">BOM Categories</field>
        <field name="res_model">vpa.bom.category</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_group_parent': 1}</field>
        <field name="search_view_id" ref="vpa_bom_category_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first BOM Category
            </p>
            <p>
                BOM Categories are used to classify raw materials (Paint, Hardwood, Hinges, etc.)
                for filtering during material selection in Manufacturing Orders.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem
        id="menu_vpa_bom_category"
        name="BOM Categories"
        parent="mrp.menu_mrp_configuration"
        action="action_vpa_bom_category"
        sequence="15"
        groups="mrp.group_mrp_user"/>

</odoo>
