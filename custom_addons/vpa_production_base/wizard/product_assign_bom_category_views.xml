<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Assign BOM Category Wizard                                   -->
    <!-- VPA Production Base                                          -->
    <!-- ============================================================ -->

    <!-- Wizard Form View -->
    <record id="product_assign_bom_category_form" model="ir.ui.view">
        <field name="name">product.assign.bom.category.form</field>
        <field name="model">product.assign.bom.category</field>
        <field name="arch" type="xml">
            <form string="Assign BOM Category">
                <group>
                    <field name="product_template_ids" widget="many2many_tags" readonly="1"/>
                    <field name="bom_category_id" placeholder="Select a BOM Category..."/>
                </group>
                <footer>
                    <button name="action_assign" string="Assign" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_product_assign_bom_category" model="ir.actions.act_window">
        <field name="name">Assign BOM Category</field>
        <field name="res_model">product.assign.bom.category</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,kanban</field>
    </record>

</odoo>
