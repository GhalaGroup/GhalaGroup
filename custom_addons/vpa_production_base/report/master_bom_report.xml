<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reusable BOM Lines Table Template v2 - Force refresh -->
    <template id="master_bom_lines_table">
        <table class="table table-sm o_main_table" style="width: 100%; border-collapse: collapse;">
            <thead style="background-color: var(--primary, #875A7B); color: white;">
                <tr>
                    <th style="padding: 10px;">Product / Category</th>
                    <th style="padding: 10px;">Description</th>
                    <th class="text-end" style="padding: 10px;">Quantity</th>
                    <th style="padding: 10px;">Unit</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="bom.bom_line_ids" t-as="line">
                    <!-- Skip section/note lines -->
                    <t t-if="not line.display_type">
                        <!-- Check if template line: has category but no product -->
                        <t t-if="line.bom_category_id and not line.product_id">
                            <!-- Template Line with Yellow Highlight and Warning Class -->
                            <tr class="table-warning" style="background-color: #fff3cd !important; border-left: 4px solid #ffc107;">
                                <td style="padding: 10px;">
                                    <t t-if="line.bom_category_id.code">
                                        <span class="badge bg-warning text-dark" style="margin-right: 8px;"><t t-esc="line.bom_category_id.code"/></span>
                                    </t>
                                    <strong><t t-esc="line.bom_category_id.name"/></strong>
                                </td>
                                <td style="padding: 10px;">
                                    <em><t t-esc="line.line_description or ''"/></em>
                                    <br/>
                                    <small class="text-muted fst-italic">(To be selected during manufacturing)</small>
                                </td>
                                <td class="text-end" style="padding: 10px;">
                                    <t t-esc="line.product_qty"/>
                                </td>
                                <td style="padding: 10px;">
                                    <t t-esc="line.product_uom_id.name if line.product_uom_id else ''"/>
                                </td>
                            </tr>
                        </t>

                        <!-- Standard Line (with Product) -->
                        <t t-elif="line.product_id">
                            <tr style="border-bottom: 1px solid #dee2e6;">
                                <td style="padding: 10px;">
                                    <t t-if="line.bom_category_id and line.bom_category_id.code">
                                        <span class="badge bg-secondary" style="margin-right: 8px;"><t t-esc="line.bom_category_id.code"/></span>
                                    </t>
                                    <t t-esc="line.product_id.display_name"/>
                                </td>
                                <td style="padding: 10px;">
                                    <t t-esc="line.line_description or ''"/>
                                </td>
                                <td class="text-end" style="padding: 10px;">
                                    <t t-esc="line.product_qty"/>
                                </td>
                                <td style="padding: 10px;">
                                    <t t-esc="line.product_uom_id.name if line.product_uom_id else ''"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </t>
            </tbody>
        </table>
    </template>

    <!-- Master BOM Preview Template (HTML On-Screen Display) v2 -->
    <template id="master_bom_overview">
        <t t-call="web.basic_layout">
            <div class="page" style="padding: 20px;">
                <t t-foreach="docs" t-as="bom">
                    <!-- Header Section with Card Style -->
                    <div class="card mb-4" style="border: 1px solid #dee2e6; border-radius: 8px; overflow: hidden;">
                        <div class="card-header" style="background-color: var(--primary, #875A7B); color: white; padding: 15px;">
                            <div class="row align-items-center">
                                <div class="col-8">
                                    <h3 class="mb-0" style="color: white;">
                                        <t t-esc="bom.product_tmpl_id.display_name"/>
                                    </h3>
                                </div>
                                <div class="col-4 text-end">
                                    <span class="badge bg-warning text-dark" style="font-size: 14px; padding: 8px 12px;">Master BOM</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body" style="padding: 20px;">
                            <div class="row">
                                <div class="col-4">
                                    <strong>Reference:</strong>
                                    <span t-esc="bom.code_with_revision"/>
                                </div>
                                <div class="col-4">
                                    <strong>Quantity:</strong>
                                    <t t-esc="bom.product_qty"/>
                                    <t t-esc="bom.product_uom_id.name"/>
                                </div>
                                <div class="col-4">
                                    <strong>Revision:</strong> <t t-esc="bom.revision"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Information Alert -->
                    <div class="alert alert-info" role="alert" style="margin-bottom: 20px; padding: 15px; border-left: 4px solid #0dcaf0;">
                        <strong>Template Information:</strong>
                        Items highlighted in yellow are template lines - they have a category but no specific product.
                        These will be selected by the manufacturing worker during production.
                    </div>

                    <!-- Master BOM Lines Table -->
                    <h4 style="margin-bottom: 15px; color: var(--primary, #875A7B);">Bill of Materials</h4>
                    <t t-call="vpa_production_base.master_bom_lines_table"/>

                    <!-- Footer Note -->
                    <div class="mt-4 p-3" style="background-color: #f8f9fa; border-radius: 6px; border-left: 4px solid #6c757d;">
                        <small>
                            <strong>Note:</strong> This is a Master BOM template.
                            Items marked with a yellow badge and background are template lines that will be selected
                            by the manufacturing worker based on available materials and project requirements.
                        </small>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Master BOM Report Definition -->
    <record id="action_report_master_bom_overview" model="ir.actions.report">
        <field name="name">Master BOM Overview</field>
        <field name="model">mrp.bom</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">vpa_production_base.master_bom_overview</field>
        <field name="report_file">vpa_production_base.master_bom_overview</field>
        <field name="binding_model_id" ref="mrp.model_mrp_bom"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Master BOM - %s' % (object.code_with_revision or object.code or object.id)</field>
    </record>
</odoo>
