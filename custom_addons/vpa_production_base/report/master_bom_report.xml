<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reusable BOM Lines Table Template -->
    <template id="master_bom_lines_table">
        <table class="table table-sm o_main_table">
            <thead>
                <tr>
                    <th>Product / Category</th>
                    <th>Description</th>
                    <th class="text-end">Quantity</th>
                    <th>Unit</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="bom.bom_line_ids" t-as="line">
                    <!-- Skip display_type lines (sections/notes) as they're not used in template -->
                    <t t-if="not line.display_type">
                        <!-- Template Line (Category without Product) -->
                        <t t-if="line.is_template_line">
                            <tr style="background-color: rgba(255, 193, 7, 0.1);">
                                <td>
                                    <span class="badge" style="background-color: #ffc107; color: #000;"><t t-esc="line.bom_category_id.code"/></span>
                                    <strong><t t-esc="line.bom_category_id.name"/></strong>
                                </td>
                                <td>
                                    <em><t t-esc="line.line_description or ''"/></em>
                                    <br/>
                                    <small class="text-muted">(To be selected during manufacturing)</small>
                                </td>
                                <td class="text-end">
                                    <t t-esc="line.product_qty"/>
                                </td>
                                <td>
                                    <t t-esc="line.product_uom_id.name"/>
                                </td>
                            </tr>
                        </t>

                        <!-- Standard Line (with Product) -->
                        <t t-else="">
                            <tr>
                                <td>
                                    <t t-if="line.bom_category_id">
                                        <span class="badge bg-secondary"><t t-esc="line.bom_category_id.code"/></span>
                                    </t>
                                    <t t-esc="line.product_id.display_name"/>
                                </td>
                                <td>
                                    <t t-esc="line.line_description or ''"/>
                                </td>
                                <td class="text-end">
                                    <t t-esc="line.product_qty"/>
                                </td>
                                <td>
                                    <t t-esc="line.product_uom_id.name"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </t>
            </tbody>
        </table>
    </template>

    <!-- Master BOM Preview Template (HTML On-Screen Display) -->
    <template id="master_bom_overview">
        <t t-call="web.basic_layout">
            <div class="page o_report_layout_standard">
                <t t-foreach="docs" t-as="bom">
                    <!-- Header -->
                    <div class="row">
                        <div class="col-6">
                            <h2>
                                <span t-field="bom.product_tmpl_id.display_name"/>
                            </h2>
                            <div>
                                <strong>Reference:</strong>
                                <span t-field="bom.code_with_revision"/>
                            </div>
                            <div>
                                <strong>Quantity:</strong>
                                <span t-field="bom.product_qty"/>
                                <span t-field="bom.product_uom_id.name"/>
                            </div>
                        </div>
                        <div class="col-6 text-end">
                            <span class="badge bg-info">Master BOM</span>
                            <div class="mt-2">
                                <strong>Revision:</strong> <span t-field="bom.revision"/>
                            </div>
                            <div>
                                <strong>Type:</strong> <span t-field="bom.type"/>
                            </div>
                        </div>
                    </div>

                    <hr class="mt-3 mb-3"/>

                    <!-- Master BOM Lines -->
                    <h4>Bill of Materials</h4>
                    <p class="text-muted">
                        <em>Template lines (category without product) will be selected by worker during manufacturing.</em>
                    </p>

                    <t t-call="vpa_production_base.master_bom_lines_table"/>

                    <!-- Notes -->
                    <t t-if="bom.code">
                        <div class="mt-4">
                            <p class="text-muted">
                                <small>
                                    <strong>Note:</strong> This is a Master BOM template.
                                    Items marked with a category code but no specific product will be selected
                                    by the manufacturing worker based on available materials and project requirements.
                                </small>
                            </p>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <!-- Master BOM Report Definition -->
    <record id="action_report_master_bom_overview" model="ir.actions.report">
        <field name="name">Master BOM Overview</field>
        <field name="model">mrp.bom</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">vpa_production_base.master_bom_overview</field>
        <field name="report_file">vpa_production_base.master_bom_overview</field>
        <field name="binding_model_id" ref="mrp.model_mrp_bom"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Master BOM - %s' % (object.code_with_revision or object.code or object.id)</field>
    </record>
</odoo>
