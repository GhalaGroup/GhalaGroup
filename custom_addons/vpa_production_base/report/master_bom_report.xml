<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Master BOM Preview Template - Use Standard BOM Overview Style -->
    <template id="master_bom_overview">
        <!-- Use the standard BOM Overview template with our customizations
             Template lines will be shown with yellow highlighting via inherited template -->
        <t t-call="mrp.report_mrp_bom"/>
    </template>

    <!-- Master BOM Report Definition -->
    <record id="action_report_master_bom_overview" model="ir.actions.report">
        <field name="name">Master BOM Overview</field>
        <field name="model">mrp.bom</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">vpa_production_base.master_bom_overview</field>
        <field name="report_file">vpa_production_base.master_bom_overview</field>
        <field name="binding_model_id" ref="mrp.model_mrp_bom"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Master BOM - %s' % (object.code_with_revision or object.code or object.id)</field>
    </record>
</odoo>
