<odoo>
    <record id="stock_sentinel_log_view_list" model="ir.ui.view">
        <field name="name">stock.sentinel.log.list</field>
        <field name="model">stock.sentinel.log</field>
        <field name="arch" type="xml">
            <list string="Stock Sentinel Log" create="false"
                  decoration-danger="event_type == 'block'"
                  decoration-warning="event_type == 'warn'"
                  decoration-info="event_type == 'override'">
                <field name="name"/>
                <field name="create_date" string="When"/>
                <field name="event_type" widget="badge"
                       decoration-danger="event_type == 'block'"
                       decoration-warning="event_type == 'warn'"
                       decoration-info="event_type == 'override'"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="warehouse_id" optional="show"/>
                <field name="current_qty"/>
                <field name="move_qty"/>
                <field name="resulting_qty"/>
                <field name="shortfall_qty" optional="show"/>
                <field name="reference" string="Document" optional="show"/>
                <field name="user_id" string="User"/>
                <field name="reason" string="Override Reason" optional="show"/>
                <field name="company_id" string="Company" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="stock_sentinel_log_view_form" model="ir.ui.view">
        <field name="name">stock.sentinel.log.form</field>
        <field name="model">stock.sentinel.log</field>
        <field name="arch" type="xml">
            <form string="Stock Sentinel Event" create="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Event">
                            <field name="event_type"/>
                            <field name="user_id"/>
                            <field name="create_date"/>
                            <field name="reference"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Stock">
                            <field name="product_id"/>
                            <field name="location_id"/>
                            <field name="warehouse_id"/>
                            <field name="current_qty"/>
                            <field name="move_qty"/>
                            <field name="resulting_qty"/>
                            <field name="shortfall_qty"/>
                        </group>
                    </group>
                    <group string="Override Reason" invisible="event_type != 'override'">
                        <field name="reason" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="stock_sentinel_log_view_search" model="ir.ui.view">
        <field name="name">stock.sentinel.log.search</field>
        <field name="model">stock.sentinel.log</field>
        <field name="arch" type="xml">
            <search string="Stock Sentinel Log">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="warehouse_id"/>
                <field name="user_id"/>
                <field name="reference"/>
                <filter name="blocked" string="Blocked" domain="[('event_type', '=', 'block')]"/>
                <filter name="warned" string="Warned" domain="[('event_type', '=', 'warn')]"/>
                <filter name="overridden" string="Overridden" domain="[('event_type', '=', 'override')]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_event" string="Event" context="{'group_by': 'event_type'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="stock_sentinel_log_action" model="ir.actions.act_window">
        <field name="name">Stock Sentinel Log</field>
        <field name="res_model">stock.sentinel.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="stock_sentinel_log_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No events recorded yet</p>
            <p>Every blocked, warned or overridden negative-stock operation is logged here.</p>
        </field>
    </record>
</odoo>
