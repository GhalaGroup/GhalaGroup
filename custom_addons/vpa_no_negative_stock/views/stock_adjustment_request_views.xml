<odoo>
    <record id="stock_adjustment_request_view_list" model="ir.ui.view">
        <field name="name">stock.adjustment.request.list</field>
        <field name="model">stock.adjustment.request</field>
        <field name="arch" type="xml">
            <list string="Adjustment Approvals" create="false"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="create_date" string="Requested"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="current_qty"/>
                <field name="counted_qty"/>
                <field name="diff_qty"/>
                <field name="requested_by" string="Requested By"/>
                <field name="approved_by" string="Decided By" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <field name="company_id" string="Company" groups="base.group_multi_company" optional="show"/>
                <button name="action_approve" type="object" string="Approve"
                        icon="fa-check" class="text-success"
                        invisible="state != 'pending'"/>
                <button name="action_open_reject_wizard" type="object" string="Reject"
                        icon="fa-times" class="text-danger"
                        invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="stock_adjustment_request_view_form" model="ir.ui.view">
        <field name="name">stock.adjustment.request.form</field>
        <field name="model">stock.adjustment.request</field>
        <field name="arch" type="xml">
            <form string="Inventory Adjustment Request" create="false">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            class="btn-secondary" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Adjustment">
                            <field name="product_id"/>
                            <field name="location_id"/>
                            <field name="lot_id" invisible="not lot_id"/>
                            <field name="package_id" invisible="not package_id"/>
                            <field name="owner_id" invisible="not owner_id"/>
                        </group>
                        <group string="Quantities">
                            <field name="current_qty"/>
                            <field name="counted_qty"/>
                            <field name="diff_qty"/>
                        </group>
                        <group string="Request">
                            <field name="requested_by"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Decision" invisible="state == 'pending'">
                            <field name="approved_by"/>
                            <field name="decision_date"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"/>
                    </group>
                    <group string="Rejection Reason" invisible="state != 'rejected'">
                        <field name="reject_reason" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="stock_adjustment_request_view_search" model="ir.ui.view">
        <field name="name">stock.adjustment.request.search</field>
        <field name="model">stock.adjustment.request</field>
        <field name="arch" type="xml">
            <search string="Adjustment Approvals">
                <field name="name"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="requested_by"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="my_requests" string="My Requests" domain="[('requested_by', '=', uid)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_requester" string="Requested By" context="{'group_by': 'requested_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="stock_adjustment_request_action" model="ir.actions.act_window">
        <field name="name">Adjustment Approvals</field>
        <field name="res_model">stock.adjustment.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="stock_adjustment_request_view_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No adjustment requests</p>
            <p>Manual inventory adjustments awaiting approval appear here.</p>
        </field>
    </record>
</odoo>
