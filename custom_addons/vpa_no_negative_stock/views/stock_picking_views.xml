<odoo>
    <record id="view_picking_form_nns" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.stock.sentinel</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="nns_show_override" invisible="1"/>
                <button name="action_nns_override" type="object"
                        string="Override Negative Stock"
                        class="btn-warning"
                        invisible="not nns_show_override"
                        groups="vpa_no_negative_stock.group_stock_sentinel_override"/>
            </xpath>
        </field>
    </record>
</odoo>
