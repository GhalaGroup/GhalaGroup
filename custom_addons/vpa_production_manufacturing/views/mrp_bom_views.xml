<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Master BOMs Action & Menu                                     -->
    <!-- VPA Production Manufacturing                                  -->
    <!-- ============================================================ -->

    <!-- Search view for Master BOMs with Product Category sidebar -->
    <record id="mrp_bom_search_master" model="ir.ui.view">
        <field name="name">mrp.bom.search.master</field>
        <field name="model">mrp.bom</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <search string="Search Master BOMs">
                <!-- Left sidebar for Product Category filtering -->
                <searchpanel>
                    <field name="product_categ_id" string="Product Category" icon="fa-th-list" enable_counters="1" expand="1"/>
                </searchpanel>
                <field name="code" string="Reference"/>
                <field name="product_tmpl_id" string="Product"/>
                <field name="product_id" string="Product Variant"/>
                <separator/>
                <filter string="Normal" name="normal" domain="[('type', '=', 'normal')]"/>
                <filter string="Kit" name="phantom" domain="[('type', '=', 'phantom')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter string="Product Category" name="group_categ" context="{'group_by': 'product_categ_id'}"/>
                    <filter string="Created By" name="group_created_by" context="{'group_by': 'created_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Master BOMs only -->
    <record id="action_mrp_bom_master" model="ir.actions.act_window">
        <field name="name">Master BOMs</field>
        <field name="res_model">mrp.bom</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_master_bom', '=', True)]</field>
        <field name="context">{'default_type': 'normal'}</field>
        <field name="search_view_id" ref="mrp_bom_search_master"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Master BOM
            </p>
            <p>
                Master BOMs use category-based template lines instead of specific products.
                Workers select actual materials during production.
            </p>
        </field>
    </record>

    <!-- Menu item under Manufacturing > Products -->
    <menuitem id="menu_mrp_bom_master"
        name="Master BOMs"
        action="action_mrp_bom_master"
        parent="mrp.menu_mrp_bom"
        sequence="3"/>

</odoo>
