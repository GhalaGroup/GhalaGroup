<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Multi-company record rule for dimension templates -->
    <record id="vpa_dimension_template_company_rule" model="ir.rule">
        <field name="name">Dimension Template: Multi-Company</field>
        <field name="model_id" ref="model_vpa_dimension_template"/>
        <field name="domain_force">[
            '|', ('company_id', '=', False),
            ('company_id', 'in', company_ids),
        ]</field>
    </record>

</odoo>
