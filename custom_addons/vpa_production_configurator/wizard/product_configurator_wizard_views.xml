<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product Configurator Wizard Form -->
    <record id="vpa_product_configurator_wizard_form" model="ir.ui.view">
        <field name="name">vpa.product.configurator.wizard.form</field>
        <field name="model">vpa.product.configurator.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Configurator">
                <!-- Header: product info + rate in one compact row -->
                <div class="row mb-0 mx-2 mt-1">
                    <div class="col-6">
                        <field name="product_id" readonly="1"/>
                    </div>
                    <div class="col-3">
                        <field name="template_id" readonly="1"/>
                    </div>
                    <div class="col-3 text-end">
                        <label for="rate_display" string="Rate" class="fw-bold"/>
                        <field name="rate_display" readonly="1" class="d-inline ms-1"/>
                        <field name="rate" invisible="1"/>
                    </div>
                </div>
                <separator string="DIMENSIONS" class="mb-0"/>
                <field name="dimension_line_ids">
                    <list editable="bottom" no_open="1" create="0" delete="0">
                        <field name="name" readonly="1" string="Label"/>
                        <field name="value" string="Value"/>
                        <field name="uom_label" readonly="1" string="Unit"/>
                        <field name="uom_type" column_invisible="True"/>
                        <field name="min_value" readonly="1" optional="show"/>
                        <field name="max_value" readonly="1" optional="show"/>
                        <field name="required" column_invisible="True"/>
                        <field name="field_code" column_invisible="True"/>
                        <field name="dimension_line_id" column_invisible="True"/>
                        <field name="sequence" column_invisible="True"/>
                    </list>
                </field>
                <separator string="CONFIGURATION" class="mb-0"/>
                <field name="config_line_ids">
                    <list editable="bottom" no_open="1" create="0" delete="0">
                        <field name="display_group_name" readonly="1" string="Group"/>
                        <field name="name" readonly="1" string="Label"/>
                        <field name="option_id" string="Selection"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="surcharge_display" readonly="1" string="Surcharge"/>
                        <field name="variable_type" column_invisible="True"/>
                        <field name="variable_id" column_invisible="True"/>
                        <field name="required" column_invisible="True"/>
                        <field name="affects_price" column_invisible="True"/>
                        <field name="sequence" column_invisible="True"/>
                    </list>
                </field>
                <separator string="PRICE PREVIEW" class="mb-1"/>
                <div class="row mx-2 mb-1 align-items-end">
                    <div class="col-3">
                        <small class="text-muted">Quantity</small><br/>
                        <span class="fs-5">
                            <field name="preview_qty" nolabel="1" readonly="1" class="d-inline"/>
                            <field name="preview_qty_label" nolabel="1" readonly="1" class="d-inline ms-1"/>
                        </span>
                    </div>
                    <div class="col-4">
                        <small class="text-muted">Base Price</small><br/>
                        <span class="fs-5">
                            <field name="preview_base_price_display" nolabel="1" readonly="1" class="d-inline"/>
                        </span>
                        <field name="preview_base_price" invisible="1"/>
                    </div>
                    <div class="col-5 text-end">
                        <small class="text-muted">Unit Price</small><br/>
                        <span class="fw-bold fs-3">
                            <field name="preview_total_price_display" nolabel="1" readonly="1" class="d-inline"/>
                        </span>
                        <field name="preview_total_price" invisible="1"/>
                    </div>
                </div>
                <field name="preview_surcharges_display" readonly="1"
                       invisible="not preview_surcharges_display"
                       widget="text" nolabel="1" class="small text-muted mx-2"/>
                <field name="sale_line_id" invisible="1"/>
                <footer>
                    <button name="action_apply" string="Apply" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
