<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Manufacturing Order Form - Add Production Specifications -->
    <record id="mrp_production_form_inherit_dimension" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.dimension</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <field name="has_dimension_data" invisible="1"/>
                <field name="dimension_template_id" invisible="1"/>
                <field name="computed_dimension_qty" invisible="1"/>
                <field name="dimension_unit_count" invisible="1"/>
                <field name="dimension_data_json" invisible="1"/>
                <group invisible="not has_dimension_data" string="Production Specifications">
                    <field name="dimension_display" nolabel="1" colspan="2"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
