<odoo>

    <!-- Settings Form View -->
    <record id="res_config_settings_view_form_vpa_sku_generator" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.product.sequence</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority" eval="35"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Product Sequence Generator" string="Product Sequence Generator" name="vpa_sku_generator" groups="base.group_system">

                    <block title="SKU Generation" name="sku_generation">
                        <setting string="Auto-generate SKU" help="Automatically generate SKU when category is selected">
                            <field name="product_sku_auto_generate"/>
                        </setting>
                        <setting string="Enable SKU Recycling" help="Reuse SKUs from deleted products to fill gaps">
                            <field name="product_sku_enable_recycle"/>
                        </setting>
                    </block>

                    <block title="Validation Rules" name="validation_rules">
                        <setting string="Require Category" help="Make product category mandatory">
                            <field name="product_sku_require_category"/>
                        </setting>
                        <setting string="Require SKU" help="Make SKU (Internal Reference) mandatory">
                            <field name="product_sku_require_sku"/>
                        </setting>
                        <setting string="Block Manual Entry" help="Prevent manual SKU editing">
                            <field name="product_sku_block_manual"/>
                        </setting>
                    </block>

                    <block title="Statistics" name="statistics">
                        <setting string="Products with SKU" readonly="1">
                            <field name="total_products_with_sku" readonly="1"/>
                        </setting>
                        <setting string="Locked Products" readonly="1">
                            <field name="total_locked_products" readonly="1"/>
                        </setting>
                        <setting string="Recycled SKUs Available" readonly="1">
                            <field name="total_recycled_skus" readonly="1"/>
                        </setting>
                        <setting string="Categories with Short Code" readonly="1">
                            <field name="total_categories_with_shortcode" readonly="1"/>
                        </setting>
                    </block>

                    <block title="Actions" name="actions">
                        <setting string="Regenerate SKUs" help="Bulk regenerate SKUs for products with preview">
                            <div>
                                <button name="action_open_regenerate_wizard"
                                        string="Regenerate SKUs"
                                        type="object"
                                        class="btn-primary"
                                        icon="fa-refresh"/>
                            </div>
                        </setting>
                        <setting string="View Locked Products" help="See all products with locked SKUs">
                            <div>
                                <button name="action_view_locked_products"
                                        string="View Locked Products"
                                        type="object"
                                        class="btn-secondary"
                                        icon="fa-lock"/>
                            </div>
                        </setting>
                        <setting string="Manage Categories" help="Configure category short codes and view statistics">
                            <div>
                                <button name="action_view_categories"
                                        string="Manage Categories"
                                        type="object"
                                        class="btn-secondary"
                                        icon="fa-sitemap"/>
                            </div>
                        </setting>
                        <setting string="View Recycle Pool" help="See available recycled SKUs for reuse">
                            <div>
                                <button name="action_view_recycle_pool"
                                        string="View Recycle Pool"
                                        type="object"
                                        class="btn-secondary"
                                        icon="fa-recycle"/>
                            </div>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>


</odoo>
