<odoo>
    <data>

        <!-- Category Form View - Add Short Name -->
        <record model="ir.ui.view" id="product_category_form_view_inherit2">
            <field name="name">product.category.form.inherit</field>
            <field name="model">product.category</field>
            <field name = "inherit_id" ref ="product.product_category_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <group>
                        <field name="short_name" />
                        <field name="company_id" />
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Category List View for SKU Management -->
        <record id="product_category_list_view_sku" model="ir.ui.view">
            <field name="name">product.category.list.sku</field>
            <field name="model">product.category</field>
            <field name="arch" type="xml">
                <list string="Product Categories - SKU Management" editable="bottom">
                    <field name="name" widget="badge"/>
                    <button name="action_view_products" type="object" icon="fa-cube" title="View Products in this Category" invisible="product_count == 0"/>
                    <field name="short_name" required="1"/>
                    <field name="parent_id"/>
                    <field name="sku_preview" readonly="1"/>
                    <field name="product_count" readonly="1"/>
                    <field name="product_with_sku_count" readonly="1"/>
                    <field name="locked_product_count" readonly="1"/>
                    <field name="next_sku_number" readonly="1"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Action for Category SKU Management -->
        <record id="action_product_category_sku_management" model="ir.actions.act_window">
            <field name="name">Product Categories - SKU Management</field>
            <field name="res_model">product.category</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="product_category_list_view_sku"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No categories found
                </p>
                <p>
                    Create categories and assign short codes for SKU generation.
                    Example: Furniture (FUR), Tables (TBL)
                </p>
            </field>
        </record>

    </data>
</odoo>
