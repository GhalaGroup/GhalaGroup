<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_footer_wizard_form" model="ir.ui.view">
        <field name="name">vpa.import.footer.wizard.form</field>
        <field name="model">vpa.import.footer.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Footer Data">
                <group>
                    <field name="template_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="source_template_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_import" string="Import Footer Data" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
