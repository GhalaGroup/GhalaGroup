<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="vpa_document_layout.VPAPreviewWidget">
        <div class="o_vpa_preview_container" style="width: 100%; height: 100%; min-height: 600px; position: relative;">
            <iframe t-if="state.previewUrl"
                    t-att-src="iframeSrc"
                    style="width: 100%; height: 100%; border: none; min-height: 600px;"
                    frameborder="0"/>
            <div t-if="!state.previewUrl"
                 style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; color: #999;">
                <i class="fa fa-file-pdf-o fa-4x" style="margin-bottom: 15px; opacity: 0.3;"/>
                <p style="font-size: 14pt;">Save the template to see live preview</p>
            </div>
        </div>
    </t>
</templates>
