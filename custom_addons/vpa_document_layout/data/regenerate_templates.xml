<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="0" ensures this runs on EVERY upgrade, not just install -->
    <data noupdate="0">
        <!--
            Upgrade hook: Runs on every module upgrade
            1. Cleanup orphan report actions (fixes duplicate Print menu items)
            2. Regenerate sale_production templates (fixes QWeb syntax issues)
        -->
        <function model="vpa.document.template" name="_cleanup_and_regenerate_templates"/>
    </data>
</odoo>
