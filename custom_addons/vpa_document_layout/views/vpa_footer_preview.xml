<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Footer Preview Page -->
    <template id="footer_preview_page">
        <html>
            <head>
                <meta charset="utf-8"/>
                <title>Footer Preview - <t t-esc="template.name"/></title>
                <style type="text/css">
                    body {
                        margin: 40px;
                        font-family: Arial, sans-serif;
                        background: #f5f5f5;
                    }
                    .page-header {
                        text-align: center;
                        margin-bottom: 30px;
                    }
                    .page-header h1 {
                        color: #333;
                        font-size: 24pt;
                        margin-bottom: 10px;
                    }
                    .page-header p {
                        color: #666;
                        font-size: 12pt;
                    }
                    .preview-container {
                        max-width: 210mm;
                        height: 60mm;
                        margin: 0 auto;
                        background: white;
                        border: 2px dashed #ccc;
                        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
                        position: relative;
                    }
                    .info-box {
                        max-width: 210mm;
                        margin: 20px auto;
                        padding: 15px;
                        background: #e3f2fd;
                        border-left: 4px solid #2196f3;
                        border-radius: 4px;
                    }
                    .info-box strong {
                        color: #1976d2;
                    }
                </style>
            </head>
            <body>
                <div class="page-header">
                    <h1>Footer Preview: <t t-esc="template.name"/></h1>
                    <p>This is how your footer will appear at the bottom of every page in PDF documents</p>
                </div>

                <div class="info-box">
                    <strong>ℹ️ Preview Information:</strong><br/>
                    • Footer Layout: <t t-esc="dict(template._fields['footer_layout'].selection).get(template.footer_layout)"/><br/>
                    • Wave Shape: <t t-esc="'Enabled' if template.footer_show_shape else 'Disabled'"/><br/>
                    • Bank Details: <t t-esc="'Shown' if template.footer_bank_details_show else 'Hidden'"/>
                </div>

                <div class="preview-container">
                    <t t-call="vpa_document_layout.vpa_footer_only">
                        <t t-set="company" t-value="template.company_id"/>
                    </t>
                </div>

                <div class="info-box" style="background: #f3e5f5; border-left-color: #9c27b0;">
                    <strong>💡 Tip:</strong> Return to the template form to adjust colors, columns, or wave settings, then click "Regenerate Template" to apply changes.
                </div>
            </body>
        </html>
    </template>
</odoo>
