<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VPA Document Layout accessible from Settings → Companies menu -->
    <record id="action_vpa_settings" model="ir.actions.act_window">
        <field name="name">VPA Document Layout</field>
        <field name="res_model">vpa.document.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure VPA Document Layout
            </p>
            <p>
                Customize header, footer, and document body styling for all reports.<br/>
                Changes apply universally across Sales, Purchase, Invoices, Manufacturing, etc.
            </p>
        </field>
    </record>

    <!-- Add to Settings menu (no parent = top level app) -->
    <menuitem id="menu_vpa_app"
              name="VPA Layout"
              action="action_vpa_settings"
              web_icon="vpa_document_layout,static/description/icon.png"
              sequence="100"/>
</odoo>
