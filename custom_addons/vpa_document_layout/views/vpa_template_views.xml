<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="vpa_document_template_list" model="ir.ui.view">
        <field name="name">vpa.document.template.list</field>
        <field name="model">vpa.document.template</field>
        <field name="arch" type="xml">
            <list string="Document Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="document_type"/>
                <field name="target_app"/>
                <field name="is_default_print" string="Default Print" widget="boolean_toggle"/>
                <field name="is_default_email" string="Default Email" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View - Following Odoo's base.document.layout pattern exactly -->
    <record id="vpa_document_template_form" model="ir.ui.view">
        <field name="name">vpa.document.template.form</field>
        <field name="model">vpa.document.template</field>
        <field name="arch" type="xml">
            <form string="Document Template" class="o_document_layout">
                <header>
                    <button name="action_preview_template" string="Download PDF Preview" type="object" class="btn-primary" icon="fa-download"/>
                    <button name="action_preview_footer" string="Preview Footer" type="object" class="btn-secondary" icon="fa-eye" help="Preview how footer will appear on PDF pages"/>
                    <button name="action_regenerate_templates" string="Regenerate Template" type="object" class="btn-warning" icon="fa-refresh" help="Recreate QWeb template (use after making changes or to fix errors)"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <div class="alert alert-info" role="alert">
                        <strong>Template Name</strong> will appear in the Print menu when users print this document type.
                    </div>

                    <group>
                        <!-- Left Panel: Settings -->
                        <group class="o_document_layout_company">
                            <!-- Basic Info -->
                            <group>
                                <group>
                                    <field name="name" placeholder="e.g., Modern Sales Quote" colspan="2"/>
                                    <field name="target_app"/>
                                    <field name="document_type"/>
                                    <field name="report_title" placeholder="e.g., Production Order" invisible="document_type != 'sale_production'"/>
                                </group>
                                <group>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="sequence"/>
                                </group>
                            </group>

                            <!-- Default Template Selection -->
                            <separator string="Default Template"/>
                            <group>
                                <field name="is_default_print" string="Default for Print"/>
                                <field name="is_default_email" string="Default for Email"/>
                            </group>

                            <!-- PDF File Naming -->
                            <separator string="PDF File Naming"/>
                            <group>
                                <group>
                                    <field name="document_abbreviation" string="Abbreviation" placeholder="e.g., SQ, PS, INV"/>
                                </group>
                                <group>
                                    <field name="print_name_pattern" string="Filename Format"/>
                                </group>
                            </group>
                            <field name="print_name_preview" readonly="1" string="Example" class="text-muted fst-italic"/>
                            <field name="print_name_expression" invisible="print_name_pattern != 'custom'" placeholder="e.g., object.name + ' - ' + object.partner_id.name" string="Custom Expression"/>

                            <!-- Settings Notebook -->
                            <notebook>
                                <!-- Paper Settings Tab -->
                                <page string="Paper" name="paper">
                                    <group>
                                        <group string="Paper Format">
                                            <field name="paper_size" widget="radio" options="{'horizontal': true}"/>
                                            <field name="paper_orientation" widget="radio" options="{'horizontal': true}"/>
                                        </group>
                                    </group>
                                </page>

                                <!-- Header Tab -->
                                <page string="Header" name="header">
                                    <group>
                                        <group string="Odoo Standard Header">
                                            <field name="hide_odoo_header"/>
                                        </group>
                                        <group string="Multi-Page Settings">
                                            <field name="header_repeat_on_pages"/>
                                            <field name="header_height" invisible="not header_repeat_on_pages"/>
                                        </group>
                                    </group>

                                    <separator string="Logo Settings"/>
                                    <group>
                                        <group>
                                            <field name="header_logo_alignment" string="Alignment" widget="radio" options="{'horizontal': true}"/>
                                            <field name="header_logo_aspect_ratio" string="Sizing Mode" widget="radio" options="{'horizontal': true}"/>
                                        </group>
                                        <group>
                                            <field name="header_logo_width" string="Width (px)"/>
                                            <field name="header_logo_height" string="Height (px)"/>
                                        </group>
                                    </group>

                                    <separator string="Decorative Circle (Top Right)"/>
                                    <group>
                                        <group>
                                            <field name="header_show_circle"/>
                                            <field name="header_circle_size" string="Size (px)" invisible="not header_show_circle"/>
                                            <field name="header_circle_opacity" string="Opacity (0-1)" invisible="not header_show_circle"/>
                                        </group>
                                        <group/>
                                    </group>

                                    <separator string="Company Information"/>
                                    <group>
                                        <group>
                                            <button name="action_load_company_details"
                                                    string="📥 Load Company Details"
                                                    type="object"
                                                    class="btn-primary"
                                                    help="Click to load company address, phone, email, etc."/>
                                        </group>
                                        <group>
                                            <field name="header_company_info_alignment" string="Text Alignment" widget="radio" options="{'horizontal': true}"/>
                                            <field name="header_company_info_color" widget="color" string="Text Color"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="header_company_details_html" widget="html" nolabel="1" placeholder="Leave empty to use company address automatically. Click 'Load Company Details' button above to populate this field."/>
                                    </group>
                                </page>

                                <!-- Colors Tab -->
                                <page string="Colors" name="colors">
                                    <group>
                                        <group string="Primary Color">
                                            <field name="primary_accent_color" widget="color"/>
                                            <p class="text-muted">Used for: Document titles, borders, footer titles</p>
                                        </group>
                                        <group string="Secondary Color">
                                            <field name="secondary_accent_color" widget="color"/>
                                            <p class="text-muted">Used for: Customer box border, footer shapes</p>
                                        </group>
                                    </group>
                                </page>

                                <!-- Tables Tab -->
                                <page string="Tables" name="tables">
                                    <separator string="Table Styling"/>
                                    <group>
                                        <group string="Table Style Preset">
                                            <field name="table_style" widget="radio"/>
                                        </group>
                                    </group>

                                    <div class="alert alert-info" role="alert">
                                        <strong>Table Styles:</strong> Choose from beautiful preset styles or customize colors below
                                    </div>

                                    <group string="Advanced Table Colors (Optional - Overrides preset)">
                                        <group>
                                            <field name="table_header_bg_color" widget="color" string="Header Background"/>
                                            <field name="table_header_text_color" widget="color" string="Header Text"/>
                                        </group>
                                        <group>
                                            <field name="table_border_color" widget="color" string="Border Color"/>
                                            <field name="table_row_alt_bg" widget="color" string="Alternate Row BG"/>
                                        </group>
                                    </group>
                                </page>

                                <!-- Footer Tab -->
                                <page string="Footer" name="footer">
                                    <group>
                                        <group string="Odoo Standard Footer">
                                            <field name="hide_odoo_footer"/>
                                        </group>
                                        <group string="VPA Footer">
                                            <field name="footer_enabled" string="Show Footer"/>
                                        </group>
                                    </group>

                                    <!-- Shared Footer Configuration -->
                                    <separator string="Use Shared Footer Configuration" invisible="not footer_enabled"/>
                                    <div class="alert alert-info" role="alert" invisible="not footer_enabled">
                                        <strong>Tip:</strong> Select an existing Footer Configuration to share footer settings across multiple templates.
                                        Leave empty to configure footer settings manually below.
                                    </div>
                                    <group invisible="not footer_enabled">
                                        <field name="footer_config_id" string="Shared Footer Config" options="{'no_create': False, 'no_open': False}"/>
                                    </group>

                                    <!-- Manual Footer Settings (only shown when no footer_config_id is selected) -->
                                    <separator string="Manual Footer Settings" invisible="not footer_enabled or footer_config_id"/>
                                    <div class="alert alert-secondary" role="alert" invisible="not footer_enabled or footer_config_id">
                                        Configure footer content manually for this template only.
                                    </div>

                                    <!-- Footer Layout (only when footer enabled and no shared config) -->
                                    <group invisible="not footer_enabled or footer_config_id">
                                        <group>
                                            <field name="footer_show_content" string="Show Footer Content"/>
                                            <field name="footer_layout" widget="radio" invisible="not footer_show_content"/>
                                        </group>
                                        <group>
                                            <field name="footer_show_shape"/>
                                            <field name="footer_shape_opacity" invisible="not footer_show_shape"/>
                                            <field name="footer_bank_details_show" invisible="not footer_show_content"/>
                                        </group>
                                    </group>

                                    <!-- Column 1 -->
                                    <group string="Column 1" invisible="footer_layout == 'single' or not footer_enabled or not footer_show_content or footer_config_id">
                                        <field name="footer_column_1_title" placeholder="e.g., Company Info"/>
                                        <field name="footer_column_1_content" widget="html" nolabel="1" colspan="2"/>
                                    </group>

                                    <!-- Column 2 -->
                                    <group string="Column 2" invisible="footer_layout == 'single' or not footer_enabled or not footer_show_content or footer_config_id">
                                        <field name="footer_column_2_title" placeholder="e.g., Contact"/>
                                        <field name="footer_column_2_content" widget="html" nolabel="1" colspan="2"/>
                                    </group>

                                    <!-- Column 3 -->
                                    <group string="Column 3" invisible="footer_layout != 'three_col' or not footer_enabled or not footer_show_content or footer_config_id">
                                        <field name="footer_column_3_title" placeholder="e.g., Bank Info"/>
                                        <field name="footer_column_3_content" widget="html" nolabel="1" colspan="2"/>
                                    </group>

                                    <!-- Single Column Content (full width) -->
                                    <group string="Footer Content" invisible="footer_layout != 'single' or not footer_enabled or not footer_show_content or footer_config_id">
                                        <field name="footer_column_1_title" placeholder="Title (optional)"/>
                                        <field name="footer_column_1_content" widget="html" nolabel="1" colspan="2"/>
                                    </group>

                                    <!-- Page Numbers & Message (only when no shared config) -->
                                    <separator string="Page Numbers &amp; Message" invisible="not footer_enabled or footer_config_id"/>
                                    <group invisible="not footer_enabled or footer_config_id">
                                        <group>
                                            <field name="footer_show_page_number" string="Show Page Numbers"/>
                                            <field name="footer_page_number_format" invisible="not footer_show_page_number"/>
                                        </group>
                                        <group>
                                            <field name="footer_message_type" string="Footer Message"/>
                                            <field name="footer_custom_message" placeholder="Enter your custom message..." invisible="footer_message_type != 'custom'"/>
                                        </group>
                                    </group>
                                </page>

                                <!-- Preview Tab -->
                                <page string="Preview" name="preview">
                                    <div class="alert alert-warning" role="alert">
                                        <strong>Live Preview</strong><br/>
                                        Click "Preview Template" button at the top to see how this template will look with real data.
                                    </div>
                                    <group>
                                        <field name="report_action_id" readonly="1"/>
                                    </group>
                                </page>
                            </notebook>
                        </group>

                        <!-- Right Panel: Live Preview -->
                        <div class="o_preview">
                            <field name="preview" nolabel="1" widget="html"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vpa_document_template" model="ir.actions.act_window">
        <field name="name">Document Templates</field>
        <field name="res_model">vpa.document.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1, 'default_company_id': allowed_company_ids[0]}</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first document template
            </p>
            <p>
                Design custom templates for quotations, invoices, and more with your company branding.
            </p>
        </field>
    </record>

    <!-- Server Action: Cleanup Orphan Reports -->
    <record id="action_cleanup_orphan_reports" model="ir.actions.server">
        <field name="name">🧹 Cleanup Duplicate Print Menu Entries</field>
        <field name="model_id" ref="model_vpa_document_template"/>
        <field name="binding_model_id" ref="model_vpa_document_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = model.action_cleanup_orphan_reports()
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_vpa_document_template"
              name="Document Templates"
              parent="vpa_document_layout.menu_vpa_document_layout_root"
              action="action_vpa_document_template"
              sequence="10"/>
</odoo>
