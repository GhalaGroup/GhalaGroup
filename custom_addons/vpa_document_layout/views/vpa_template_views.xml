<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="vpa_document_template_tree" model="ir.ui.view">
        <field name="name">vpa.document.template.tree</field>
        <field name="model">vpa.document.template</field>
        <field name="arch" type="xml">
            <list string="Document Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="target_app"/>
                <field name="document_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View with Live Preview -->
    <record id="vpa_document_template_form" model="ir.ui.view">
        <field name="name">vpa.document.template.form</field>
        <field name="model">vpa.document.template</field>
        <field name="arch" type="xml">
            <form string="Document Template" class="o_document_layout">
                <sheet>
                <field name="active" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    <strong>Template Name</strong> will appear in the Print menu when users print this document type.
                </div>
                <group>
                        <group class="o_document_layout_company" style="max-width: 40%;">
                            <group>
                                <group>
                                    <field name="name" placeholder="e.g., Modern Sales Quote"/>
                                    <field name="target_app"/>
                                    <field name="document_type"/>
                                </group>
                                <group>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="sequence"/>
                                </group>
                            </group>

                            <notebook>
                        <!-- Header Tab -->
                        <page string="Header" name="header">
                            <group>
                                <group string="Odoo Standard Header">
                                    <field name="hide_odoo_header"/>
                                </group>
                            </group>

                            <group string="Logo Settings">
                                <group>
                                    <field name="header_logo_alignment" widget="radio"/>
                                </group>
                                <group>
                                    <field name="header_logo_width"/>
                                    <field name="header_logo_height"/>
                                    <field name="header_logo_aspect_ratio" widget="radio"/>
                                </group>
                            </group>

                            <group string="Decorative Circle">
                                <group>
                                    <field name="header_show_circle"/>
                                    <field name="header_circle_size" invisible="not header_show_circle"/>
                                    <field name="header_circle_opacity" invisible="not header_show_circle"/>
                                </group>
                            </group>

                            <group string="Company Information" col="4">
                                <div class="mb-2" colspan="4">
                                    <button name="action_load_company_details"
                                            string="📥 Load Company Details"
                                            type="object"
                                            class="btn-secondary"
                                            help="Click to load company address, phone, email, etc. You can then edit the text in the HTML editor."/>
                                    <span class="ms-3 text-muted">Alignment:</span>
                                    <field name="header_company_info_alignment" widget="radio" class="oe_inline ms-2" nolabel="1"/>
                                </div>
                                <field name="header_company_info_color" widget="color" string="Font Color" colspan="2"/>
                                <field name="header_company_details_html" widget="html" nolabel="1" colspan="4" placeholder="Leave empty to use company address automatically"/>
                            </group>
                        </page>

                        <!-- Colors Tab -->
                        <page string="Colors" name="colors">
                            <group>
                                <group string="Primary Color">
                                    <field name="primary_accent_color" widget="color"/>
                                    <p class="text-muted">Used for: Document titles, borders, footer titles</p>
                                </group>
                                <group string="Secondary Color">
                                    <field name="secondary_accent_color" widget="color"/>
                                    <p class="text-muted">Used for: Customer box border, footer shapes</p>
                                </group>
                            </group>
                        </page>

                        <!-- Tables Tab -->
                        <page string="Tables" name="tables">
                            <separator string="Table Styling"/>
                            <group>
                                <group string="Table Style Preset">
                                    <field name="table_style" widget="radio"/>
                                </group>
                            </group>

                            <div class="alert alert-info" role="alert">
                                <strong>Table Styles:</strong> Choose from beautiful preset styles or customize colors below
                            </div>

                            <group string="Advanced Table Colors (Optional - Overrides preset)">
                                <group>
                                    <field name="table_header_bg_color" widget="color" string="Header Background"/>
                                    <field name="table_header_text_color" widget="color" string="Header Text"/>
                                </group>
                                <group>
                                    <field name="table_border_color" widget="color" string="Border Color"/>
                                    <field name="table_row_alt_bg" widget="color" string="Alternate Row BG"/>
                                </group>
                            </group>
                        </page>

                        <!-- Footer Tab -->
                        <page string="Footer" name="footer">
                            <group>
                                <group string="Odoo Standard Footer">
                                    <field name="hide_odoo_footer"/>
                                </group>
                            </group>

                            <group string="Footer Shape">
                                <group>
                                    <field name="footer_show_shape"/>
                                    <field name="footer_shape_opacity" invisible="not footer_show_shape"/>
                                </group>
                            </group>

                            <notebook>
                                <page string="Footer Layout" name="footer_layout_page">
                                    <group>
                                        <group string="Choose Footer Layout">
                                            <field name="footer_layout" widget="radio"/>
                                        </group>
                                        <group string="Options">
                                            <field name="footer_bank_details_show"/>
                                        </group>
                                    </group>

                                    <div class="alert alert-info mt-3" role="alert">
                                        <i class="fa fa-info-circle"/>
                                        <strong>How it works:</strong><br/>
                                        • Choose the number of columns you want in your footer<br/>
                                        • Fill in the title and content for each column<br/>
                                        • Bank details can auto-fill in empty columns if enabled<br/>
                                        • Each column will appear side-by-side in your documents
                                    </div>
                                </page>

                                <page string="📝 Column 1" name="footer_col1">
                                    <group>
                                        <group string="Column 1 Settings">
                                            <label for="footer_column_1_title" string="Column Title"/>
                                            <field name="footer_column_1_title" placeholder="e.g., Payment Terms" nolabel="1"/>
                                        </group>
                                    </group>

                                    <separator string="Column 1 Content"/>
                                    <div class="alert alert-success" role="alert">
                                        <strong>Example:</strong> Add payment terms, terms &amp; conditions, or any important notes
                                    </div>
                                    <field name="footer_column_1_content" widget="html" nolabel="1"
                                           placeholder="Example:&#10;&#10;&lt;p&gt;&lt;strong&gt;Payment Terms:&lt;/strong&gt; Net 30 Days&lt;/p&gt;&#10;&lt;p&gt;Payment is due within 30 days of invoice date&lt;/p&gt;"/>
                                </page>

                                <page string="📝 Column 2" name="footer_col2" invisible="footer_layout == 'single'">
                                    <group>
                                        <group string="Column 2 Settings">
                                            <label for="footer_column_2_title" string="Column Title"/>
                                            <field name="footer_column_2_title" placeholder="e.g., Bank Details" nolabel="1"/>
                                        </group>
                                    </group>

                                    <separator string="Column 2 Content"/>
                                    <div class="alert alert-success" role="alert">
                                        <strong>Tip:</strong> Leave empty to auto-fill with bank account details (if "Show Bank Details" is enabled)<br/>
                                        <strong>Example:</strong> Add contact information, company registration details, or website
                                    </div>
                                    <field name="footer_column_2_content" widget="html" nolabel="1"
                                           placeholder="Example:&#10;&#10;&lt;p&gt;&lt;strong&gt;Contact Us:&lt;/strong&gt;&lt;/p&gt;&#10;&lt;p&gt;Email: info@company.com&lt;/p&gt;&#10;&lt;p&gt;Phone: +1 555-0123&lt;/p&gt;"/>
                                </page>

                                <page string="📝 Column 3" name="footer_col3" invisible="footer_layout != 'three_col'">
                                    <group>
                                        <group string="Column 3 Settings">
                                            <label for="footer_column_3_title" string="Column Title"/>
                                            <field name="footer_column_3_title" placeholder="e.g., Contact Information" nolabel="1"/>
                                        </group>
                                    </group>

                                    <separator string="Column 3 Content"/>
                                    <div class="alert alert-success" role="alert">
                                        <strong>Example:</strong> Add social media links, additional contact details, or certifications
                                    </div>
                                    <field name="footer_column_3_content" widget="html" nolabel="1"
                                           placeholder="Example:&#10;&#10;&lt;p&gt;&lt;strong&gt;Follow Us:&lt;/strong&gt;&lt;/p&gt;&#10;&lt;p&gt;🌐 www.company.com&lt;/p&gt;&#10;&lt;p&gt;📧 support@company.com&lt;/p&gt;"/>
                                </page>

                                <page string="⚙️ Advanced" name="footer_advanced">
                                    <div class="alert alert-warning" role="alert">
                                        <i class="fa fa-exclamation-triangle"/>
                                        <strong>Advanced Users Only:</strong><br/>
                                        Use this field to completely override the footer with custom HTML.<br/>
                                        This will ignore all column settings above.
                                    </div>
                                    <separator string="Custom Footer HTML (Overrides Everything Above)"/>
                                    <field name="footer_custom_html" widget="html" nolabel="1"
                                           placeholder="Enter custom HTML here to completely replace the footer layout..."/>
                                </page>
                            </notebook>
                        </page>

                        <!-- Preview Tab -->
                        <page string="Preview" name="preview">
                            <div class="alert alert-warning" role="alert">
                                <strong>Live Preview</strong><br/>
                                Click "Preview Template" button at the top to see how this template will look with real data.
                            </div>
                            <group>
                                <field name="report_action_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                        </group>

                        <!-- Live Preview Pane (Right Side) - Like Odoo document layout -->
                        <div class="o_preview" style="max-width: 60%; padding-left: 20px;">
                            <field name="preview" nolabel="1" widget="html" class="oe_form_field_html"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vpa_document_template" model="ir.actions.act_window">
        <field name="name">Document Templates</field>
        <field name="res_model">vpa.document.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"form_view_ref": "vpa_document_layout.vpa_document_template_form"}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Document Template
            </p>
            <p>
                Templates allow you to create custom layouts for quotations, invoices, and other documents.<br/>
                Each template appears as a separate option in the Print menu.
            </p>
        </field>
    </record>

    <!-- Menu - Add to existing VPA Layout menu -->
    <menuitem id="menu_vpa_document_template"
              name="Document Templates"
              parent="menu_vpa_document_layout_root"
              action="action_vpa_document_template"
              sequence="10"/>
</odoo>
