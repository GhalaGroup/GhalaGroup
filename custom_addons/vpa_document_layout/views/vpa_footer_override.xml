<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        VPA Footer Override Templates
        ==============================

        These overrides remove Odoo's default header/footer from reports
        so that VPA Footer Config can handle the footer via wkhtmltopdf.
    -->

    <!-- Helper to get report XML ID from context - used by VPA templates -->
    <template id="vpa_footer_with_context" name="VPA Footer With Context">
        <t t-set="report_xml_id" t-value="docs.env.context.get('report_xml_id', '') if docs else ''"/>
        <t t-call="vpa_document_layout.vpa_unified_footer"/>
    </template>

    <!--
        Override MRP Production Order Report Layout
        Remove the default header/footer so VPA footer config can be used
    -->
    <template id="report_mrporder_vpa" inherit_id="mrp.report_mrporder">
        <!-- MRP uses web.internal_layout, replace with minimal layout -->
        <xpath expr="//t[@t-call='web.internal_layout']" position="replace">
            <t t-call="vpa_document_layout.external_layout_minimal">
                <t t-out="0"/>
            </t>
        </xpath>
    </template>

    <!-- Minimal External Layout for VPA Footer Config (footer via wkhtmltopdf) -->
    <template id="external_layout_minimal" name="VPA Minimal External Layout">
        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
            <t t-out="0"/>
        </div>
    </template>

</odoo>
