<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        VPA Footer Override Templates
        ==============================

        These overrides remove Odoo's default header/footer from reports
        so that VPA Footer Config can handle the footer via wkhtmltopdf.
    -->

    <!-- Helper to get report XML ID from context - used by VPA templates -->
    <template id="vpa_footer_with_context" name="VPA Footer With Context">
        <t t-set="report_xml_id" t-value="docs.env.context.get('report_xml_id', '') if docs else ''"/>
        <t t-call="vpa_document_layout.vpa_unified_footer"/>
    </template>

    <!--
        VPA Internal Layout - removes header for internal reports
        This layout removes Odoo's default header (date, company, page number)
        so that VPA Footer Config can provide the footer via wkhtmltopdf.
    -->
    <template id="vpa_internal_layout" name="VPA Internal Layout (No Header)">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <!-- NO HEADER - VPA Footer Config handles footer via wkhtmltopdf -->
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
    </template>

    <!--
        Override MRP Production Order report to use VPA internal layout
        This replaces web.internal_layout with vpa_internal_layout
    -->
    <template id="report_mrporder_vpa" inherit_id="mrp.report_mrporder" priority="99">
        <xpath expr="//t[@t-call='web.internal_layout']" position="attributes">
            <attribute name="t-call">vpa_document_layout.vpa_internal_layout</attribute>
        </xpath>
    </template>

</odoo>
