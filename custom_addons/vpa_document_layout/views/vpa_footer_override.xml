<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        VPA Footer Override Templates
        ==============================
        Override Odoo's 7 standard external layouts to use VPA unified footer.

        This ensures ALL Odoo printouts (not just VPA templates) get professional
        footers based on the document type (customer vs internal).

        Layouts overridden:
        1. Standard
        2. Boxed
        3. Bold
        4. Striped
        5. Bubble
        6. Wave
        7. Folder

        Note: Using contains(@t-attf-class, 'footer') because Odoo uses dynamic class attributes
    -->

    <!-- Helper to get report XML ID from context -->
    <template id="vpa_footer_with_context" name="VPA Footer With Context">
        <t t-set="report_xml_id" t-value="docs.env.context.get('report_xml_id', '') if docs else ''"/>
        <t t-call="vpa_document_layout.vpa_unified_footer"/>
    </template>

    <!-- ==================== STANDARD LAYOUT ==================== -->
    <template id="external_layout_standard_footer_override"
              inherit_id="web.external_layout_standard"
              name="VPA Standard Layout Footer Override">
        <!-- Replace the footer content div inside footer -->
        <xpath expr="//div[contains(@t-attf-class, 'footer')]/div[@class='o_footer_content d-flex border-top pt-2']" position="replace">
            <div class="o_footer_content border-top pt-2">
                <t t-call="vpa_document_layout.vpa_footer_with_context"/>
            </div>
        </xpath>
    </template>

    <!-- ==================== BOXED LAYOUT ==================== -->
    <template id="external_layout_boxed_footer_override"
              inherit_id="web.external_layout_boxed"
              name="VPA Boxed Layout Footer Override">
        <xpath expr="//div[contains(@t-attf-class, 'footer')]/div[contains(@class, 'o_footer_content')]" position="replace">
            <div class="o_footer_content border-top pt-2">
                <t t-call="vpa_document_layout.vpa_footer_with_context"/>
            </div>
        </xpath>
    </template>

    <!-- ==================== BOLD LAYOUT ==================== -->
    <template id="external_layout_bold_footer_override"
              inherit_id="web.external_layout_bold"
              name="VPA Bold Layout Footer Override">
        <xpath expr="//div[contains(@t-attf-class, 'footer')]/div[contains(@class, 'o_footer_content')]" position="replace">
            <div class="o_footer_content border-top pt-2">
                <t t-call="vpa_document_layout.vpa_footer_with_context"/>
            </div>
        </xpath>
    </template>

    <!-- ==================== STRIPED LAYOUT ==================== -->
    <template id="external_layout_striped_footer_override"
              inherit_id="web.external_layout_striped"
              name="VPA Striped Layout Footer Override">
        <xpath expr="//div[contains(@t-attf-class, 'footer')]/div[contains(@class, 'o_footer_content')]" position="replace">
            <div class="o_footer_content border-top pt-2">
                <t t-call="vpa_document_layout.vpa_footer_with_context"/>
            </div>
        </xpath>
    </template>

    <!-- ==================== BUBBLE LAYOUT ==================== -->
    <template id="external_layout_bubble_footer_override"
              inherit_id="web.external_layout_bubble"
              name="VPA Bubble Layout Footer Override">
        <xpath expr="//div[contains(@t-attf-class, 'footer')]/div[contains(@class, 'o_footer_content')]" position="replace">
            <div class="o_footer_content border-top pt-2">
                <t t-call="vpa_document_layout.vpa_footer_with_context"/>
            </div>
        </xpath>
    </template>

    <!-- ==================== WAVE LAYOUT ==================== -->
    <template id="external_layout_wave_footer_override"
              inherit_id="web.external_layout_wave"
              name="VPA Wave Layout Footer Override">
        <xpath expr="//div[contains(@t-attf-class, 'footer')]/div[contains(@class, 'o_footer_content')]" position="replace">
            <div class="o_footer_content border-top pt-2">
                <t t-call="vpa_document_layout.vpa_footer_with_context"/>
            </div>
        </xpath>
    </template>

    <!-- ==================== FOLDER LAYOUT ==================== -->
    <template id="external_layout_folder_footer_override"
              inherit_id="web.external_layout_folder"
              name="VPA Folder Layout Footer Override">
        <xpath expr="//div[contains(@t-attf-class, 'footer')]/div[contains(@class, 'o_footer_content')]" position="replace">
            <div class="o_footer_content border-top pt-2">
                <t t-call="vpa_document_layout.vpa_footer_with_context"/>
            </div>
        </xpath>
    </template>

</odoo>
