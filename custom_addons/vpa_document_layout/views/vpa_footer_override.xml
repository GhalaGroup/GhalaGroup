<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        VPA Footer Override Templates
        ==============================

        NOTE: These overrides are DISABLED for now.
        The footer override feature requires careful XPath matching for each
        Odoo layout variant. Will be enabled in a future update after testing.

        For now, VPA unified footers work with:
        - VPA Document Templates (via footer_config_id)
        - Direct template calls to vpa_unified_footer
    -->

    <!-- Helper to get report XML ID from context - used by VPA templates -->
    <template id="vpa_footer_with_context" name="VPA Footer With Context">
        <t t-set="report_xml_id" t-value="docs.env.context.get('report_xml_id', '') if docs else ''"/>
        <t t-call="vpa_document_layout.vpa_unified_footer"/>
    </template>

</odoo>
