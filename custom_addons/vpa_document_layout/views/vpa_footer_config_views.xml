<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VPA Footer Configuration Form View -->
    <record id="view_vpa_footer_config_form" model="ir.ui.view">
        <field name="name">vpa.footer.config.form</field>
        <field name="model">vpa.footer.config</field>
        <field name="arch" type="xml">
            <form string="Header &amp; Footer Configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Default Customer" bg_color="text-bg-success"
                            invisible="not is_default_customer"/>
                    <widget name="web_ribbon" title="Default Internal" bg_color="text-bg-info"
                            invisible="not is_default_internal"/>

                    <group>
                        <group>
                            <field name="name" placeholder="e.g., Customer Footer, Internal Footer"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="footer_type"/>
                            <field name="is_default_customer" invisible="footer_type == 'internal'"/>
                            <field name="is_default_internal" invisible="footer_type == 'customer'"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Header Tab -->
                        <page string="Header" name="header">
                            <group>
                                <group string="Header Options">
                                    <field name="show_header"/>
                                    <field name="header_layout" invisible="not show_header"/>
                                    <field name="header_height" invisible="not show_header"/>
                                </group>
                                <group string="Content">
                                    <field name="header_show_logo" invisible="not show_header"/>
                                    <field name="header_show_company_name" invisible="not show_header"/>
                                    <field name="header_show_company_details" invisible="not show_header"/>
                                    <field name="header_show_document_title" invisible="not show_header"/>
                                    <field name="header_custom_title" invisible="not show_header or not header_show_document_title"/>
                                </group>
                            </group>
                            <group invisible="not show_header">
                                <group string="Date Options">
                                    <field name="header_show_date"/>
                                    <field name="header_date_format" invisible="not header_show_date"/>
                                </group>
                                <group string="QR Code">
                                    <field name="header_show_qr_code"/>
                                    <field name="header_qr_size" invisible="not header_show_qr_code"/>
                                </group>
                            </group>
                            <group invisible="not show_header">
                                <group string="Header Styling">
                                    <field name="header_background_color" widget="color"/>
                                    <field name="header_text_color" widget="color"/>
                                    <field name="header_border_bottom"/>
                                    <field name="header_border_color" widget="color" invisible="not header_border_bottom"/>
                                </group>
                            </group>

                            <!-- Custom Header HTML -->
                            <group string="Custom Header HTML" invisible="header_layout != 'custom_html' or not show_header">
                                <div class="alert alert-info mb-3" role="alert">
                                    <strong>Available placeholders:</strong><br/>
                                    <code>{{company_name}}</code>, <code>{{company_logo}}</code>,
                                    <code>{{document_title}}</code>, <code>{{date}}</code>
                                </div>
                                <field name="header_custom_html" widget="html" nolabel="1" colspan="2"/>
                            </group>
                        </page>

                        <!-- Footer Layout Tab -->
                        <page string="Footer" name="layout">
                            <group>
                                <group string="Footer Layout">
                                    <field name="footer_layout"/>
                                    <field name="footer_height" help="Height reserved for footer. Reduce to minimize gap between content and footer."/>
                                </group>
                                <group string="Content Options">
                                    <field name="show_bank_details"/>
                                    <field name="show_page_numbers"/>
                                    <field name="page_number_style" invisible="not show_page_numbers"/>
                                    <field name="page_number_bg_color" widget="color" invisible="not show_page_numbers or page_number_style != 'badge'"/>
                                    <field name="show_company_footer"/>
                                </group>
                            </group>

                            <!-- Computer Generated Note (for internal) -->
                            <group string="Internal Document Note" invisible="footer_type != 'internal'">
                                <field name="computer_generated_note" placeholder="This is a computer generated document"/>
                            </group>

                            <!-- Single Column Content -->
                            <group string="Footer Content" invisible="footer_layout != 'single'">
                                <div class="alert alert-info" role="alert">
                                    <i class="fa fa-info-circle"/> Single column layout centers all content.
                                    Enable options above to show bank details, page numbers, and company footer text.
                                </div>
                            </group>

                            <!-- Two/Three Column Content -->
                            <group invisible="footer_layout not in ('two_col', 'three_col')">
                                <group string="Column 1">
                                    <field name="column_1_title" placeholder="e.g., Bank Details"/>
                                    <field name="column_1_content" widget="html" nolabel="1"/>
                                </group>
                                <group string="Column 2">
                                    <field name="column_2_title" placeholder="e.g., Contact"/>
                                    <field name="column_2_content" widget="html" nolabel="1"/>
                                </group>
                            </group>
                            <group invisible="footer_layout != 'three_col'">
                                <group string="Column 3">
                                    <field name="column_3_title" placeholder="e.g., Legal"/>
                                    <field name="column_3_content" widget="html" nolabel="1"/>
                                </group>
                            </group>

                            <!-- Custom HTML -->
                            <group string="Custom HTML Footer" invisible="footer_layout != 'custom_html'">
                                <div class="alert alert-info mb-3" role="alert">
                                    <strong>Available placeholders:</strong><br/>
                                    <code>{{company_name}}</code>, <code>{{company_footer}}</code>,
                                    <code>{{bank_name}}</code>, <code>{{bank_account}}</code>, <code>{{bank_bic}}</code>
                                </div>
                                <field name="custom_html" widget="html" nolabel="1" colspan="2"/>
                            </group>
                        </page>

                        <!-- Styling Tab -->
                        <page string="Styling" name="styling">
                            <group>
                                <group string="Report Colors">
                                    <field name="primary_color" widget="color"/>
                                    <field name="secondary_color" widget="color"/>
                                </group>
                                <group string="Border">
                                    <field name="show_border"/>
                                    <field name="border_color" widget="color" invisible="not show_border"/>
                                </group>
                            </group>
                            <group>
                                <group string="Decorative Shape">
                                    <field name="show_shape"/>
                                    <field name="shape_color" widget="color" invisible="not show_shape"/>
                                    <field name="shape_opacity" invisible="not show_shape"/>
                                </group>
                                <group string="Text">
                                    <field name="text_color" widget="color"/>
                                    <field name="font_size"/>
                                </group>
                            </group>
                        </page>

                        <!-- Preview Tab -->
                        <page string="Preview" name="preview">
                            <group>
                                <field name="preview" widget="html" nolabel="1" readonly="1" colspan="2"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VPA Footer Configuration List View -->
    <record id="view_vpa_footer_config_tree" model="ir.ui.view">
        <field name="name">vpa.footer.config.list</field>
        <field name="model">vpa.footer.config</field>
        <field name="arch" type="xml">
            <list string="Header &amp; Footer Configurations" default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="footer_type" decoration-success="footer_type == 'customer'"
                       decoration-info="footer_type == 'internal'" decoration-muted="footer_type == 'custom'"/>
                <field name="footer_layout"/>
                <field name="is_default_customer" string="Default Customer" widget="boolean_toggle"/>
                <field name="is_default_internal" string="Default Internal" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- VPA Footer Configuration Action -->
    <record id="action_vpa_footer_config" model="ir.actions.act_window">
        <field name="name">Header &amp; Footer Settings</field>
        <field name="res_model">vpa.footer.config</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'default_company_id': allowed_company_ids[0]}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Your First Header &amp; Footer Configuration
            </p>
            <p>
                Configure professional headers and footers for your documents.<br/>
                <strong>Customer:</strong> For Quotes, Invoices, Sales Orders - with bank details<br/>
                <strong>Internal:</strong> For Manufacturing, Picking - with "Computer Generated" note
            </p>
        </field>
    </record>

    <!-- Header & Footer Settings Menu -->
    <menuitem id="menu_vpa_footer_config"
              name="Header &amp; Footer Settings"
              parent="menu_vpa_document_layout_root"
              action="action_vpa_footer_config"
              sequence="15"/>
</odoo>
