<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full Page Preview Template with Page Margins -->
    <template id="template_preview_fullpage">
        <t t-call="web.html_container">
            <t t-set="dims" t-value="template._get_paper_dimensions()"/>
            <t t-set="head">
                <title>Preview: <t t-esc="template.name"/></title>
            <style>
                body {
                    margin: 0;
                    padding: 40px;
                    background: #525659;
                    font-family: 'Lato', 'Helvetica', 'Arial', sans-serif;
                }
                .page-container {
                    width: <t t-esc="dims['width']"/>mm;
                    min-height: <t t-esc="dims['height']"/>mm;
                    margin: 0 auto 40px;
                    background: white;
                    box-shadow: 0 0 20px rgba(0,0,0,0.5);
                    position: relative;
                    overflow: visible;
                }

                /* Print styles - ensure proper A4 printing */
                @media print {
                    @page {
                        size: <t t-esc="'A4' if template.paper_size == 'a4' else 'Letter'"/> <t t-esc="template.paper_orientation"/>;
                        margin: 0;
                    }

                    body {
                        margin: 0;
                        padding: 0;
                        background: white;
                    }

                    .page-container {
                        width: 100%;
                        height: 100%;
                        margin: 0;
                        padding: 0;
                        box-shadow: none;
                        page-break-after: always;
                    }
                }
            </style>
            </t>

            <div class="page-container">
                <t t-call="vpa_document_layout.vpa_template_preview_layout"/>
            </div>
        </t>
    </template>
</odoo>
