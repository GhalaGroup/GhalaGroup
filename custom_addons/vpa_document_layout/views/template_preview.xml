<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template Preview Container -->
    <template id="vpa_template_preview_container">
        <div style="max-width: 210mm; min-height: 297mm; margin: 20px auto; padding: 0; background: white; border: 1px solid #ddd; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <t t-call="vpa_document_layout.vpa_template_preview_layout"/>
        </div>
    </template>

    <!-- Template Preview Layout -->
    <template id="vpa_template_preview_layout">
        <t t-set="o" t-value="template.company_id"/>
        <t t-set="display_name_in_footer" t-value="True"/>
        <t t-set="report_type" t-value="'html'"/>
        <t t-set="layout_document_title" t-value="'Quotation #SO001'"/>
        <t t-set="address">
            <strong>Deco Addict</strong><br/>
            77 Santa Barbara Rd<br/>
            Pleasant Hill CA 94523<br/>
            United States
        </t>
        <t t-set="information_block">
            <div><strong>Quotation Date:</strong> 11/18/2025</div>
            <div><strong>Expiration:</strong> 12/18/2025</div>
            <div><strong>Salesperson:</strong> Demo User</div>
        </t>

        <!-- Call the dynamically generated VPA layout template -->
        <t t-call="vpa_document_layout.external_layout_vpa_template_{{template.id}}">
            <!-- Sample quotation body content -->
            <div class="page" style="font-size: 10pt;">
                <!-- Product Table -->
                <table class="table table-sm o_main_table" style="margin-top: 1rem;">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Taxes</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <strong>[FURN_8999] Three-Seat Sofa</strong><br/>
                                <small class="text-muted">Three Seater Sofa with Lounger in Steel Grey Color</small>
                            </td>
                            <td class="text-end">5.00</td>
                            <td class="text-end">$1,500.00</td>
                            <td class="text-end">15%</td>
                            <td class="text-end">$7,500.00</td>
                        </tr>
                        <tr>
                            <td>
                                <strong>[FURN_8220] Four Person Desk</strong><br/>
                                <small class="text-muted">Four person modern office workstation</small>
                            </td>
                            <td class="text-end">5.00</td>
                            <td class="text-end">$2,350.00</td>
                            <td class="text-end">15%</td>
                            <td class="text-end">$11,750.00</td>
                        </tr>
                    </tbody>
                </table>

                <!-- Totals Table -->
                <div id="total" class="row justify-content-end mt-4">
                    <div class="col-4">
                        <table class="table o_total_table table-sm" style="page-break-inside: avoid;">
                            <tr>
                                <td><strong>Untaxed Amount</strong></td>
                                <td class="text-end">$19,250.00</td>
                            </tr>
                            <tr class="o_taxes">
                                <td>Tax 15%</td>
                                <td class="text-end">$2,887.50</td>
                            </tr>
                            <tr style="border-top: 2px solid #000;">
                                <td><strong>Total</strong></td>
                                <td class="text-end o_price_total"><strong>$22,137.50</strong></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div style="margin-top: 2rem;">
                    <p><strong>Payment terms:</strong> 30 Days</p>
                    <p style="margin-top: 1rem;">
                        <strong>Terms and conditions:</strong><br/>
                        <small class="text-muted">
                            Please send payment within 30 days of receiving this invoice.<br/>
                            There will be a 10% interest charge per month on late invoices.
                        </small>
                    </p>
                </div>
            </div>
        </t>
    </template>
</odoo>
