<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit General Settings to add Login Theme section -->
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.login.theme</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Login Theme" name="vpa_login_theme" groups="base.group_system">
                    <block title="Login Page Branding" name="vpa_login_branding">
                        <setting string="Customize Login Page"
                                 help="Transform your Odoo login page with custom branding and colors">
                            <div class="mt8">
                                <button name="action_open_login_theme"
                                        string="Configure Login Theme"
                                        type="object"
                                        class="btn btn-primary"
                                        icon="fa-paint-brush"/>
                            </div>
                            <div class="mt8">
                                <ul class="text-muted small mb-0">
                                    <li>6 pre-built professional themes</li>
                                    <li>Custom colors and branding</li>
                                    <li>Custom favicon support</li>
                                    <li>Live preview before applying</li>
                                    <li>No coding required</li>
                                </ul>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
