<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom QWeb Report for "Dymo New" Labels -->
    <template id="report_product_template_label_dymo_new">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="product">
                <div class="o_label_sheet o_label_dymo" style="width:75mm; height:50mm; padding:3mm; border:2px solid blue; font-size:10px;">
                    <div style="text-align:center; font-weight:bold; font-size:12px;">
                        <t t-esc="product.name"/>
                    </div>
                    <div style="text-align:center; margin-top:5px;">
                        <t t-if="product.default_code">
                            [<t t-esc="product.default_code"/>]
                        </t>
                    </div>
                    <div style="margin-top:5px; text-align:center;">
                        <t t-if="barcode">
                            <div t-out="barcode" t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'Code128', 'img_style': 'width:100%; height:40px'}"/>
                        </t>
                    </div>
                    <div style="text-align:center; font-size:12px;">
                        Price: ₹ <t t-esc="product.list_price"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
